/* pages/script-detail/script-detail.wxss */
.container {
  min-height: 100vh;
  background: #F8FAFC;
  padding-bottom: 160rpx;
}

/* ========== 渐变头部 ========== */
.script-hero {
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 50%, #1D4ED8 100%);
  padding: 48rpx 32rpx 56rpx;
  color: #FFFFFF;
  position: relative;
  overflow: hidden;
}

.script-hero::before {
  content: '';
  position: absolute;
  top: -80rpx;
  right: -40rpx;
  width: 240rpx;
  height: 240rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
  border-radius: 50%;
}

.sh-badge {
  display: inline-flex;
  align-items: center;
  background: rgba(255,255,255,0.2);
  backdrop-filter: blur(10px);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255,255,255,0.3);
  margin-bottom: 20rpx;
  position: relative;
  z-index: 1;
}

.sh-badge-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.sh-badge-text {
  font-size: 22rpx;
  font-weight: 500;
}

.sh-name {
  font-size: 40rpx;
  font-weight: 800;
  margin-bottom: 12rpx;
  position: relative;
  z-index: 1;
  line-height: 1.4;
}

.sh-desc {
  font-size: 26rpx;
  opacity: 0.85;
  position: relative;
  z-index: 1;
}

/* ========== Tab切换 ========== */
.script-tabs {
  display: flex;
  background: #FFFFFF;
  margin: -28rpx 24rpx 0;
  border-radius: 24rpx;
  padding: 8rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  position: relative;
  z-index: 2;
}

.script-tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #64748B;
  border-radius: 18rpx;
  transition: all 0.2s ease;
  font-weight: 500;
}

.script-tab.active {
  background: linear-gradient(135deg, #3B82F6, #2563EB);
  color: #FFFFFF;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(59,130,246,0.3);
}

/* ========== 内容区 ========== */
.content {
  padding: 24rpx;
}

.section {
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  align-items: center;
  padding: 8rpx 8rpx 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1E293B;
}

.section-icon {
  font-size: 28rpx;
  margin-right: 10rpx;
}

/* ========== 话术内容卡片 ========== */
.script-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  border-left: 6rpx solid #3B82F6;
}

.script-content {
  font-size: 28rpx;
  color: #334155;
  line-height: 2;
}

.script-content ::v-deep p {
  margin-bottom: 16rpx;
}

/* ========== 证据清单 ========== */
.evidence-list {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 8rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.evidence-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F1F5F9;
}

.evidence-item:last-child {
  border-bottom: none;
}

.evidence-icon {
  width: 56rpx;
  height: 56rpx;
  background: linear-gradient(135deg, #FFFBEB, #FEF3C7);
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.evidence-text {
  flex: 1;
  font-size: 26rpx;
  color: #475569;
}

/* ========== 关联渠道 ========== */
.related-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.related-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  transition: all 0.2s ease;
}

.related-card:active {
  transform: scale(0.98);
}

.related-icon {
  width: 64rpx;
  height: 64rpx;
  background: linear-gradient(135deg, #EFF6FF, #DBEAFE);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.related-info {
  flex: 1;
  min-width: 0;
}

.related-name {
  font-size: 28rpx;
  color: #1E293B;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.related-meta {
  font-size: 22rpx;
  color: #94A3B8;
}

.related-arrow {
  font-size: 36rpx;
  color: #CBD5E1;
  font-weight: 300;
}

/* ========== 底部操作栏 ========== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  background: #FFFFFF;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.08);
  z-index: 100;
}

.bottom-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 24rpx;
}

.bottom-icon {
  font-size: 40rpx;
  margin-bottom: 4rpx;
}

.bottom-label {
  font-size: 20rpx;
  color: #64748B;
}

.bottom-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #3B82F6, #2563EB);
  border-radius: 28rpx;
  padding: 24rpx;
  margin-left: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(59,130,246,0.3);
  transition: all 0.2s ease;
}

.bottom-btn:active {
  transform: scale(0.96);
  opacity: 0.9;
}

.bottom-btn-icon {
  font-size: 32rpx;
  margin-right: 10rpx;
}

.bottom-btn-text {
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
}

/* ========== 加载状态 ========== */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
  font-size: 28rpx;
  color: #94A3B8;
}
