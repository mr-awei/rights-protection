<!--pages/index/index.wxml-->
<view class="container" style="--status-bar-height: {{statusBarHeight}}px;">
  <!-- 渐变头部 -->
  <view class="gradient-header">
    <view class="header-content">
      <view class="header-top">
        <view class="header-title">
          <text class="title-main">我不能被欺负</text>
          <text class="title-sub">官方投诉渠道 · 一键直达</text>
        </view>
      </view>

      <!-- 搜索框 -->
      <view class="search-box" bindtap="onSearchBoxTap">
        <view class="search-icon"></view>
        <input
          class="search-input"
          placeholder="搜索投诉渠道、话术、流程..."
          placeholder-class="search-placeholder"
          value="{{searchKeyword}}"
          bindinput="onSearchInput"
          bindconfirm="onSearchConfirm"
          confirm-type="search"
        />
        <view class="search-btn" bindtap="onSearchButtonTap">搜索</view>
      </view>

      <!-- 热门搜索 -->
      <view class="hot-searches">
        <text class="hot-label">热门搜索</text>
        <view class="hot-tags">
          <text
            class="hot-tag"
            wx:for="{{hotSearches}}"
            wx:key="*this"
            data-keyword="{{item}}"
            bindtap="onHotSearchTap"
          >{{item}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 内容区 -->
  <view class="content">
    <!-- 紧急电话条（最优先） -->
    <view class="section">
      <view class="emergency-bar">
        <view class="emergency-bar-title">
          <text class="emergency-bar-text">紧急电话 · 一键拨打</text>
        </view>
        <view class="emergency-phone-list">
          <view
            class="emergency-phone-item"
            wx:for="{{emergencyPhones}}"
            wx:key="name"
            data-phone="{{item.name}}"
            data-label="{{item.label}}"
            bindtap="onEmergencyCall"
            hover-class="emergency-phone-hover"
          >
            <text class="emergency-phone-number" style="color: {{item.color}};">{{item.name}}</text>
            <text class="emergency-phone-label">{{item.label}}</text>
          </view>
        </view>
        <view class="emergency-bar-tip">
          <text>紧急情况请直接拨打，不走投诉流程</text>
        </view>
      </view>
    </view>

    <!-- 快捷场景入口（高频使用） -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">常见场景</text>
        <text class="section-more" bindtap="onMoreScriptsTap">全部分类 ›</text>
      </view>
      <view class="scene-grid">
        <view
          class="scene-item"
          wx:for="{{sceneEntries}}"
          wx:key="label"
          data-category="{{item.category}}"
          bindtap="onSceneEntryTap"
          hover-class="scene-item-hover"
        >
          <view class="scene-icon app-icon app-icon-default {{item.iconClass}}" style="--icon-bg: {{item.color}}; --icon-color: {{item.textColor}}; --icon-hover-bg: {{item.textColor}};"></view>
          <text class="scene-name">{{item.label}}</text>
        </view>
      </view>
    </view>

    <!-- 高频话术（高频使用） -->
    <view class="section" wx:if="{{hotScripts.length > 0}}">
      <view class="section-header">
        <text class="section-title">高频投诉话术</text>
        <text class="section-more" bindtap="onViewAllScripts">共{{hotScripts.length}}套 ›</text>
      </view>
      <view class="script-list">
        <view
          class="script-item"
          wx:for="{{displayScripts}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onScriptTap"
          hover-class="script-item-hover"
        >
          <view class="script-icon"></view>
          <view class="script-info">
            <text class="script-name">{{item.displayName || item.scene_name || item.name}}</text>
            <text class="script-desc">{{item.scene || '通用场景'}} · 电话版+书面版</text>
          </view>
          <text class="script-arrow">›</text>
        </view>
      </view>
      <view class="view-all-btn" wx:if="{{hotScripts.length > 3}}" bindtap="onViewAllScripts" hover-class="view-all-hover">
        <text>查看全部{{hotScripts.length}}套话术</text>
      </view>
    </view>

    <!-- 最近浏览（个性化推荐） -->
    <view class="section" wx:if="{{recentViews.length > 0}}">
      <view class="section-header">
        <text class="section-title">最近浏览</text>
        <text class="section-more">最近{{recentViews.length}}条</text>
      </view>
      <view class="recent-list">
        <view
          class="recent-item"
          wx:for="{{recentViews}}"
          wx:key="item_id"
          data-item="{{item}}"
          bindtap="onRecentViewTap"
          hover-class="recent-item-hover"
        >
          <view class="recent-type" style="background: {{item.typeColor}}15; color: {{item.typeColor}};">
            <text>{{item.typeLabel}}</text>
          </view>
          <view class="recent-info">
            <text class="recent-name">{{item.item_name}}</text>
            <text class="recent-time">{{item.timeStr}}</text>
          </view>
          <text class="recent-arrow">›</text>
        </view>
      </view>
    </view>

    <!-- 维权须知（折叠） -->
    <view class="section">
      <view class="notice-card">
        <view class="notice-header" bindtap="onNoticeToggle">
          <text class="notice-title">维权须知</text>
          <text class="notice-arrow {{noticeExpanded ? 'expanded' : ''}}">›</text>
        </view>
        <view class="notice-core">
          <text>依法维权 · 虚假举报须承担法律责任 · 倡导先企业内部投诉</text>
        </view>
        <view class="notice-content" wx:if="{{noticeExpanded}}">
          <text>1. 本平台提供的投诉渠道和话术仅供参考，具体以官方平台为准。</text>
          <text>2. 投诉前请先收集好相关证据（合同、聊天记录、转账记录等）。</text>
          <text>3. 建议先通过企业内部投诉渠道解决，无法解决再向监管部门投诉。</text>
          <text>4. 请勿虚假举报、恶意投诉，否则可能承担相应的法律责任。</text>
          <text>5. 紧急情况请直接拨打110、120、119等紧急电话。</text>
        </view>
      </view>
    </view>

    <!-- 底部提示 -->
    <view class="footer-tip">
      <text>数据仅供参考，以官方平台为准</text>
    </view>
  </view>
</view>
