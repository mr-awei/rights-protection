<!--pages/index/index.wxml-->
<view class="container" style="--status-bar-height: {{statusBarHeight}}px;">
  <!-- 渐变头部 -->
  <view class="gradient-header">
    <view class="header-content">
      <view class="header-top">
        <view class="header-title">
          <text class="title-main">我不能被欺负</text>
          <text class="title-sub">官方投诉渠道 · 一键直达</text>
          <text class="title-desc">已收录 122 个投诉渠道 · 6 套话术 · 10 大分类</text>
        </view>
      </view>

      <!-- 搜索框 -->
      <view class="search-box" bindtap="onSearchBoxTap">
        <view class="search-icon">🔍</view>
        <input
          class="search-input"
          placeholder="搜索投诉渠道、话术、流程..."
          placeholder-class="search-placeholder"
          value="{{searchKeyword}}"
          bindinput="onSearchInput"
          bindconfirm="onSearchConfirm"
          confirm-type="search"
        />
        <view class="search-btn" bindtap="onSearchButtonTap">搜索</view>
      </view>

      <!-- 热门搜索 -->
      <view class="hot-searches">
        <text class="hot-label">🔥 热门搜索</text>
        <view class="hot-tags">
          <text
            class="hot-tag"
            wx:for="{{hotSearches}}"
            wx:key="*this"
            data-keyword="{{item}}"
            bindtap="onHotSearchTap"
          >{{item}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 内容区 -->
  <view class="content">
    <!-- 快捷场景入口 -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">常见场景</text>
        <text class="section-more" bindtap="onMoreScriptsTap">全部分类 ›</text>
      </view>
      <view class="scene-grid">
        <view
          class="scene-item"
          wx:for="{{sceneEntries}}"
          wx:key="label"
          data-keyword="{{item.keyword}}"
          bindtap="onSceneEntryTap"
          hover-class="scene-item-hover"
        >
          <view class="scene-icon" style="background: {{item.color}}">
            <text>{{item.icon}}</text>
          </view>
          <text class="scene-label">{{item.label}}</text>
        </view>
      </view>
    </view>

    <!-- 维权须知 -->
    <view class="section">
      <view class="notice-card">
        <view class="notice-header">
          <text class="notice-icon">⚖️</text>
          <text class="notice-title">维权须知</text>
        </view>
        <view class="notice-step">
          <view class="step-badge">第一步</view>
          <view class="step-content">
            <text class="step-title">先向企业内部投诉</text>
            <text class="step-desc">拨打企业客服热线或通过官方APP、网站投诉，明确诉求并索取工单号。约80%的常规问题在此层级即可解决，且企业投诉记录是后续向监管部门申诉的前置条件。</text>
          </view>
        </view>
        <view class="notice-divider"></view>
        <view class="notice-warning">
          <text class="warning-icon">⚠️</text>
          <view class="warning-content">
            <text class="warning-title">依法维权 · 虚假举报须担责</text>
            <text class="warning-text">《宪法》第四十一条赋予公民申诉、控告、检举的权利，同时规定不得捏造或歪曲事实进行诬告陷害。</text>
            <text class="warning-text">• 报假警、谎报警情：依据《治安管理处罚法》处5-10日拘留，可并处1000元以下罚款；情节严重的触犯《刑法》编造、故意传播虚假信息罪。</text>
            <text class="warning-text">• 捏造事实诬告陷害他人：依据《治安管理处罚法》处5日以下拘留或1000元以下罚款；情节严重的触犯《刑法》诬告陷害罪，最高可处10年有期徒刑。</text>
            <text class="warning-text">• 12345、12315等政务热线对恶意投诉设有识别和处置机制，可列入异常诉求名录，限制拨打权限。</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 紧急电话条 -->
    <view class="section">
      <view class="emergency-bar">
        <view class="emergency-bar-title">
          <text class="emergency-bar-icon">🚨</text>
          <text class="emergency-bar-text">紧急电话 · 一键拨打</text>
        </view>
        <view class="emergency-phone-list">
          <view
            class="emergency-phone-item"
            wx:for="{{emergencyPhones}}"
            wx:key="name"
            data-phone="{{item.name}}"
            data-label="{{item.label}}"
            bindtap="onEmergencyCall"
            hover-class="emergency-phone-hover"
          >
            <view class="emergency-phone-icon" style="background: {{item.color}}15; color: {{item.color}}">
              <text>{{item.icon}}</text>
            </view>
            <text class="emergency-phone-number">{{item.name}}</text>
            <text class="emergency-phone-label">{{item.label}}</text>
          </view>
        </view>
        <view class="emergency-bar-tip">
          <text>紧急情况请直接拨打，不走投诉流程</text>
        </view>
      </view>
    </view>

    <!-- 最近浏览 -->
    <view class="section" wx:if="{{recentViews.length > 0}}">
      <view class="section-header">
        <text class="section-title">👀 最近浏览</text>
        <text class="section-more">最近{{recentViews.length}}条</text>
      </view>
      <view class="recent-list">
        <view
          class="recent-item"
          wx:for="{{recentViews}}"
          wx:key="item_id"
          data-item="{{item}}"
          bindtap="onRecentViewTap"
          hover-class="recent-item-hover"
        >
          <view class="recent-type" style="background: {{item.typeColor}}15; color: {{item.typeColor}};">
            <text>{{item.typeLabel}}</text>
          </view>
          <text class="recent-name">{{item.item_name}}</text>
          <text class="recent-arrow">›</text>
        </view>
      </view>
    </view>

    <!-- 高频话术 -->
    <view class="section" wx:if="{{hotScripts.length > 0}}">
      <view class="section-header">
        <text class="section-title">高频投诉话术</text>
        <text class="section-more">共{{hotScripts.length}}套</text>
      </view>
      <view class="script-list">
        <view
          class="script-card"
          wx:for="{{hotScripts}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onScriptTap"
          hover-class="script-card-hover"
        >
          <view class="script-card-header">
            <view class="script-icon">📝</view>
            <view class="script-info">
              <text class="script-name">{{item.scene_name || item.name}}</text>
              <text class="script-meta">{{item.scene || '通用场景'}} · 电话版+书面版</text>
            </view>
            <view class="script-arrow">›</view>
          </view>
          <view class="script-preview">
            <text class="script-preview-text">{{item.preview || '点击查看完整话术'}}</text>
          </view>
          <view class="script-tags">
            <text class="script-tag">📞 电话版</text>
            <text class="script-tag">✉️ 书面版</text>
            <text class="script-tag hot">🔥 高频</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部提示 -->
    <view class="footer-tip">
      <text class="footer-text">数据仅供参考，具体以官方平台为准</text>
    </view>

    <view style="height: 40rpx;"></view>
  </view>
</view>
