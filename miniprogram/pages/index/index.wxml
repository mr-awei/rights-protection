<!--pages/index/index.wxml-->
<view class="container {{themeClass}}" style="--status-bar-height: {{statusBarHeight}}px;">
  <!-- 渐变头部 -->
  <view class="gradient-header">
    <view class="header-content">
      <view class="header-top">
        <view class="header-title">
          <text class="title-main">我不能被欺负</text>
          <text class="title-sub">官方投诉渠道 · 一键直达</text>
        </view>
      </view>

      <!-- 搜索框 -->
      <view class="search-box" bindtap="onSearchBoxTap">
        <view class="search-icon"></view>
        <input
          class="search-input"
          placeholder="搜索投诉渠道、话术、流程..."
          placeholder-class="search-placeholder"
          value="{{searchKeyword}}"
          bindinput="onSearchInput"
          bindconfirm="onSearchConfirm"
          confirm-type="search"
        />
        <view class="search-btn" bindtap="onSearchButtonTap">搜索</view>
      </view>

      <!-- 维权须知（合规提示，紧凑样式） -->
      <view class="notice-card-top" bindtap="onNoticeToggle">
        <view class="notice-top-icon app-icon app-icon-default icon-warning"></view>
        <text class="notice-top-text">依法维权 · 虚假举报须承担法律责任 · 倡导先企业内部投诉</text>
        <text class="notice-top-arrow {{noticeExpanded ? 'expanded' : ''}}">›</text>
      </view>
      <view class="notice-detail" wx:if="{{noticeExpanded}}">
        <text class="notice-detail-item">1. 本平台提供的投诉渠道和话术仅供参考，具体以官方平台为准。</text>
        <text class="notice-detail-item">2. 投诉前请先收集好相关证据（合同、聊天记录、转账记录等）。</text>
        <text class="notice-detail-item">3. 建议先通过企业内部投诉渠道解决，无法解决再向监管部门投诉。</text>
        <text class="notice-detail-item">4. 请勿虚假举报、恶意投诉，否则可能承担相应的法律责任。</text>
        <text class="notice-detail-item">5. 紧急情况请直接拨打110、120、119等紧急电话。</text>
      </view>

      <!-- 热门搜索 -->
      <view class="hot-searches">
        <text class="hot-label">热门搜索</text>
        <view class="hot-tags">
          <text
            class="hot-tag"
            wx:for="{{hotSearches}}"
            wx:key="*this"
            data-keyword="{{item}}"
            bindtap="onHotSearchTap"
          >{{item}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 内容区 -->
  <view class="content">
    <!-- 紧急电话条（最优先） -->
    <view class="section">
      <view class="emergency-bar">
        <view class="emergency-bar-title">
          <text class="emergency-bar-text">紧急电话 · 一键拨打</text>
        </view>
        <view class="emergency-phone-list">
          <view
            class="emergency-phone-item"
            wx:for="{{emergencyPhones}}"
            wx:key="name"
            data-phone="{{item.name}}"
            data-label="{{item.label}}"
            bindtap="onEmergencyCall"
            hover-class="emergency-phone-hover"
          >
            <text class="emergency-phone-number" style="color: {{item.color}};">{{item.name}}</text>
            <text class="emergency-phone-label">{{item.label}}</text>
          </view>
        </view>
        <view class="emergency-bar-tip">
          <text>紧急情况请直接拨打，不走投诉流程</text>
        </view>
      </view>
    </view>

    <!-- 快捷场景入口（高频使用） -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">常见场景</text>
        <text class="section-more" bindtap="onMoreScriptsTap">全部分类 ›</text>
      </view>
      <view class="scene-grid">
        <view
          class="scene-item"
          wx:for="{{sceneEntries}}"
          wx:key="label"
          data-keyword="{{item.searchKeyword}}"
          data-issuetype="{{item.issueType}}"
          bindtap="onSceneEntryTap"
          hover-class="scene-item-hover"
        >
          <view class="scene-icon app-icon app-icon-default {{item.iconClass}}" style="--icon-bg: {{item.color}}; --icon-color: {{item.textColor}}; --icon-hover-bg: {{item.textColor}};"></view>
          <view class="scene-text">
            <text class="scene-name">{{item.label}}</text>
            <text class="scene-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 高频话术（高频使用） -->
    <view class="section" wx:if="{{hotScripts.length > 0}}">
      <view class="section-header">
        <text class="section-title">投诉话术</text>
        <text class="section-more" bindtap="onViewAllScripts">共{{hotScripts.length}}套 ›</text>
      </view>
      <view class="script-list">
        <view
          class="script-item"
          wx:for="{{displayScripts}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onScriptTap"
          hover-class="script-item-hover"
        >
          <view class="script-icon app-icon app-icon-default icon-doc" style="--icon-bg: #E8F8EF; --icon-color: #52C41A; --icon-hover-bg: #52C41A;"></view>
          <view class="script-info">
            <text class="script-name">{{item.displayName || item.scene_name || item.name}}</text>
            <text class="script-desc">{{item.scene || '通用场景'}} · 电话版+书面版</text>
          </view>
          <text class="script-arrow">›</text>
        </view>
      </view>
      <view class="view-all-btn" wx:if="{{hotScripts.length > 5}}" bindtap="onViewAllScripts" hover-class="view-all-hover">
        <text>查看全部{{hotScripts.length}}套话术</text>
      </view>
    </view>

    <!-- 工具箱 -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">维权工具箱</text>
      </view>
      <view class="tool-grid">
        <view
          class="tool-item"
          wx:for="{{toolEntries}}"
          wx:key="label"
          data-url="{{item.url}}"
          bindtap="onToolEntryTap"
          hover-class="tool-item-hover"
        >
          <view class="tool-icon app-icon app-icon-default {{item.iconClass}}" style="--icon-bg: {{item.color}}; --icon-color: {{item.textColor}}; --icon-hover-bg: {{item.textColor}};"></view>
          <view class="tool-text">
            <text class="tool-name">{{item.label}}</text>
            <text class="tool-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 最近浏览（个性化推荐） -->
    <view class="section" wx:if="{{recentViews.length > 0}}">
      <view class="section-header">
        <text class="section-title">最近浏览</text>
        <text class="section-more">最近{{recentViews.length}}条</text>
      </view>
      <view class="recent-list">
        <view
          class="recent-item"
          wx:for="{{recentViews}}"
          wx:key="item_id"
          data-item="{{item}}"
          bindtap="onRecentViewTap"
          hover-class="recent-item-hover"
        >
          <view class="recent-type app-icon app-icon-default {{item.item_type === 'channel' ? 'icon-channel' : 'icon-doc'}}" style="--icon-bg: {{item.typeColor}}15; --icon-color: {{item.typeColor}}; --icon-hover-bg: {{item.typeColor}};"></view>
          <view class="recent-info">
            <text class="recent-name">{{item.item_name}}</text>
            <text class="recent-time">{{item.timeStr}}</text>
          </view>
          <text class="recent-arrow">›</text>
        </view>
      </view>
    </view>

    <!-- 底部提示 -->
    <view class="footer-tip">
      <text>数据仅供参考，以官方平台为准</text>
    </view>
  </view>

  <!-- 愿景弹窗 -->
  <view class="vision-modal-mask" wx:if="{{showVisionModal}}">
    <view class="vision-modal">
      <!-- 顶部装饰区 -->
      <view class="vision-header">
        <view class="vision-header-bg"></view>
        <view class="vision-header-content">
          <view class="vision-logo">
            <view class="vision-logo-icon app-icon app-icon-default icon-shield"></view>
          </view>
          <text class="vision-title">我们的愿景</text>
          <text class="vision-subtitle">愿每一个人都能被平等对待</text>
        </view>
      </view>

      <!-- 内容区 -->
      <view class="vision-body">
        <!-- 引言卡片 -->
        <view class="vision-quote-card">
          <view class="quote-mark">"</view>
          <view class="quote-content">
            <text class="quote-line">当你遭遇不公，不必沉默</text>
            <text class="quote-line">当你权利受损，不必退缩</text>
          </view>
          <view class="quote-highlight">勇敢发声 · 理性维权</view>
        </view>

        <!-- 三大核心理念 -->
        <view class="vision-values">
          <view class="value-card">
            <view class="value-icon-wrap icon-bg-blue">
              <view class="value-icon app-icon app-icon-default icon-chat"></view>
            </view>
            <text class="value-title">勇敢发声</text>
            <view class="value-desc">
              <text class="desc-line">遇到不公敢于表达</text>
              <text class="desc-line">不做沉默的大多数</text>
            </view>
          </view>

          <view class="value-card">
            <view class="value-icon-wrap icon-bg-green">
              <view class="value-icon app-icon app-icon-default icon-channel"></view>
            </view>
            <text class="value-title">找到渠道</text>
            <view class="value-desc">
              <text class="desc-line">官方渠道一键直达</text>
              <text class="desc-line">维权不再无路可走</text>
            </view>
          </view>

          <view class="value-card">
            <view class="value-icon-wrap icon-bg-orange">
              <view class="value-icon app-icon app-icon-default icon-heart"></view>
            </view>
            <text class="value-title">平等对待</text>
            <view class="value-desc">
              <text class="desc-line">愿每个人都被尊重</text>
              <text class="desc-line">每份诉求都被听见</text>
            </view>
          </view>
        </view>

        <!-- 维权路径 -->
        <view class="vision-path">
          <view class="path-header">
            <view class="path-title-icon app-icon app-icon-default icon-list"></view>
            <text class="path-title">推荐维权路径</text>
          </view>
          <view class="path-steps">
            <view class="path-step">
              <view class="step-circle step-1">
                <text class="step-num">1</text>
              </view>
              <text class="step-label">企业投诉</text>
            </view>
            <view class="path-connector"></view>
            <view class="path-step">
              <view class="step-circle step-2">
                <text class="step-num">2</text>
              </view>
              <text class="step-label">监管投诉</text>
            </view>
            <view class="path-connector"></view>
            <view class="path-step">
              <view class="step-circle step-3">
                <text class="step-num">3</text>
              </view>
              <text class="step-label">法律途径</text>
            </view>
          </view>
          <text class="path-tip">先协商 · 再投诉 · 最后法律途径</text>
        </view>
      </view>

      <!-- 底部操作区 -->
      <view class="vision-footer">
        <view class="footer-checkbox" bindtap="toggleDontShowAgain">
          <view class="checkbox {{dontShowAgain ? 'checked' : ''}}">
            <view wx:if="{{dontShowAgain}}" class="checkbox-inner"></view>
          </view>
          <text class="checkbox-text">不再提示</text>
        </view>
        <view 
          class="footer-btn {{visionCanClose ? 'btn-active' : 'btn-disabled'}}" 
          bindtap="closeVisionModal"
        >
          <text wx:if="{{!visionCanClose}}">{{visionCountdown}}秒后可关闭</text>
          <text wx:else>我知道了</text>
        </view>
      </view>
    </view>
  </view>
</view>
