/* pages/index/index.wxss */
.container {
  min-height: 100vh;
  background: #F8FAFC;
}

/* ========== 渐变头部 ========== */
.gradient-header {
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 50%, #1D4ED8 100%);
  padding: 0 0 48rpx;
  position: relative;
  overflow: hidden;
}

.gradient-header::before {
  content: '';
  position: absolute;
  top: -120rpx;
  right: -80rpx;
  width: 360rpx;
  height: 360rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
  border-radius: 50%;
}

.gradient-header::after {
  content: '';
  position: absolute;
  bottom: -60rpx;
  left: -60rpx;
  width: 240rpx;
  height: 240rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
  border-radius: 50%;
}

.header-content {
  position: relative;
  z-index: 1;
  padding: 56rpx 32rpx 0;
}

.header-top {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.header-title {
  display: flex;
  flex-direction: column;
}

.title-main {
  font-size: 48rpx;
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: 2rpx;
  margin-bottom: 6rpx;
}

.title-sub {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  font-weight: 400;
}

/* 数据统计栏 */
.header-stats {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.15);
  backdrop-filter: blur(10px);
  border-radius: 16rpx;
  padding: 20rpx 0;
  margin-bottom: 28rpx;
  border: 1rpx solid rgba(255,255,255,0.2);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.2;
  margin-bottom: 4rpx;
}

.stat-label {
  font-size: 20rpx;
  color: rgba(255,255,255,0.8);
  font-weight: 400;
}

.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: rgba(255,255,255,0.25);
}

/* ========== 搜索框 ========== */
.search-box {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 8rpx 8rpx 8rpx 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.12);
  margin-bottom: 28rpx;
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  opacity: 0.6;
}

.search-input {
  flex: 1;
  height: 72rpx;
  font-size: 28rpx;
  color: #1E293B;
}

.search-placeholder {
  color: #94A3B8;
  font-size: 26rpx;
}

.search-btn {
  background: linear-gradient(135deg, #3B82F6, #2563EB);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
  padding: 16rpx 36rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

/* ========== 热门搜索 ========== */
.hot-searches {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
}

.hot-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.9);
  font-weight: 500;
  margin-right: 4rpx;
}

.hot-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.hot-tag {
  background: rgba(255,255,255,0.18);
  backdrop-filter: blur(10px);
  color: #FFFFFF;
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255,255,255,0.25);
  transition: all 0.2s ease;
}

.hot-tag:active {
  background: rgba(255,255,255,0.3);
  transform: scale(0.95);
}

/* ========== 内容区 ========== */
.content {
  padding: 0 24rpx;
  margin-top: 0;
  position: relative;
  z-index: 2;
}

.section {
  margin-bottom: 32rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 8rpx 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1E293B;
}

.section-more {
  font-size: 24rpx;
  color: #94A3B8;
  font-weight: 400;
}

/* ========== 快捷场景入口 ========== */
.scene-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.scene-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 8rpx;
  transition: all 0.2s ease;
}

.scene-item-hover {
  transform: scale(0.92);
}

.scene-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-bottom: 14rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.06);
}

.scene-label {
  font-size: 24rpx;
  color: #475569;
  font-weight: 500;
  text-align: center;
}

/* ========== 紧急电话卡片 ========== */
.emergency-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #FEF2F2 0%, #FEE2E2 100%);
  border-radius: 24rpx;
  padding: 28rpx;
  border: 1rpx solid #FECACA;
  transition: all 0.2s ease;
}

.emergency-card-hover {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(239,68,68,0.2);
}

.emergency-icon {
  font-size: 56rpx;
  margin-right: 20rpx;
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}

.emergency-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.emergency-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #DC2626;
  margin-bottom: 4rpx;
}

.emergency-desc {
  font-size: 22rpx;
  color: #991B1B;
  opacity: 0.8;
}

.emergency-btn {
  background: linear-gradient(135deg, #EF4444, #DC2626);
  padding: 16rpx 28rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(239,68,68,0.3);
}

.emergency-btn-text {
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
}

/* ========== 高频话术卡片 ========== */
.script-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.script-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  transition: all 0.2s ease;
  border-left: 6rpx solid #3B82F6;
}

.script-card-hover {
  transform: scale(0.98);
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
}

.script-card-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.script-icon {
  width: 64rpx;
  height: 64rpx;
  background: linear-gradient(135deg, #EFF6FF, #DBEAFE);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 16rpx;
}

.script-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.script-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1E293B;
  margin-bottom: 4rpx;
}

.script-meta {
  font-size: 22rpx;
  color: #94A3B8;
}

.script-arrow {
  font-size: 36rpx;
  color: #CBD5E1;
  font-weight: 300;
}

.script-preview {
  background: #F8FAFC;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
}

.script-preview-text {
  font-size: 24rpx;
  color: #64748B;
  line-height: 1.6;
}

.script-tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.script-tag {
  font-size: 20rpx;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  background: #F1F5F9;
  color: #64748B;
  font-weight: 500;
}

.script-tag.hot {
  background: #FEF3C7;
  color: #D97706;
}

/* ========== 底部提示 ========== */
.footer-tip {
  text-align: center;
  padding: 32rpx 0;
}

.footer-text {
  font-size: 22rpx;
  color: #CBD5E1;
}
