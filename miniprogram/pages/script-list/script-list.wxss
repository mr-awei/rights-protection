/* pages/script-list/script-list.wxss */
.container {
  min-height: 100vh;
  background: #F5F7FA;
}

/* 自定义导航栏 */
.nav-bar {
  background: linear-gradient(135deg, #1677FF, #4096FF);
  padding-top: var(--status-bar-height);
  padding-bottom: 24rpx;
}

.nav-bar-content {
  padding: 20rpx 32rpx 0;
}

.nav-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.nav-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 搜索框 */
.search-section {
  padding: 24rpx 32rpx;
  background: #FFFFFF;
}

.search-box {
  display: flex;
  align-items: center;
  background: #F5F7FA;
  border-radius: 40rpx;
  padding: 16rpx 28rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.search-placeholder {
  color: #999999;
  font-size: 26rpx;
}

.search-clear {
  font-size: 28rpx;
  color: #999999;
  padding: 8rpx;
}

/* 话术列表 */
.script-list {
  padding: 24rpx 32rpx;
}

.script-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s ease;
}

.script-card-hover {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

/* 卡片头部 */
.card-header {
  display: flex;
  align-items: center;
  padding: 28rpx 28rpx 20rpx;
}

.script-icon {
  width: 72rpx;
  height: 72rpx;
  --icon-bg: linear-gradient(135deg, #52C41A, #73D13D);
  --icon-color: #FFFFFF;
  border-radius: 16rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.script-info {
  flex: 1;
  min-width: 0;
}

.script-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1B1C;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.script-tags {
  display: flex;
  gap: 12rpx;
}

.script-tag {
  font-size: 20rpx;
  color: #52C41A;
  background: #F6FFED;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.favorite-btn {
  padding: 12rpx;
  flex-shrink: 0;
}

.favorite-icon {
  font-size: 40rpx;
  color: #D9D9D9;
}

.favorite-btn.favorited .favorite-icon {
  color: #FAAD14;
}

/* 卡片主体 */
.card-body {
  padding: 0 28rpx 16rpx;
}

.applicable-label {
  font-size: 24rpx;
  color: #8C8C8C;
  font-weight: 500;
}

.applicable-text {
  font-size: 24rpx;
  color: #595959;
  line-height: 1.6;
}

/* 话术预览 */
.card-preview {
  padding: 0 28rpx 20rpx;
}

.preview-text {
  font-size: 24rpx;
  color: #8C8C8C;
  line-height: 1.6;
  background: #FAFAFA;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  display: block;
  border-left: 4rpx solid #52C41A;
}

/* 卡片底部 */
.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  border-top: 1rpx solid #F0F0F0;
  background: #FAFAFA;
}

.footer-hint {
  font-size: 24rpx;
  color: #1677FF;
}

.copy-btn {
  background: linear-gradient(135deg, #52C41A, #73D13D);
  padding: 12rpx 28rpx;
  border-radius: 24rpx;
}

.copy-btn-text {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 500;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-title {
  font-size: 30rpx;
  color: #666666;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #999999;
  text-align: center;
  margin-bottom: 40rpx;
}

.empty-btn {
  background: linear-gradient(135deg, #1677FF, #4096FF);
  color: #FFFFFF;
  padding: 20rpx 48rpx;
  border-radius: 32rpx;
  font-size: 28rpx;
  font-weight: 600;
}
