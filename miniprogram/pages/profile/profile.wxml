<!--pages/profile/profile.wxml-->
<view class="container">
  <!-- 蓝色渐变头部 -->
  <view class="profile-header">
    <view class="avatar">👤</view>
    <view class="p-info">
      <view class="p-name">维权用户</view>
      <view class="p-desc">已帮助 {{searchCount}} 次维权</view>
    </view>
  </view>

  <!-- 统计数据 -->
  <view class="stats-bar">
    <view class="stat-item" bindtap="onFavoriteTap">
      <view class="stat-num">{{favoriteChannels}}</view>
      <view class="stat-label">收藏渠道</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item" bindtap="onFavoriteTap">
      <view class="stat-num">{{favoriteScripts}}</view>
      <view class="stat-label">收藏话术</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <view class="stat-num">{{searchCount}}</view>
      <view class="stat-label">搜索次数</view>
    </view>
  </view>

  <!-- 工具箱 -->
  <view class="tool-list">
    <view
      class="tool-item"
      wx:for="{{toolList}}"
      wx:key="name"
      data-index="{{index}}"
      bindtap="onToolTap"
    >
      <view class="t-icon" style="background: {{item.color}};">{{item.icon}}</view>
      <view class="t-content">
        <view class="t-name">{{item.name}}</view>
        <view class="t-desc">{{item.desc}}</view>
      </view>
      <view class="t-arrow">›</view>
    </view>
  </view>

  <!-- 底部信息 -->
  <view class="footer-info">
    <text>维权通 v1.0.0 MVP版</text>
    <text>数据仅供参考，以官方渠道为准</text>
  </view>
</view>
