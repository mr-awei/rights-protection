<!--pages/profile/profile.wxml-->
<view class="container" style="--status-bar-height: {{statusBarHeight}}px;">
  <!-- 渐变头部 -->
  <view class="gradient-header">
    <view class="header-content">
      <!-- 用户信息 -->
      <view class="user-section">
        <view class="avatar">
          <image class="avatar-img" src="/images/logo.png" mode="aspectFill"></image>
        </view>
        <view class="user-info">
          <text class="user-name">正义战士</text>
          <text class="user-desc">用法律维护自己的权益</text>
        </view>
        <view class="user-level">
          <text class="level-text">MVP</text>
        </view>
      </view>

      <!-- 统计数据 -->
      <view class="stats-row">
        <view class="stat-item" bindtap="onStatTap" data-type="channels" hover-class="stat-item-hover">
          <text class="stat-number">{{favoriteChannels}}</text>
          <text class="stat-label">收藏渠道</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item" bindtap="onStatTap" data-type="scripts" hover-class="stat-item-hover">
          <text class="stat-number">{{favoriteScripts}}</text>
          <text class="stat-label">收藏话术</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item" bindtap="onStatTap" data-type="viewHistory" hover-class="stat-item-hover">
          <text class="stat-number">{{viewHistoryCount}}</text>
          <text class="stat-label">浏览历史</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item" bindtap="onStatTap" data-type="search" hover-class="stat-item-hover">
          <text class="stat-number">{{searchCount}}</text>
          <text class="stat-label">搜索次数</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 内容区 -->
  <view class="content">
    <!-- 我的收藏 -->
    <view class="card">
      <view class="card-header">
        <text class="card-title">我的收藏</text>
        <view class="card-more" bindtap="onViewAllFavorites">
          <text>查看全部</text>
          <text class="more-arrow">›</text>
        </view>
      </view>

      <!-- 收藏Tab切换 -->
      <view class="tab-row">
        <view
          class="tab-item {{activeFavTab === 'channels' ? 'active' : ''}}"
          data-tab="channels"
          bindtap="onFavTabTap"
        >渠道</view>
        <view
          class="tab-item {{activeFavTab === 'scripts' ? 'active' : ''}}"
          data-tab="scripts"
          bindtap="onFavTabTap"
        >话术</view>
      </view>

      <!-- 收藏的渠道列表（只显示最近3条） -->
      <view class="item-list" wx:if="{{activeFavTab === 'channels'}}">
        <view
          class="item-row"
          wx:for="{{favoriteChannelList.slice(0, 3)}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onFavoriteChannelTap"
          hover-class="item-row-hover"
        >
          <view class="item-icon channel-icon"></view>
          <view class="item-info">
            <text class="item-name">{{item.name}}</text>
            <text class="item-desc" wx:if="{{item.phone}}">{{item.phone}}</text>
            <text class="item-desc" wx:else>{{item.category}}</text>
          </view>
          <view class="item-remove" catchtap="onRemoveFavoriteChannel" data-id="{{item.id}}">
            <text>✕</text>
          </view>
        </view>

        <!-- 空状态 -->
        <view class="empty-box" wx:if="{{favoriteChannelList.length === 0}}">
          <text class="empty-title">还没有收藏渠道</text>
          <text class="empty-desc">看到有用的渠道就收藏吧</text>
        </view>

        <!-- 更多提示 -->
        <view class="more-row" wx:if="{{favoriteChannelList.length > 3}}" bindtap="onViewAllFavorites" data-tab="channels">
          <text>还有 {{favoriteChannelList.length - 3}} 条，查看全部</text>
          <text class="more-arrow">›</text>
        </view>
      </view>

      <!-- 收藏的话术列表（只显示最近3条） -->
      <view class="item-list" wx:if="{{activeFavTab === 'scripts'}}">
        <view
          class="item-row"
          wx:for="{{favoriteScriptList.slice(0, 3)}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onFavoriteScriptTap"
          hover-class="item-row-hover"
        >
          <view class="item-icon script-icon"></view>
          <view class="item-info">
            <text class="item-name">{{item.name}}</text>
            <text class="item-desc">{{item.applicable || '投诉话术'}}</text>
          </view>
          <view class="item-remove" catchtap="onRemoveFavoriteScript" data-id="{{item.id}}">
            <text>✕</text>
          </view>
        </view>

        <!-- 空状态 -->
        <view class="empty-box" wx:if="{{favoriteScriptList.length === 0}}">
          <text class="empty-title">还没有收藏话术</text>
          <text class="empty-desc">看到有用的话术就收藏吧</text>
        </view>

        <!-- 更多提示 -->
        <view class="more-row" wx:if="{{favoriteScriptList.length > 3}}" bindtap="onViewAllFavorites" data-tab="scripts">
          <text>还有 {{favoriteScriptList.length - 3}} 条，查看全部</text>
          <text class="more-arrow">›</text>
        </view>
      </view>
    </view>

    <!-- 浏览历史 -->
    <view class="card">
      <view class="card-header">
        <text class="card-title">浏览历史</text>
        <view class="card-more" bindtap="onViewAllHistory">
          <text>查看全部</text>
          <text class="more-arrow">›</text>
        </view>
      </view>

      <view class="item-list" wx:if="{{viewHistoryList.length > 0}}">
        <view
          class="item-row"
          wx:for="{{viewHistoryList.slice(0, 3)}}"
          wx:key="item_id"
          data-item="{{item}}"
          bindtap="onViewHistoryTap"
          hover-class="item-row-hover"
        >
          <view class="item-icon history-icon" style="background: {{item.typeColor}}15;"></view>
          <view class="item-info">
            <text class="item-name">{{item.item_name}}</text>
            <text class="item-desc">{{item.typeLabel}} · {{item.timeStr}}</text>
          </view>
          <text class="item-arrow">›</text>
        </view>

        <!-- 更多提示 -->
        <view class="more-row" wx:if="{{viewHistoryList.length > 3}}" bindtap="onViewAllHistory">
          <text>还有 {{viewHistoryList.length - 3}} 条，查看全部</text>
          <text class="more-arrow">›</text>
        </view>
      </view>

      <!-- 空状态 -->
      <view class="empty-box" wx:if="{{viewHistoryList.length === 0}}">
        <text class="empty-title">还没有浏览记录</text>
        <text class="empty-desc">去看看有哪些投诉渠道吧</text>
      </view>
    </view>

    <!-- 工具箱 -->
    <view class="card">
      <view class="card-header">
        <text class="card-title">工具箱</text>
      </view>
      <view class="item-list">
        <view
          class="item-row"
          wx:for="{{toolList}}"
          wx:key="name"
          data-index="{{index}}"
          bindtap="onToolTap"
          hover-class="item-row-hover"
        >
          <view class="item-icon tool-icon" style="background: {{item.color}}15;"></view>
          <view class="item-info">
            <text class="item-name">{{item.name}}</text>
            <text class="item-desc">{{item.desc}}</text>
          </view>
          <text class="item-arrow">›</text>
        </view>
      </view>
    </view>

    <!-- 数据概览 -->
    <view class="card">
      <view class="card-header">
        <text class="card-title">数据概览</text>
      </view>
      <view class="stats-grid">
        <view class="stats-cell">
          <text class="stats-num">122</text>
          <text class="stats-label">官方渠道</text>
        </view>
        <view class="stats-cell">
          <text class="stats-num">6</text>
          <text class="stats-label">投诉话术</text>
        </view>
        <view class="stats-cell">
          <text class="stats-num">10</text>
          <text class="stats-label">领域分类</text>
        </view>
        <view class="stats-cell">
          <text class="stats-num">40</text>
          <text class="stats-label">二级分类</text>
        </view>
      </view>
    </view>

    <!-- 底部版本信息 -->
    <view class="footer">
      <text class="footer-version">我不能被欺负 v1.0.0 MVP</text>
      <text class="footer-copyright">数据仅供参考，以官方平台为准</text>
    </view>
  </view>
</view>
