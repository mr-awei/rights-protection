<!--pages/profile/profile.wxml-->
<view class="container" style="--status-bar-height: {{statusBarHeight}}px;">
  <!-- 渐变头部 -->
  <view class="gradient-header">
    <view class="header-content">
      <!-- 用户信息 -->
      <view class="user-section">
        <view class="avatar">
          <image class="avatar-img" src="/images/logo.jpg" mode="aspectFill"></image>
        </view>
        <view class="user-info">
          <text class="user-name">正义战士</text>
          <text class="user-desc">用法律维护自己的权益</text>
        </view>
        <view class="user-level">
          <text class="level-text">正式版</text>
        </view>
      </view>

      <!-- 统计数据 -->
      <view class="stats-row">
        <view class="stat-item" bindtap="onStatTap" data-type="channels" hover-class="stat-item-hover">
          <text class="stat-number">{{favoriteChannels}}</text>
          <text class="stat-label">收藏渠道</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item" bindtap="onStatTap" data-type="scripts" hover-class="stat-item-hover">
          <text class="stat-number">{{favoriteScripts}}</text>
          <text class="stat-label">收藏话术</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item" bindtap="onStatTap" data-type="viewHistory" hover-class="stat-item-hover">
          <text class="stat-number">{{viewHistoryCount}}</text>
          <text class="stat-label">浏览历史</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item" bindtap="onStatTap" data-type="search" hover-class="stat-item-hover">
          <text class="stat-number">{{searchCount}}</text>
          <text class="stat-label">搜索次数</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 内容区 -->
  <view class="content">
    <!-- 工具箱 -->
    <ui-card title="工具箱">
      <list-item
        wx:for="{{toolList}}"
        wx:key="name"
        icon="{{item.iconClass}}"
        icon-bg="{{item.color}}15"
        icon-color="{{item.color}}"
        title="{{item.name}}"
        desc="{{item.desc}}"
        show-arrow="{{true}}"
        data-index="{{index}}"
        bind:tap="onToolTap"
      ></list-item>
    </ui-card>

    <!-- 其他 -->
    <ui-card title="其他">
      <list-item
        wx:for="{{otherList}}"
        wx:key="name"
        icon="{{item.iconClass}}"
        icon-bg="{{item.color}}15"
        icon-color="{{item.color}}"
        title="{{item.name}}"
        desc="{{item.desc}}"
        show-arrow="{{true}}"
        data-index="{{index}}"
        bind:tap="onOtherTap"
      ></list-item>
    </ui-card>

    <!-- 友情链接 -->
    <view class="card">
      <view class="card-header">
        <text class="card-title">友情链接</text>
      </view>
      <view class="friend-link-list">
        <view
          class="friend-link-item"
          wx:for="{{friendLinks}}"
          wx:key="name"
          data-index="{{index}}"
          bindtap="onFriendLinkTap"
          hover-class="friend-link-item-hover"
        >
          <view class="friend-link-icon app-icon app-icon-default {{item.iconClass}}" style="--icon-bg: {{item.color}}15; --icon-color: {{item.color}}; --icon-hover-bg: {{item.color}};"></view>
          <view class="friend-link-info">
            <text class="friend-link-name">{{item.name}}</text>
            <text class="friend-link-desc">{{item.desc}}</text>
          </view>
          <view class="friend-link-arrow app-icon app-icon-default icon-chevron-right" style="width:24rpx;height:24rpx;--icon-bg:transparent;--icon-color:#999;"></view>
        </view>
      </view>
    </view>

    <!-- 底部版本信息 -->
    <view class="footer">
      <text class="footer-version">我不能被欺负 v1.1.2</text>
      <text class="footer-copyright">数据仅供参考，以官方平台为准</text>
    </view>
  </view>

  <!-- 自定义弹窗 -->
  <custom-modal
    visible="{{modalVisible}}"
    type="{{modalType}}"
    title="{{modalTitle}}"
    content="{{modalContent}}"
    confirmText="{{modalConfirmText}}"
    cancelText="{{modalCancelText}}"
    showCancel="{{modalShowCancel}}"
    placeholder="{{modalPlaceholder}}"
    defaultValue="{{modalDefaultValue}}"
    itemList="{{modalItemList}}"
    bind:confirm="onModalConfirm"
    bind:cancel="onModalCancel"
    bind:select="onModalSelect"
  />
</view>
