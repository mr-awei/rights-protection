/* pages/profile/profile.wxss */
.container {
  min-height: 100vh;
  background: #F1F5F9;
}

/* ========== 渐变头部 ========== */
.gradient-header {
  background: linear-gradient(135deg, #60A5FA 0%, #3B82F6 35%, #2563EB 65%, #1E40AF 100%);
  padding: 0 0 48rpx;
  position: relative;
  overflow: hidden;
  margin-top: calc(var(--status-bar-height, 0px) * -1);
  padding-top: var(--status-bar-height, 0px);
}

.gradient-header::before {
  content: '';
  position: absolute;
  top: -150rpx;
  right: -100rpx;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.25) 0%, transparent 70%);
  border-radius: 50%;
}

.gradient-header::after {
  content: '';
  position: absolute;
  bottom: -120rpx;
  left: -80rpx;
  width: 340rpx;
  height: 340rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
  border-radius: 50%;
}

.header-content {
  position: relative;
  z-index: 1;
  padding: 20rpx 32rpx 0;
}

/* ========== 用户信息 ========== */
.user-section {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 5rpx solid rgba(255,255,255,0.95);
  box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.2);
  overflow: hidden;
  flex-shrink: 0;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.user-info {
  flex: 1;
  margin-left: 28rpx;
}

.user-name {
  font-size: 40rpx;
  font-weight: 800;
  color: #FFFFFF;
  display: block;
  margin-bottom: 10rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15);
  letter-spacing: 1rpx;
}

.user-desc {
  font-size: 26rpx;
  color: rgba(255,255,255,0.9);
  display: block;
  font-weight: 500;
}

.user-level {
  background: linear-gradient(135deg, #FCD34D, #F59E0B, #D97706);
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 16rpx rgba(245,158,11,0.5);
  border: 1rpx solid rgba(255,255,255,0.3);
}

.level-text {
  font-size: 24rpx;
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: 1rpx;
}

/* ========== 统计数据 ========== */
.stats-row {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.22);
  backdrop-filter: blur(20px);
  border-radius: 24rpx;
  padding: 24rpx 0;
  border: 1rpx solid rgba(255,255,255,0.3);
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.08);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: all 0.2s ease;
}

.stat-item-hover {
  opacity: 0.8;
  transform: scale(0.96);
}

.stat-number {
  font-size: 48rpx;
  font-weight: 800;
  color: #FFFFFF;
  line-height: 1.2;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15);
  letter-spacing: 1rpx;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.9);
  margin-top: 8rpx;
  font-weight: 500;
}

.stat-divider {
  width: 1rpx;
  height: 56rpx;
  background: rgba(255,255,255,0.35);
}

/* ========== 内容区 ========== */
.content {
  padding: 28rpx 24rpx 40rpx;
  margin-top: -28rpx;
  position: relative;
  z-index: 2;
}

.section {
  margin-bottom: 28rpx;
}

.section-header {
  padding: 0 8rpx 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #0F172A;
  letter-spacing: 0.5rpx;
}

/* ========== 工具箱 ========== */
.tool-grid {
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.06);
  border: 1rpx solid #F1F5F9;
}

.tool-item {
  display: flex;
  align-items: center;
  padding: 30rpx 24rpx;
  border-bottom: 1rpx solid #F8FAFC;
  transition: all 0.2s ease;
}

.tool-item:last-child {
  border-bottom: none;
}

.tool-item-hover {
  background: #F8FAFC;
}

.tool-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  flex-shrink: 0;
}

.tool-info {
  flex: 1;
  margin-left: 22rpx;
}

.tool-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #0F172A;
  display: block;
  margin-bottom: 6rpx;
}

.tool-desc {
  font-size: 24rpx;
  color: #94A3B8;
  display: block;
}

.tool-arrow {
  font-size: 34rpx;
  color: #CBD5E1;
  margin-left: 16rpx;
  font-weight: 700;
}

/* ========== 数据概览卡片 ========== */
.info-card {
  background: linear-gradient(135deg, #FFFFFF 0%, #F8FAFC 100%);
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.06);
  border: 1rpx solid #E2E8F0;
}

.info-header {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.info-icon {
  font-size: 34rpx;
  margin-right: 14rpx;
}

.info-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #0F172A;
  letter-spacing: 0.5rpx;
}

.info-stats {
  display: flex;
  flex-wrap: wrap;
}

.info-stat {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 18rpx 0;
}

.info-stat-num {
  font-size: 40rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #3B82F6, #1D4ED8);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  letter-spacing: 1rpx;
}

.info-stat-label {
  font-size: 22rpx;
  color: #64748B;
  margin-top: 6rpx;
  font-weight: 500;
}

/* ========== 底部 ========== */
.footer {
  text-align: center;
  padding: 40rpx 0 20rpx;
}

.footer-version {
  font-size: 24rpx;
  color: #94A3B8;
  display: block;
  margin-bottom: 10rpx;
  font-weight: 500;
}

.footer-copyright {
  font-size: 22rpx;
  color: #CBD5E1;
  display: block;
}

/* ========== 收藏Tab切换 ========== */
.fav-tabs {
  display: flex;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 0 8rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
  border: 1rpx solid #F1F5F9;
  position: relative;
}

.fav-tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0 20rpx;
  font-size: 28rpx;
  color: #94A3B8;
  font-weight: 500;
  position: relative;
  transition: all 0.25s ease;
}

.fav-tab.active {
  color: #1E293B;
  font-weight: 700;
}

.fav-tab.active::after {
  content: '';
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #3B82F6, #2563EB);
  border-radius: 3rpx;
}

/* ========== 收藏列表 ========== */
.fav-list {
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
  border: 1rpx solid #F1F5F9;
}

.fav-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #F8FAFC;
  transition: all 0.2s ease;
}

.fav-item:last-child {
  border-bottom: none;
}

.fav-item-hover {
  background: #F8FAFC;
}

.fav-item-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.fav-item-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.fav-item-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #0F172A;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fav-item-meta {
  font-size: 24rpx;
  color: #94A3B8;
}

.fav-item-remove {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F1F5F9;
  border-radius: 50%;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.fav-item-remove text {
  font-size: 26rpx;
  color: #94A3B8;
  font-weight: 700;
}

/* ========== 浏览历史 ========== */
.clear-btn {
  background: #F1F5F9;
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
  margin-left: auto;
}

.clear-btn text {
  font-size: 22rpx;
  color: #64748B;
  font-weight: 500;
}

/* 查看全部按钮 */
.view-all-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #EFF6FF 0%, #DBEAFE 100%);
  border: 1rpx solid #BFDBFE;
}

.view-all-btn text {
  font-size: 22rpx;
  color: #2563EB;
  font-weight: 600;
}

.view-all-arrow {
  font-size: 26rpx !important;
  color: #2563EB !important;
  line-height: 1;
  font-weight: 700;
}

/* 更多提示 */
.more-tip {
  margin-top: 16rpx;
  background: linear-gradient(135deg, #F8FAFC 0%, #EFF6FF 100%);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  text-align: center;
  border: 1rpx solid #E0E7FF;
}

.more-tip text {
  font-size: 24rpx;
  background: linear-gradient(135deg, #3B82F6, #2563EB);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  font-weight: 600;
}

.history-list {
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
  border: 1rpx solid #F1F5F9;
}

.history-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #F8FAFC;
  transition: all 0.2s ease;
}

.history-item:last-child {
  border-bottom: none;
}

.history-item-hover {
  background: #F8FAFC;
}

.history-type {
  padding: 8rpx 18rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.history-type text {
  font-size: 22rpx;
  font-weight: 700;
}

.history-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.history-name {
  font-size: 28rpx;
  color: #0F172A;
  font-weight: 600;
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-time {
  font-size: 22rpx;
  color: #94A3B8;
}

.history-arrow {
  font-size: 32rpx;
  color: #CBD5E1;
  margin-left: 16rpx;
  font-weight: 700;
}

/* ========== 空状态 ========== */
.empty-state {
  padding: 64rpx 24rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #F8FAFC 0%, #EFF6FF 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid #E0E7FF;
}

.empty-title {
  font-size: 30rpx;
  color: #475569;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #94A3B8;
  line-height: 1.6;
}
