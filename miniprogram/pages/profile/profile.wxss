/* pages/profile/profile.wxss */
.container {
  min-height: 100vh;
  background: #F5F6F8;
}

/* ========== 渐变头部 ========== */
.gradient-header {
  background: linear-gradient(180deg, #4A90D9 0%, #5B9BD5 100%);
  padding: 0 0 32rpx;
  position: relative;
  overflow: hidden;
  margin-top: calc(var(--status-bar-height, 0px) * -1);
  padding-top: var(--status-bar-height, 0px);
}

.header-content {
  position: relative;
  z-index: 1;
  padding: 24rpx 32rpx 0;
}

/* ========== 用户信息 ========== */
.user-section {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.9);
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.12);
  overflow: hidden;
  flex-shrink: 0;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.user-info {
  flex: 1;
  margin-left: 24rpx;
}

.user-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
  display: block;
  margin-bottom: 8rpx;
}

.user-desc {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  display: block;
}

.user-level {
  background: rgba(255,255,255,0.2);
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(255,255,255,0.3);
}

.level-text {
  font-size: 22rpx;
  font-weight: 600;
  color: #FFFFFF;
}

/* ========== 统计数据 ========== */
.stats-row {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.15);
  border-radius: 16rpx;
  padding: 20rpx 0;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: opacity 0.2s ease;
}

.stat-item-hover {
  opacity: 0.7;
}

.stat-number {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.2;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 6rpx;
}

.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: rgba(255,255,255,0.25);
}

/* ========== 内容区 ========== */
.content {
  padding: 20rpx 24rpx 40rpx;
  margin-top: -16rpx;
  position: relative;
  z-index: 2;
}

/* ========== 卡片 ========== */
.card {
  background: #FFFFFF;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx 20rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.card-more {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.card-more text {
  font-size: 24rpx;
  color: #999999;
}

.more-arrow {
  font-size: 28rpx !important;
  color: #CCCCCC !important;
  line-height: 1;
}

/* ========== Tab切换 ========== */
.tab-row {
  display: flex;
  padding: 0 24rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0 20rpx;
  font-size: 28rpx;
  color: #999999;
  font-weight: 500;
  position: relative;
  transition: color 0.2s ease;
}

.tab-item.active {
  color: #1A1A1A;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 36rpx;
  height: 4rpx;
  background: #4A90D9;
  border-radius: 2rpx;
}

/* ========== 列表项 ========== */
.item-list {
  padding: 0 24rpx;
}

.item-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F8F8F8;
  transition: background 0.2s ease;
}

.item-row:last-child {
  border-bottom: none;
}

.item-row-hover {
  background: #FAFAFA;
}

.item-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.channel-icon {
  background: #E8F3FC;
}

.script-icon {
  background: #E8F8EF;
}

.history-icon {
  background: #F0F0F0;
}

.tool-icon {
  background: #F5F5F5;
}

.item-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.item-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1A1A1A;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-desc {
  font-size: 24rpx;
  color: #999999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-remove {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #F5F5F5;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.item-remove text {
  font-size: 24rpx;
  color: #BBBBBB;
  font-weight: 500;
}

.item-arrow {
  font-size: 32rpx;
  color: #DDDDDD;
  margin-left: 12rpx;
  flex-shrink: 0;
}

/* ========== 空状态 ========== */
.empty-box {
  padding: 48rpx 0;
  text-align: center;
}

.empty-title {
  font-size: 28rpx;
  color: #999999;
  display: block;
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #CCCCCC;
  display: block;
}

/* ========== 更多提示 ========== */
.more-row {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0 24rpx;
  gap: 4rpx;
}

.more-row text {
  font-size: 24rpx;
  color: #999999;
}

/* ========== 数据概览 ========== */
.stats-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 24rpx 24rpx;
}

.stats-cell {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
}

.stats-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #4A90D9;
}

.stats-label {
  font-size: 22rpx;
  color: #999999;
  margin-top: 6rpx;
}

/* ========== 底部 ========== */
.footer {
  text-align: center;
  padding: 32rpx 0 16rpx;
}

.footer-version {
  font-size: 22rpx;
  color: #CCCCCC;
  display: block;
  margin-bottom: 8rpx;
}

.footer-copyright {
  font-size: 20rpx;
  color: #DDDDDD;
  display: block;
}
