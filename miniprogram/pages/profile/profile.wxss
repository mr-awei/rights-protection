/* pages/profile/profile.wxss */
.container {
  min-height: 100vh;
  background: #F1F5F9;
}

/* ========== 渐变头部 ========== */
.gradient-header {
  background: linear-gradient(135deg, #60A5FA 0%, #3B82F6 40%, #2563EB 70%, #1D4ED8 100%);
  padding: 0 0 48rpx;
  position: relative;
  overflow: hidden;
  margin-top: -50rpx;
  padding-top: 50rpx;
}

.gradient-header::before {
  content: '';
  position: absolute;
  top: -120rpx;
  right: -80rpx;
  width: 360rpx;
  height: 360rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.2) 0%, transparent 70%);
  border-radius: 50%;
}

.gradient-header::after {
  content: '';
  position: absolute;
  bottom: -100rpx;
  left: -60rpx;
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.12) 0%, transparent 70%);
  border-radius: 50%;
}

.header-content {
  position: relative;
  z-index: 1;
  padding: 32rpx 32rpx 0;
}

/* ========== 用户信息 ========== */
.user-section {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.9);
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.15);
  overflow: hidden;
  flex-shrink: 0;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.user-info {
  flex: 1;
  margin-left: 24rpx;
}

.user-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  display: block;
  margin-bottom: 8rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.user-desc {
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
  display: block;
}

.user-level {
  background: linear-gradient(135deg, #FBBF24, #F59E0B);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(245,158,11,0.4);
}

.level-text {
  font-size: 22rpx;
  font-weight: 700;
  color: #FFFFFF;
}

/* ========== 统计数据 ========== */
.stats-row {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.18);
  backdrop-filter: blur(10px);
  border-radius: 20rpx;
  padding: 28rpx 0;
  border: 1rpx solid rgba(255,255,255,0.25);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: all 0.2s ease;
}

.stat-item-hover {
  opacity: 0.7;
  transform: scale(0.95);
}

.stat-number {
  font-size: 44rpx;
  font-weight: 800;
  color: #FFFFFF;
  line-height: 1.2;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.85);
  margin-top: 6rpx;
}

.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: rgba(255,255,255,0.3);
}

/* ========== 内容区 ========== */
.content {
  padding: 24rpx 24rpx 40rpx;
  margin-top: -20rpx;
  position: relative;
  z-index: 2;
}

.section {
  margin-bottom: 24rpx;
}

.section-header {
  padding: 0 8rpx 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1E293B;
}

/* ========== 工具箱 ========== */
.tool-grid {
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
}

.tool-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #F1F5F9;
  transition: all 0.2s ease;
}

.tool-item:last-child {
  border-bottom: none;
}

.tool-item-hover {
  background: #F8FAFC;
}

.tool-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

.tool-info {
  flex: 1;
  margin-left: 20rpx;
}

.tool-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1E293B;
  display: block;
  margin-bottom: 4rpx;
}

.tool-desc {
  font-size: 22rpx;
  color: #94A3B8;
  display: block;
}

.tool-arrow {
  font-size: 32rpx;
  color: #CBD5E1;
  margin-left: 12rpx;
}

/* ========== 数据概览卡片 ========== */
.info-card {
  background: linear-gradient(135deg, #FFFFFF 0%, #F8FAFC 100%);
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
  border: 1rpx solid #E2E8F0;
}

.info-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.info-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.info-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1E293B;
}

.info-stats {
  display: flex;
  flex-wrap: wrap;
}

.info-stat {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
}

.info-stat-num {
  font-size: 36rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #3B82F6, #1D4ED8);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.info-stat-label {
  font-size: 20rpx;
  color: #64748B;
  margin-top: 4rpx;
}

/* ========== 底部 ========== */
.footer {
  text-align: center;
  padding: 32rpx 0 16rpx;
}

.footer-version {
  font-size: 22rpx;
  color: #94A3B8;
  display: block;
  margin-bottom: 8rpx;
}

.footer-copyright {
  font-size: 20rpx;
  color: #CBD5E1;
  display: block;
}
