/* pages/profile/profile.wxss */
.container {
  min-height: 100vh;
  background: #F8FAFC;
}

/* ========== 渐变头部 ========== */
.gradient-header {
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 50%, #1D4ED8 100%);
  padding: 0 0 56rpx;
  position: relative;
  overflow: hidden;
  margin-top: calc(var(--status-bar-height) * -1);
  padding-top: var(--status-bar-height);
}

.gradient-header::before {
  content: '';
  position: absolute;
  top: -100rpx;
  right: -60rpx;
  width: 320rpx;
  height: 320rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
  border-radius: 50%;
}

.gradient-header::after {
  content: '';
  position: absolute;
  bottom: -80rpx;
  left: -40rpx;
  width: 280rpx;
  height: 280rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
  border-radius: 50%;
}

.header-content {
  position: relative;
  z-index: 1;
  padding: 56rpx 32rpx 0;
}

/* 用户信息 */
.user-section {
  display: flex;
  align-items: center;
  margin-bottom: 36rpx;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
  backdrop-filter: blur(10px);
  border: 3rpx solid rgba(255,255,255,0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.avatar-icon {
  font-size: 56rpx;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 6rpx;
}

.user-desc {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
}

.user-level {
  background: rgba(255,255,255,0.2);
  backdrop-filter: blur(10px);
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255,255,255,0.3);
}

.level-text {
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 600;
}

/* 统计数据 */
.stats-row {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.15);
  backdrop-filter: blur(10px);
  border-radius: 24rpx;
  padding: 28rpx 0;
  border: 1rpx solid rgba(255,255,255,0.2);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-item-hover {
  opacity: 0.7;
  transform: scale(0.95);
}

.stat-number {
  font-size: 40rpx;
  font-weight: 800;
  color: #FFFFFF;
  margin-bottom: 6rpx;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
}

.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: rgba(255,255,255,0.25);
}

/* ========== 内容区 ========== */
.content {
  padding: 0 24rpx;
  margin-top: 0;
  position: relative;
  z-index: 2;
}

.section {
  margin-bottom: 32rpx;
}

.section-header {
  padding: 8rpx 8rpx 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1E293B;
}

/* ========== 工具箱 ========== */
.tool-grid {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 8rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.tool-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #F1F5F9;
  transition: all 0.2s ease;
}

.tool-item:last-child {
  border-bottom: none;
}

.tool-item-hover {
  opacity: 0.7;
}

.tool-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 20rpx;
}

.tool-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.tool-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1E293B;
  margin-bottom: 4rpx;
}

.tool-desc {
  font-size: 22rpx;
  color: #94A3B8;
}

.tool-arrow {
  font-size: 36rpx;
  color: #CBD5E1;
  font-weight: 300;
}

/* ========== 数据概览卡片 ========== */
.info-card {
  background: linear-gradient(135deg, #EFF6FF 0%, #DBEAFE 100%);
  border-radius: 24rpx;
  padding: 28rpx;
  border: 1rpx solid #BFDBFE;
}

.info-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.info-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.info-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1E40AF;
}

.info-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.info-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255,255,255,0.6);
  border-radius: 16rpx;
  padding: 20rpx 8rpx;
}

.info-stat-num {
  font-size: 36rpx;
  font-weight: 800;
  color: #2563EB;
  margin-bottom: 4rpx;
}

.info-stat-label {
  font-size: 20rpx;
  color: #64748B;
  text-align: center;
}

/* ========== 底部 ========== */
.footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 32rpx;
}

.footer-version {
  font-size: 24rpx;
  color: #94A3B8;
  margin-bottom: 8rpx;
}

.footer-copyright {
  font-size: 22rpx;
  color: #CBD5E1;
}
