/* pages/profile/profile.wxss */
.container {
  min-height: 100vh;
  background: var(--bg-page);
}

/* ========== 渐变头部 ========== */
.gradient-header {
  background: linear-gradient(180deg, var(--primary) 0%, var(--primary-light) 100%);
  padding: 0 0 32rpx;
  position: relative;
  overflow: hidden;
  margin-top: calc(var(--status-bar-height, 0px) * -1);
  padding-top: var(--status-bar-height, 0px);
}

.header-content {
  position: relative;
  z-index: 1;
  padding: 24rpx 32rpx 0;
}

/* ========== 用户信息 ========== */
.user-section {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.9);
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.12);
  overflow: hidden;
  flex-shrink: 0;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.user-info {
  flex: 1;
  margin-left: 24rpx;
}

.user-name {
  font-size: var(--font-2xl);
  font-weight: 600;
  color: var(--text-inverse);
  display: block;
  margin-bottom: 8rpx;
}

.user-desc {
  font-size: var(--font-base);
  color: rgba(255,255,255,0.8);
  display: block;
}

.user-level {
  background: rgba(255,255,255,0.2);
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(255,255,255,0.3);
}

.level-text {
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--text-inverse);
}

/* ========== 统计数据 ========== */
.stats-row {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.15);
  border-radius: 16rpx;
  padding: 20rpx 0;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: opacity 0.2s ease;
}

.stat-item-hover {
  opacity: 0.7;
}

.stat-number {
  font-size: var(--font-3xl);
  font-weight: 700;
  color: var(--text-inverse);
  line-height: 1.2;
}

.stat-label {
  font-size: var(--font-sm);
  color: rgba(255,255,255,0.8);
  margin-top: 6rpx;
}

.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: rgba(255,255,255,0.25);
}

/* ========== 内容区 ========== */
.content {
  padding: 20rpx 24rpx 40rpx;
  margin-top: -16rpx;
  position: relative;
  z-index: 2;
}

/* ========== 卡片 ========== */
.card {
  background: var(--bg-card);
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx 20rpx;
}

.card-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--text-primary);
}

.card-more {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.card-more text {
  font-size: var(--font-base);
  color: var(--text-tertiary);
}

.more-arrow {
  font-size: var(--font-normal) !important;
  color: var(--text-quaternary) !important;
  line-height: 1;
}

/* ========== Tab切换 ========== */
.tab-row {
  display: flex;
  padding: 0 24rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0 20rpx;
  font-size: var(--font-normal);
  color: var(--text-tertiary);
  font-weight: 500;
  position: relative;
  transition: color 0.2s ease;
}

.tab-item.active {
  color: var(--text-primary);
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 36rpx;
  height: 4rpx;
  background: var(--primary);
  border-radius: 2rpx;
}

/* ========== 列表项 ========== */
.item-list {
  padding: 0 24rpx;
}

.item-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F8F8F8;
  transition: background 0.2s ease;
}

.item-row:last-child {
  border-bottom: none;
}

.item-row-hover {
  background: #FAFAFA;
}

.item-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.icon-text {
  font-size: var(--font-normal);
  font-weight: 600;
  line-height: 1;
}

.channel-icon {
  --icon-bg: var(--primary-bg);
  --icon-color: var(--primary);
  --icon-hover-bg: var(--primary);
}

.script-icon {
  --icon-bg: #E8F8EF;
  --icon-color: var(--success);
  --icon-hover-bg: var(--success);
}

.history-icon {
  background: #F0F0F0;
}

.tool-icon {
  background: var(--border-light);
}

.item-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.item-name {
  font-size: var(--font-normal);
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-desc {
  font-size: var(--font-base);
  color: var(--text-tertiary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-remove {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--border-light);
  margin-left: 16rpx;
  flex-shrink: 0;
}

.item-remove text {
  font-size: var(--font-base);
  color: #BBBBBB;
  font-weight: 500;
}

.item-arrow {
  font-size: var(--font-xl);
  color: #DDDDDD;
  margin-left: 12rpx;
  flex-shrink: 0;
}

/* ========== 空状态 ========== */
.empty-box {
  padding: 48rpx 0;
  text-align: center;
}

.empty-title {
  font-size: var(--font-normal);
  color: var(--text-tertiary);
  display: block;
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: var(--font-base);
  color: var(--text-quaternary);
  display: block;
}

/* ========== 更多提示 ========== */
.more-row {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0 24rpx;
  gap: 4rpx;
}

.more-row text {
  font-size: var(--font-base);
  color: var(--text-tertiary);
}

/* ========== 数据概览 ========== */
.stats-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 24rpx 24rpx;
}

.stats-cell {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
}

.stats-num {
  font-size: var(--font-2xl);
  font-weight: 700;
  color: var(--primary);
}

.stats-label {
  font-size: var(--font-sm);
  color: var(--text-tertiary);
  margin-top: 6rpx;
}

/* ========== 友情链接 ========== */
.friend-link-list {
  padding: 0 24rpx;
}

.friend-link-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F8F8F8;
  transition: background 0.2s ease;
}

.friend-link-item:last-child {
  border-bottom: none;
}

.friend-link-item-hover {
  background: #FAFAFA;
}

.friend-link-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.friend-link-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.friend-link-name {
  font-size: var(--font-normal);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.friend-link-desc {
  font-size: var(--font-sm);
  color: var(--text-tertiary);
  line-height: 1.4;
}

.friend-link-arrow {
  font-size: var(--font-xl);
  color: var(--text-quaternary);
  margin-left: 12rpx;
  flex-shrink: 0;
}

/* ========== 底部 ========== */
.footer {
  text-align: center;
  padding: 32rpx 0 16rpx;
}

.footer-version {
  font-size: var(--font-sm);
  color: var(--text-quaternary);
  display: block;
  margin-bottom: 8rpx;
}

.footer-copyright {
  font-size: var(--font-xs);
  color: #DDDDDD;
  display: block;
}

/* ========== 常用功能宫格 ========== */
.quick-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 8rpx 24rpx 16rpx;
}

.quick-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
  transition: opacity 0.2s;
}

.quick-item-hover {
  opacity: 0.6;
}

.quick-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 22rpx;
  margin-bottom: 12rpx;
}

.quick-name {
  font-size: var(--font-base);
  color: var(--text-primary);
  font-weight: 500;
  margin-bottom: 4rpx;
}

.quick-desc {
  font-size: var(--font-xs);
  color: var(--text-tertiary);
  line-height: 1.3;
  text-align: center;
  max-width: 100%;
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
