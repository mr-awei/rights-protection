/* pages/general-template/general-template.wxss */
.container {
  min-height: 100vh;
  background: var(--bg-page);
}

/* ========== 渐变头部 ========== */
.gradient-header {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 50%, #2E6DB4 100%);
  padding: 20rpx 0 28rpx;
  position: relative;
  overflow: hidden;
}

.gradient-header::before {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -30rpx;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.12) 0%, transparent 70%);
  border-radius: 50%;
}

.header-content {
  position: relative;
  z-index: 1;
  padding: 0 32rpx;
}

.header-top {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.header-icon {
  margin-right: 16rpx;
  flex-shrink: 0;
}

.header-title {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text-inverse);
  line-height: 1.2;
  flex: 1;
}

.header-desc {
  font-size: var(--font-sm);
  color: rgba(255,255,255,0.85);
  line-height: 1.3;
  padding-left: 72rpx;
}

.copy-all-btn {
  background: rgba(255,255,255,0.2);
  backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255,255,255,0.3);
  border-radius: 16rpx;
  padding: 10rpx 20rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.copy-all-btn-hover {
  opacity: 0.8;
  transform: scale(0.98);
}

.copy-all-btn text {
  font-size: var(--font-sm);
  color: var(--text-inverse);
  font-weight: 600;
}

/* ========== 内容区 ========== */
.content {
  padding: 20rpx 24rpx 24rpx;
  margin-top: -12rpx;
  position: relative;
  z-index: 2;
}

.section {
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 8rpx 16rpx;
}

.section-num {
  width: 40rpx;
  height: 40rpx;
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: var(--text-inverse);
  font-size: var(--font-sm);
  font-weight: 700;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.section-title {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--text-primary);
  flex: 1;
}

.copy-btn {
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
  margin-left: auto;
}

.copy-btn-hover {
  opacity: 0.8;
  transform: scale(0.95);
}

.copy-btn text {
  font-size: var(--font-sm);
  color: var(--text-inverse);
  font-weight: 600;
}

/* ========== 内容卡片 ========== */
.content-card {
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.content-text {
  font-size: var(--font-md);
  color: #334155;
  line-height: 1.8;
}

/* ========== 使用说明卡片 ========== */
.tip-card {
  background: linear-gradient(135deg, #FFFBEB 0%, #FEF3C7 100%);
  border: 1rpx solid #FDE68A;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-top: 24rpx;
  margin-bottom: 40rpx;
  border-left: 6rpx solid #F59E0B;
}

.tip-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.tip-icon {
  font-size: var(--font-normal);
  margin-right: 8rpx;
}

.tip-title {
  font-size: var(--font-normal);
  font-weight: 700;
  color: #92400E;
}

.tip-content {
  display: flex;
  flex-direction: column;
}

.tip-text {
  font-size: var(--font-base);
  color: #78350F;
  line-height: 1.7;
  margin-bottom: 6rpx;
}

/* ========== 依法维权提示 ========== */
.legal-notice {
  background: linear-gradient(135deg, #FEF2F2 0%, #FEE2E2 100%);
  border: 1rpx solid #FECACA;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-top: 32rpx;
  margin-bottom: 32rpx;
  border-left: 6rpx solid #DC2626;
}

.legal-notice-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.legal-icon {
  font-size: var(--font-normal);
  margin-right: 8rpx;
}

.legal-title {
  font-size: var(--font-normal);
  font-weight: 700;
  color: #DC2626;
}

.legal-content {
  display: flex;
  flex-direction: column;
}

.legal-text {
  font-size: var(--font-base);
  color: #7F1D1D;
  line-height: 1.7;
  margin-bottom: 6rpx;
}

/* ========== 头部操作按钮 ========== */
.header-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 12rpx;
  padding-right: 8rpx;
}

.reset-btn {
  background: rgba(255,255,255,0.15);
  border: 1rpx solid rgba(255,255,255,0.3);
  border-radius: 12rpx;
  padding: 8rpx 20rpx;
}

.reset-btn-hover {
  opacity: 0.8;
  transform: scale(0.95);
}

.reset-btn text {
  font-size: var(--font-sm);
  color: var(--text-inverse);
  font-weight: 500;
}

/* ========== 填写信息区域 ========== */
.fill-section {
  background: var(--bg-card);
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.fill-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: linear-gradient(135deg, #EFF6FF 0%, #DBEAFE 100%);
}

.fill-header-hover {
  opacity: 0.9;
}

.fill-header-left {
  display: flex;
  align-items: center;
}

.fill-title {
  font-size: var(--font-normal);
  font-weight: 700;
  color: #1E40AF;
}

.fill-form {
  padding: 24rpx;
  border-top: 1rpx solid #E0E7FF;
}

.fill-form-tip {
  font-size: var(--font-base);
  color: #64748B;
  line-height: 1.6;
  margin-bottom: 20rpx;
  padding: 16rpx;
  background: #F8FAFC;
  border-radius: 12rpx;
}

.fill-form-list {
  display: flex;
  flex-direction: column;
}

.fill-form-item {
  margin-bottom: 20rpx;
}

.fill-form-label {
  font-size: var(--font-md);
  font-weight: 600;
  color: #1E293B;
  margin-bottom: 8rpx;
  display: block;
}

.fill-form-guide {
  font-size: var(--font-sm);
  color: #94A3B8;
  margin-bottom: 8rpx;
  display: block;
}

.fill-form-input {
  width: 100%;
  height: 72rpx;
  background: #F8FAFC;
  border: 1rpx solid #E2E8F0;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: var(--font-md);
  color: #1E293B;
  box-sizing: border-box;
}

.fill-placeholder {
  color: #CBD5E1;
  font-size: var(--font-base);
}

.fill-form-actions {
  display: flex;
  justify-content: space-between;
  margin-top: 24rpx;
  gap: 20rpx;
}

.fill-cancel {
  flex: 1;
  background: #F1F5F9;
  border: 1rpx solid #E2E8F0;
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: center;
}

.fill-cancel-hover {
  opacity: 0.8;
  transform: scale(0.98);
}

.fill-cancel text {
  font-size: var(--font-md);
  color: #64748B;
  font-weight: 500;
}

.fill-generate {
  flex: 2;
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: center;
}

.fill-generate-hover {
  opacity: 0.9;
  transform: scale(0.98);
}

.fill-generate text {
  font-size: var(--font-md);
  color: var(--text-inverse);
  font-weight: 600;
}

/* ========== 个性化提示 ========== */
.custom-tip {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #ECFDF5 0%, #D1FAE5 100%);
  border: 1rpx solid #A7F3D0;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  border-left: 6rpx solid #059669;
}

.custom-tip-text {
  font-size: var(--font-base);
  color: #065F46;
  line-height: 1.5;
  flex: 1;
}
