/* pages/general-template/general-template.wxss */
.container {
  min-height: 100vh;
  background: #F5F6F8;
}

/* ========== 渐变头部 ========== */
.gradient-header {
  background: linear-gradient(135deg, #8B5CF6 0%, #7C3AED 50%, #6D28D9 100%);
  padding: 0 0 40rpx;
  position: relative;
  overflow: hidden;
}

.gradient-header::before {
  content: '';
  position: absolute;
  top: -80rpx;
  right: -40rpx;
  width: 280rpx;
  height: 280rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
  border-radius: 50%;
}

.header-content {
  position: relative;
  z-index: 1;
  padding: 32rpx 32rpx 0;
}

.header-icon {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.header-desc {
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
  margin-bottom: 24rpx;
}

.copy-all-btn {
  background: rgba(255,255,255,0.2);
  backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255,255,255,0.3);
  border-radius: 20rpx;
  padding: 16rpx 24rpx;
  display: inline-block;
}

.copy-all-btn-hover {
  opacity: 0.8;
  transform: scale(0.98);
}

.copy-all-btn text {
  font-size: 26rpx;
  color: #FFFFFF;
  font-weight: 600;
}

/* ========== 内容区 ========== */
.content {
  padding: 24rpx;
  margin-top: -20rpx;
  position: relative;
  z-index: 2;
}

.section {
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  align-items: center;
  padding: 8rpx 8rpx 16rpx;
}

.section-num {
  width: 40rpx;
  height: 40rpx;
  background: linear-gradient(135deg, #8B5CF6, #7C3AED);
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 700;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
  flex: 1;
}

.copy-btn {
  background: linear-gradient(135deg, #8B5CF6, #7C3AED);
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
  margin-left: auto;
}

.copy-btn-hover {
  opacity: 0.8;
  transform: scale(0.95);
}

.copy-btn text {
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 600;
}

/* ========== 内容卡片 ========== */
.content-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.content-text {
  font-size: 26rpx;
  color: #334155;
  line-height: 1.8;
}

/* ========== 使用说明卡片 ========== */
.tip-card {
  background: linear-gradient(135deg, #FFFBEB 0%, #FEF3C7 100%);
  border: 1rpx solid #FDE68A;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  border-left: 6rpx solid #F59E0B;
}

.tip-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.tip-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.tip-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #92400E;
}

.tip-content {
  display: flex;
  flex-direction: column;
}

.tip-text {
  font-size: 24rpx;
  color: #78350F;
  line-height: 1.7;
  margin-bottom: 6rpx;
}

/* ========== 依法维权提示 ========== */
.legal-notice {
  background: linear-gradient(135deg, #FEF2F2 0%, #FEE2E2 100%);
  border: 1rpx solid #FECACA;
  border-radius: 20rpx;
  padding: 24rpx;
  border-left: 6rpx solid #DC2626;
}

.legal-notice-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.legal-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.legal-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #DC2626;
}

.legal-content {
  display: flex;
  flex-direction: column;
}

.legal-text {
  font-size: 24rpx;
  color: #7F1D1D;
  line-height: 1.7;
  margin-bottom: 6rpx;
}
