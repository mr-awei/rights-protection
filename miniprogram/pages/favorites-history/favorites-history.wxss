/* pages/favorites-history/favorites-history.wxss */
.container {
  min-height: 100vh;
  background: #F8FAFC;
}

/* ========== 自定义导航栏 ========== */
.nav-bar {
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 50%, #1D4ED8 100%);
  padding-top: var(--status-bar-height, 44px);
  height: calc(var(--status-bar-height, 44px) + 88rpx);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 24rpx;
  padding-right: 24rpx;
  position: relative;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
}

.nav-back-hover {
  background: rgba(255,255,255,0.25);
}

.nav-back-icon {
  font-size: 40rpx;
  color: #FFFFFF;
  font-weight: 300;
  line-height: 1;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.nav-placeholder {
  width: 64rpx;
}

/* ========== Tab切换 ========== */
.tab-bar {
  background: #FFFFFF;
  display: flex;
  padding: 0 24rpx;
  border-bottom: 1rpx solid #F1F5F9;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
  position: relative;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #3B82F6, #2563EB);
  border-radius: 3rpx;
}

.tab-text {
  font-size: 28rpx;
  color: #64748B;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.tab-item.active .tab-text {
  color: #1E293B;
  font-weight: 700;
}

.tab-count {
  font-size: 22rpx;
  color: #94A3B8;
  background: #F1F5F9;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
}

.tab-item.active .tab-count {
  color: #2563EB;
  background: #EFF6FF;
}

/* ========== 内容区 ========== */
.content {
  padding: 24rpx;
}

.list-container {
  min-height: 60vh;
}

.history-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}

.history-count {
  font-size: 24rpx;
  color: #94A3B8;
}

.clear-btn {
  font-size: 24rpx;
  color: #EF4444;
  padding: 8rpx 20rpx;
  background: #FEF2F2;
  border-radius: 20rpx;
}

/* ========== 列表项 ========== */
.list {
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.list-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #F8FAFC;
  transition: background 0.2s ease;
}

.list-item:last-child {
  border-bottom: none;
}

.list-item-hover {
  background: #F8FAFC;
}

.item-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  min-width: 0;
}

.item-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1E293B;
  display: block;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-meta {
  font-size: 24rpx;
  color: #94A3B8;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-remove {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #F1F5F9;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.item-remove text {
  font-size: 24rpx;
  color: #94A3B8;
}

.item-arrow {
  font-size: 36rpx;
  color: #CBD5E1;
  margin-left: 16rpx;
  flex-shrink: 0;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #64748B;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #94A3B8;
  text-align: center;
}

/* ========== 加载更多 ========== */
.load-more {
  text-align: center;
  padding: 32rpx 0;
  font-size: 24rpx;
  color: #94A3B8;
}
