/* pages/favorites-history/favorites-history.wxss */
.container {
  min-height: 100vh;
  background: #F5F5F5;
}

/* ========== 自定义导航栏 ========== */
.nav-bar {
  background: linear-gradient(135deg, #5B9BD5 0%, #4A90D9 35%, #3A7BC8 65%, #2E6BB8 100%);
  padding-top: var(--status-bar-height, 44px);
  height: calc(var(--status-bar-height, 44px) + 96rpx);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 24rpx;
  padding-right: 24rpx;
  position: relative;
  overflow: hidden;
}

.nav-bar::before {
  content: '';
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 240rpx;
  height: 240rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.2) 0%, transparent 70%);
  border-radius: 50%;
}

.nav-back {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
  position: relative;
  z-index: 1;
  border: 1rpx solid rgba(255,255,255,0.25);
}

.nav-back-hover {
  background: rgba(255,255,255,0.3);
}

.nav-back-icon {
  font-size: 44rpx;
  color: #FFFFFF;
  font-weight: 300;
  line-height: 1;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #FFFFFF;
  position: relative;
  z-index: 1;
  letter-spacing: 1rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.nav-placeholder {
  width: 68rpx;
}

/* ========== Tab切换 ========== */
.tab-bar {
  background: #FFFFFF;
  display: flex;
  padding: 0 24rpx;
  border-bottom: 1rpx solid #F5F5F5;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 0 24rpx;
  position: relative;
  transition: all 0.25s ease;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 7rpx;
  background: linear-gradient(90deg, #4A90D9, #3A7BC8);
  border-radius: 4rpx;
}

.tab-text {
  font-size: 28rpx;
  color: #999999;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.tab-item.active .tab-text {
  color: #1A1A1A;
  font-weight: 800;
}

.tab-count {
  font-size: 22rpx;
  color: #999999;
  background: #F5F5F5;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

.tab-item.active .tab-count {
  color: #3A7BC8;
  background: #E8F3FC;
}

/* ========== 内容区 ========== */
.content {
  padding: 24rpx;
}

.list-container {
  min-height: 60vh;
}

.history-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}

.history-count {
  font-size: 24rpx;
  color: #999999;
  font-weight: 500;
}

.clear-btn {
  font-size: 24rpx;
  color: #EF4444;
  padding: 10rpx 24rpx;
  background: #FEF2F2;
  border-radius: 20rpx;
  font-weight: 600;
  border: 1rpx solid #FECACA;
}

/* ========== 列表项 ========== */
.list {
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.06);
  border: 1rpx solid #F5F5F5;
}

.list-item {
  display: flex;
  align-items: center;
  padding: 30rpx 24rpx;
  border-bottom: 1rpx solid #F5F6F8;
  transition: all 0.2s ease;
}

.list-item:last-child {
  border-bottom: none;
}

.list-item-hover {
  background: #F5F6F8;
}

.item-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  margin-right: 22rpx;
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  min-width: 0;
}

.item-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
  display: block;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-meta {
  font-size: 24rpx;
  color: #999999;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 500;
}

.item-remove {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #F5F5F5;
  margin-left: 20rpx;
  flex-shrink: 0;
}

.item-remove text {
  font-size: 26rpx;
  color: #999999;
  font-weight: 700;
}

.item-arrow {
  font-size: 36rpx;
  color: #CCCCCC;
  margin-left: 16rpx;
  flex-shrink: 0;
  font-weight: 700;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
}

.empty-icon {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #F5F6F8 0%, #E8F3FC 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  margin-bottom: 28rpx;
  border: 2rpx solid #E0E7FF;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #666666;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999999;
  text-align: center;
  line-height: 1.6;
}

/* ========== 加载更多 ========== */
.load-more {
  text-align: center;
  padding: 36rpx 0;
  font-size: 24rpx;
  color: #999999;
  font-weight: 500;
}
