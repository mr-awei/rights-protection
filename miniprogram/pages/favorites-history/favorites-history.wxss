/* pages/favorites-history/favorites-history.wxss */
.container {
  min-height: 100vh;
  background: var(--border-light);
}

/* ========== 自定义导航栏 ========== */
.nav-bar {
  background: linear-gradient(135deg, var(--primary-light) 0%, var(--primary) 35%, var(--primary-dark) 65%, #2E6BB8 100%);
  padding-top: var(--status-bar-height, 44px);
  height: calc(var(--status-bar-height, 44px) + 96rpx);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 24rpx;
  padding-right: 24rpx;
  position: relative;
  overflow: hidden;
}

.nav-bar::before {
  content: '';
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 240rpx;
  height: 240rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.2) 0%, transparent 70%);
  border-radius: 50%;
}

.nav-back {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
  position: relative;
  z-index: 1;
  border: 1rpx solid rgba(255,255,255,0.25);
}

.nav-back-hover {
  background: rgba(255,255,255,0.3);
}

.nav-back-icon {
  font-size: 44rpx;
  color: var(--text-inverse);
  font-weight: 300;
  line-height: 1;
}

.nav-title {
  font-size: var(--font-2xl);
  font-weight: 800;
  color: var(--text-inverse);
  position: relative;
  z-index: 1;
  letter-spacing: 1rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.nav-placeholder {
  width: 68rpx;
}

/* ========== Tab切换 ========== */
.tab-bar {
  background: var(--bg-card);
  display: flex;
  padding: 0 24rpx;
  border-bottom: 1rpx solid var(--border-light);
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 0 24rpx;
  position: relative;
  transition: all 0.25s ease;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 7rpx;
  background: linear-gradient(90deg, var(--primary), var(--primary-dark));
  border-radius: 4rpx;
}

.tab-text {
  font-size: var(--font-normal);
  color: var(--text-tertiary);
  font-weight: 600;
  margin-bottom: 6rpx;
}

.tab-item.active .tab-text {
  color: var(--text-primary);
  font-weight: 800;
}

/* 收藏分组标签栏 */
.group-bar {
  background: var(--bg-card);
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}

.group-scroll {
  white-space: nowrap;
}

.group-list {
  display: inline-flex;
  align-items: center;
  padding: 0 24rpx;
  gap: 16rpx;
}

.group-item {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 24rpx;
  border-radius: 32rpx;
  background: var(--bg-page);
  font-size: var(--font-base);
  color: var(--text-secondary);
  font-weight: 500;
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.group-item.active {
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: var(--text-inverse);
  font-weight: 600;
}

.group-add {
  background: var(--primary-bg);
  color: var(--primary);
  border: 1rpx dashed var(--primary);
}

.tab-count {
  font-size: var(--font-sm);
  color: var(--text-tertiary);
  background: var(--border-light);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

.tab-item.active .tab-count {
  color: var(--primary-dark);
  background: var(--primary-bg);
}

/* ========== 内容区 ========== */
.content {
  padding: 24rpx;
}

.list-container {
  min-height: 60vh;
}

.history-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}

.history-count {
  font-size: var(--font-base);
  color: var(--text-tertiary);
  font-weight: 500;
}

.clear-btn {
  font-size: var(--font-base);
  color: #EF4444;
  padding: 10rpx 24rpx;
  background: #FEF2F2;
  border-radius: 20rpx;
  font-weight: 600;
  border: 1rpx solid #FECACA;
}

/* ========== 列表项 ========== */
.list {
  background: var(--bg-card);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.06);
  border: 1rpx solid var(--border-light);
}

.list-item {
  display: flex;
  align-items: center;
  padding: 30rpx 24rpx;
  border-bottom: 1rpx solid var(--bg-page);
  transition: all 0.2s ease;
}

.list-item:last-child {
  border-bottom: none;
}

.list-item-hover {
  background: var(--bg-page);
}

.item-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  margin-right: 22rpx;
  flex-shrink: 0;
}

.icon-text {
  font-size: var(--font-xl);
  font-weight: 600;
  line-height: 1;
}

.item-info {
  flex: 1;
  min-width: 0;
}

.item-name {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-meta {
  font-size: var(--font-base);
  color: var(--text-tertiary);
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 500;
}

.item-remove {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--border-light);
  margin-left: 20rpx;
  flex-shrink: 0;
}

.item-remove text {
  font-size: var(--font-md);
  color: var(--text-tertiary);
  font-weight: 700;
}

.item-arrow {
  font-size: var(--font-2xl);
  color: var(--text-quaternary);
  margin-left: 16rpx;
  flex-shrink: 0;
  font-weight: 700;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
}

.empty-icon {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--bg-page) 0%, var(--primary-bg) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  margin-bottom: 28rpx;
  border: 2rpx solid #E0E7FF;
}

.empty-title {
  font-size: var(--font-xl);
  font-weight: 800;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: var(--font-md);
  color: var(--text-tertiary);
  text-align: center;
  line-height: 1.6;
}

/* ========== 加载更多 ========== */
.load-more {
  text-align: center;
  padding: 36rpx 0;
  font-size: var(--font-base);
  color: var(--text-tertiary);
  font-weight: 500;
}

/* ========== 分组管理 ========== */
.group-manage {
  background: #F0F0F0;
  color: #666;
}
.group-manage.active {
  background: #4A90D9;
  color: var(--text-inverse);
}

/* ========== 批量操作栏 ========== */
.batch-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: var(--bg-card);
  border-bottom: 1rpx solid #F0F0F0;
}
.batch-info text {
  font-size: var(--font-md);
  color: #333;
  font-weight: 500;
}
.batch-actions {
  display: flex;
  gap: 16rpx;
}
.batch-btn {
  padding: 12rpx 24rpx;
  background: var(--border-light);
  border-radius: 10rpx;
}
.batch-btn text {
  font-size: var(--font-base);
  color: #666;
}
.batch-btn.primary {
  background: #EFF6FF;
}
.batch-btn.primary text {
  color: #4A90D9;
}
.batch-btn.danger {
  background: #FEF2F2;
}
.batch-btn.danger text {
  color: #EF4444;
}
.batch-btn-hover {
  opacity: 0.7;
}

/* ========== 列表项选择框 ========== */
.item-checkbox {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #D9D9D9;
  border-radius: 50%;
  background: var(--bg-card);
  transition: all 0.2s ease;
}
.checkbox.checked {
  background: #4A90D9;
  border-color: #4A90D9;
  position: relative;
}
.checkbox.checked::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -60%) rotate(45deg);
  width: 10rpx;
  height: 18rpx;
  border-right: 3rpx solid #FFFFFF;
  border-bottom: 3rpx solid #FFFFFF;
}
.list-item.selected {
  background: #F0F7FF;
}
