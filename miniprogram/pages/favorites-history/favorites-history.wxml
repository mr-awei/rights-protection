<!--pages/favorites-history/favorites-history.wxml-->
<view class="container {{themeClass}}" style="--status-bar-height: {{statusBarHeight}}px;">
  <!-- 自定义导航栏 -->
  <view class="nav-bar">
    <view class="nav-back" bindtap="onBack" hover-class="nav-back-hover">
      <text class="nav-back-icon">‹</text>
    </view>
    <view class="nav-title">我的收藏与历史</view>
    <view class="nav-placeholder"></view>
  </view>

  <!-- Tab切换 -->
  <view class="tab-bar">
    <view
      class="tab-item {{activeTab === 'channels' ? 'active' : ''}}"
      data-tab="channels"
      bindtap="onTabTap"
    >
      <text class="tab-text">收藏渠道</text>
      <text class="tab-count">{{channelTotal}}</text>
    </view>
    <view
      class="tab-item {{activeTab === 'scripts' ? 'active' : ''}}"
      data-tab="scripts"
      bindtap="onTabTap"
    >
      <text class="tab-text">收藏话术</text>
      <text class="tab-count">{{scriptTotal}}</text>
    </view>
    <view
      class="tab-item {{activeTab === 'history' ? 'active' : ''}}"
      data-tab="history"
      bindtap="onTabTap"
    >
      <text class="tab-text">浏览历史</text>
      <text class="tab-count">{{historyTotal}}</text>
    </view>
  </view>

  <!-- 收藏分组标签栏（仅收藏渠道/话术tab显示） -->
  <view class="group-bar" wx:if="{{activeTab !== 'history'}}">
    <scroll-view scroll-x class="group-scroll" enhanced show-scrollbar="{{false}}">
      <view class="group-list">
        <view
          class="group-item {{activeGroup === 'all' ? 'active' : ''}}"
          data-group="all"
          bindtap="onGroupTap"
        >
          <text>全部</text>
        </view>
        <view
          class="group-item {{activeGroup === item.id ? 'active' : ''}}"
          wx:for="{{groups}}"
          wx:key="id"
          data-group="{{item.id}}"
          data-index="{{index}}"
          bindtap="onGroupTap"
          bindlongpress="onGroupLongPress"
        >
          <text>{{item.name}}</text>
        </view>
        <view class="group-item group-add" bindtap="onCreateGroup">
          <text>+ 新建</text>
        </view>
        <view class="group-item group-manage" bindtap="onToggleBatchMode" wx:if="{{!isBatchMode}}">
          <text>管理</text>
        </view>
        <view class="group-item group-manage active" bindtap="onToggleBatchMode" wx:else>
          <text>完成</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 批量操作栏 -->
  <view class="batch-bar" wx:if="{{isBatchMode && activeTab !== 'history'}}">
    <view class="batch-info">
      <text>已选 {{selectedItems.length}} 项</text>
    </view>
    <view class="batch-actions">
      <view class="batch-btn" bindtap="onSelectAll" hover-class="batch-btn-hover">
        <text>{{isAllSelected ? '取消全选' : '全选'}}</text>
      </view>
      <view class="batch-btn primary" bindtap="onMoveToGroup" hover-class="batch-btn-hover">
        <text>移动分组</text>
      </view>
      <view class="batch-btn danger" bindtap="onBatchRemove" hover-class="batch-btn-hover">
        <text>删除</text>
      </view>
    </view>
  </view>

  <!-- 内容区 -->
  <view class="content">
    <!-- 收藏渠道列表 -->
    <view class="list-container" wx:if="{{activeTab === 'channels'}}">
      <view class="list" wx:if="{{channelList.length > 0}}">
        <view
          class="list-item {{isBatchMode && selectedItems.indexOf('channel:' + item.id) > -1 ? 'selected' : ''}}"
          wx:for="{{channelList}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="{{isBatchMode ? 'onToggleSelect' : 'onChannelTap'}}"
          bindtouchstart="onTouchStart"
          bindtouchend="onTouchEnd"
          hover-class="list-item-hover"
        >
          <view class="item-checkbox" wx:if="{{isBatchMode}}">
            <view class="checkbox {{selectedItems.indexOf('channel:' + item.id) > -1 ? 'checked' : ''}}"></view>
          </view>
          <view class="item-icon app-icon app-icon-default icon-channel" style="--icon-bg: #EFF6FF; --icon-color: #3B82F6;"></view>
          <view class="item-info">
            <text class="item-name">{{item.name}}</text>
            <text class="item-meta" wx:if="{{item.phone}}"> {{item.phone}}</text>
            <text class="item-meta" wx:else>{{item.category}}</text>
          </view>
          <view class="item-remove" catchtap="onRemoveChannel" data-id="{{item.id}}" wx:if="{{!isBatchMode}}">
            <view class="app-icon app-icon-default icon-close" style="width:24rpx;height:24rpx;--icon-bg:transparent;--icon-color:#999;"></view>
          </view>
        </view>
      </view>

      <!-- 空状态 -->
      <view class="empty-state" wx:if="{{channelList.length === 0}}">
        <view class="empty-icon"></view>
        <view class="empty-title">还没有收藏渠道</view>
        <view class="empty-desc">看到有用的渠道就点收藏吧</view>
      </view>

      <!-- 加载更多 -->
      <view class="load-more" wx:if="{{channelList.length > 0}}">
        <text wx:if="{{channelHasMore && !loading}}">上拉加载更多</text>
        <text wx:if="{{!channelHasMore}}">— 已经到底啦 —</text>
        <text wx:if="{{loading}}">加载中...</text>
      </view>
    </view>

    <!-- 收藏话术列表 -->
    <view class="list-container" wx:if="{{activeTab === 'scripts'}}">
      <view class="list" wx:if="{{scriptList.length > 0}}">
        <view
          class="list-item {{isBatchMode && selectedItems.indexOf('script:' + item.id) > -1 ? 'selected' : ''}}"
          wx:for="{{scriptList}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="{{isBatchMode ? 'onToggleSelect' : 'onScriptTap'}}"
          bindtouchstart="onTouchStart"
          bindtouchend="onTouchEnd"
          hover-class="list-item-hover"
        >
          <view class="item-checkbox" wx:if="{{isBatchMode}}">
            <view class="checkbox {{selectedItems.indexOf('script:' + item.id) > -1 ? 'checked' : ''}}"></view>
          </view>
          <view class="item-icon app-icon app-icon-default icon-doc" style="--icon-bg: #F0FDF4; --icon-color: #10B981;"></view>
          <view class="item-info">
            <text class="item-name">{{item.name}}</text>
            <text class="item-meta">{{item.applicable || '投诉话术'}}</text>
          </view>
          <view class="item-remove" catchtap="onRemoveScript" data-id="{{item.id}}" wx:if="{{!isBatchMode}}">
            <view class="app-icon app-icon-default icon-close" style="width:24rpx;height:24rpx;--icon-bg:transparent;--icon-color:#999;"></view>
          </view>
        </view>
      </view>

      <!-- 空状态 -->
      <view class="empty-state" wx:if="{{scriptList.length === 0}}">
        <view class="empty-icon"></view>
        <view class="empty-title">还没有收藏话术</view>
        <view class="empty-desc">看到有用的话术就点收藏吧</view>
      </view>

      <!-- 加载更多 -->
      <view class="load-more" wx:if="{{scriptList.length > 0}}">
        <text wx:if="{{scriptHasMore && !loading}}">上拉加载更多</text>
        <text wx:if="{{!scriptHasMore}}">— 已经到底啦 —</text>
        <text wx:if="{{loading}}">加载中...</text>
      </view>
    </view>

    <!-- 浏览历史列表 -->
    <view class="list-container" wx:if="{{activeTab === 'history'}}">
      <view class="history-header" wx:if="{{historyList.length > 0}}">
        <text class="history-count">共 {{historyTotal}} 条浏览记录</text>
        <view class="clear-btn" bindtap="onClearHistory">
          <text>清空历史</text>
        </view>
      </view>

      <view class="list" wx:if="{{historyList.length > 0}}">
        <view
          class="list-item"
          wx:for="{{historyList}}"
          wx:key="item_id"
          data-item="{{item}}"
          bindtap="onHistoryTap"
          bindtouchstart="onTouchStart"
          bindtouchend="onTouchEnd"
          hover-class="list-item-hover"
        >
          <view class="item-icon app-icon app-icon-default {{item.item_type === 'channel' ? 'icon-channel' : 'icon-doc'}}" style="--icon-bg: {{item.typeColor}}15; --icon-color: {{item.typeColor}}; --icon-hover-bg: {{item.typeColor}};"></view>
          <view class="item-info">
            <text class="item-name">{{item.item_name}}</text>
            <text class="item-meta">{{item.typeLabel}} · {{item.timeStr}}</text>
          </view>
          <view class="item-remove" catchtap="onRemoveHistory" data-item="{{item}}">
            <view class="app-icon app-icon-default icon-close" style="width:24rpx;height:24rpx;--icon-bg:transparent;--icon-color:#999;"></view>
          </view>
        </view>
      </view>

      <!-- 空状态 -->
      <view class="empty-state" wx:if="{{historyList.length === 0}}">
        <view class="empty-icon"></view>
        <view class="empty-title">还没有浏览记录</view>
        <view class="empty-desc">去看看有哪些投诉渠道吧</view>
      </view>

      <!-- 加载更多 -->
      <view class="load-more" wx:if="{{historyList.length > 0}}">
        <text wx:if="{{historyHasMore && !loading}}">上拉加载更多</text>
        <text wx:if="{{!historyHasMore}}">— 已经到底啦 —</text>
        <text wx:if="{{loading}}">加载中...</text>
      </view>
    </view>
  </view>

  <!-- 自定义弹窗 -->
  <custom-modal
    visible="{{modalVisible}}"
    type="{{modalType}}"
    title="{{modalTitle}}"
    content="{{modalContent}}"
    confirmText="{{modalConfirmText}}"
    cancelText="{{modalCancelText}}"
    showCancel="{{modalShowCancel}}"
    placeholder="{{modalPlaceholder}}"
    defaultValue="{{modalDefaultValue}}"
    itemList="{{modalItemList}}"
    bind:confirm="onModalConfirm"
    bind:cancel="onModalCancel"
    bind:select="onModalSelect"
  />
</view>
