/* pages/followup-schedule/followup-schedule.wxss */
.container {
  min-height: 100vh;
  background: #F5F6F8;
}

.gradient-header {
  background: linear-gradient(135deg, #06B6D4 0%, #0891B2 50%, #0E7490 100%);
  padding: 0 0 40rpx;
  position: relative;
  overflow: hidden;
}

.gradient-header::before {
  content: '';
  position: absolute;
  top: -80rpx;
  right: -40rpx;
  width: 280rpx;
  height: 280rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
  border-radius: 50%;
}

.header-content {
  position: relative;
  z-index: 1;
  padding: 32rpx 32rpx 0;
}

.header-icon {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.header-desc {
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
}

.content {
  padding: 24rpx;
  margin-top: -20rpx;
  position: relative;
  z-index: 2;
}

/* 时间线 */
.timeline {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.timeline-item {
  display: flex;
  position: relative;
  padding-bottom: 24rpx;
  transition: all 0.2s ease;
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.timeline-item-hover {
  opacity: 0.8;
}

.timeline-dot {
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
  position: relative;
  z-index: 2;
}

.dot-inner {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  border: 4rpx solid #FFFFFF;
  box-shadow: 0 0 0 2rpx currentColor;
}

.timeline-line {
  position: absolute;
  left: 15rpx;
  top: 32rpx;
  bottom: 0;
  width: 2rpx;
  background: #EEEEEE;
}

.timeline-content {
  flex: 1;
  min-width: 0;
}

.timeline-time {
  font-size: 22rpx;
  color: #06B6D4;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.timeline-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 6rpx;
}

.timeline-desc {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.timeline-action {
  background: #F0FDFA;
  border-radius: 8rpx;
  padding: 10rpx 14rpx;
  margin-top: 4rpx;
}

.action-label {
  font-size: 22rpx;
  color: #0E7490;
  font-weight: 600;
}

.action-text {
  font-size: 22rpx;
  color: #155E75;
}

/* 提示卡片 */
.tip-card {
  display: flex;
  align-items: flex-start;
  background: linear-gradient(135deg, #ECFEFF 0%, #CFFAFE 100%);
  border: 1rpx solid #A5F3FC;
  border-radius: 16rpx;
  padding: 20rpx;
}

.tip-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.tip-text {
  flex: 1;
  font-size: 24rpx;
  color: #155E75;
  line-height: 1.7;
}
