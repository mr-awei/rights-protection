/* pages/search/search.wxss */
.container {
  min-height: 100vh;
  background: var(--bg-page);
}

/* 自定义导航栏 */
.nav-bar {
  background: linear-gradient(135deg, var(--primary-light) 0%, var(--primary) 50%, var(--primary-dark) 100%);
  padding-top: calc(var(--status-bar-height, 44px) + 88rpx);
  padding-bottom: 20rpx;
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-content {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  gap: 12rpx;
}

.back-btn {
  width: 56rpx;
  height: 56rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.back-icon {
  font-size: var(--font-3xl);
  color: var(--text-inverse);
  font-weight: 500;
  line-height: 1;
  margin-left: -4rpx;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border-radius: 24rpx;
  padding: 12rpx 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.search-icon {
  font-size: var(--font-normal);
  margin-right: 12rpx;
  opacity: 0.6;
}

.search-input {
  flex: 1;
  font-size: var(--font-normal);
  color: var(--text-primary);
  height: 48rpx;
}

.search-placeholder {
  color: var(--text-tertiary);
  font-size: var(--font-md);
}

.clear-btn {
  width: 36rpx;
  height: 36rpx;
  background: var(--border);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 12rpx;
}

.clear-btn text {
  font-size: var(--font-xs);
  color: var(--text-secondary);
  font-weight: 600;
}

/* 联想建议列表 */
.suggestion-list {
  background: var(--bg-card);
  min-height: calc(100vh - 120rpx);
}

.suggestion-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid var(--border-light);
  transition: all 0.2s ease;
}

.suggestion-item-hover {
  background: var(--bg-page);
}

.suggestion-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.suggestion-icon-channel {
  --icon-bg: #E6F4FF;
  --icon-color: var(--info);
}

.suggestion-icon-script {
  --icon-bg: #E8F8EF;
  --icon-color: var(--success);
}

.suggestion-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.suggestion-name {
  font-size: var(--font-normal);
  color: var(--text-primary);
  font-weight: 500;
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.suggestion-type {
  font-size: var(--font-sm);
  color: var(--text-tertiary);
}

.suggestion-arrow {
  font-size: var(--font-xl);
  color: var(--text-quaternary);
  margin-left: 12rpx;
}

.empty-suggestion {
  padding: 80rpx 24rpx;
  text-align: center;
}

.empty-suggestion text {
  font-size: var(--font-md);
  color: var(--text-tertiary);
}

/* 内容区 */
.content {
  padding: 24rpx;
}

.section {
  margin-bottom: 32rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--text-primary);
}

.clear-history {
  margin-left: auto;
  padding: 6rpx 16rpx;
  background: var(--border-light);
  border-radius: 12rpx;
}

.clear-history text {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

/* 搜索历史标签 */
.history-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.history-tag {
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  padding: 12rpx 16rpx 12rpx 20rpx;
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.02);
  transition: all 0.2s ease;
}

.history-tag-hover {
  background: var(--primary-bg);
  border-color: #93C5FD;
}

.tag-text {
  font-size: var(--font-md);
  color: var(--text-secondary);
}

.tag-delete {
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 8rpx;
}

.tag-delete text {
  font-size: var(--font-xs);
  color: var(--text-tertiary);
}

/* 热门搜索标签 */
.hot-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.hot-tag {
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  padding: 14rpx 24rpx;
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.02);
  transition: all 0.2s ease;
}

.hot-tag-hover {
  background: #FEF2F2;
  border-color: #FCA5A5;
}

.hot-rank {
  font-size: var(--font-base);
  font-weight: 800;
  color: #EF4444;
  margin-right: 8rpx;
  width: 28rpx;
  text-align: center;
}

.hot-text {
  font-size: var(--font-md);
  color: var(--text-secondary);
}

/* 搜索技巧卡片 */
.tip-card {
  background: linear-gradient(135deg, var(--primary-bg) 0%, var(--primary-bg) 100%);
  border: 1rpx solid #B8D4F0;
  border-radius: 20rpx;
  padding: 24rpx;
  border-left: 6rpx solid var(--primary);
}

.tip-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.tip-icon {
  font-size: var(--font-normal);
  margin-right: 8rpx;
}

.tip-title {
  font-size: var(--font-normal);
  font-weight: 700;
  color: #2E6BB8;
}

.tip-content {
  display: flex;
  flex-direction: column;
}

.tip-text {
  font-size: var(--font-base);
  color: #1E3A8A;
  line-height: 1.7;
  margin-bottom: 6rpx;
}
