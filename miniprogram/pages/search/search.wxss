/* pages/search/search.wxss */
.container {
  min-height: 100vh;
  background: #F5F6F8;
}

/* 自定义导航栏 */
.nav-bar {
  background: linear-gradient(135deg, #5B9BD5 0%, #4A90D9 50%, #3A7BC8 100%);
  padding-top: calc(var(--status-bar-height, 44px) + 88rpx);
  padding-bottom: 20rpx;
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-content {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  gap: 12rpx;
}

.back-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.back-icon {
  font-size: 48rpx;
  color: #FFFFFF;
  font-weight: 300;
  line-height: 1;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 12rpx 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  opacity: 0.6;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1A1A1A;
  height: 48rpx;
}

.search-placeholder {
  color: #999999;
  font-size: 26rpx;
}

.clear-btn {
  width: 36rpx;
  height: 36rpx;
  background: #EEEEEE;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 12rpx;
}

.clear-btn text {
  font-size: 20rpx;
  color: #666666;
  font-weight: 600;
}

/* 联想建议列表 */
.suggestion-list {
  background: #FFFFFF;
  min-height: calc(100vh - 120rpx);
}

.suggestion-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #F5F5F5;
  transition: all 0.2s ease;
}

.suggestion-item-hover {
  background: #F5F6F8;
}

.suggestion-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.suggestion-icon-channel {
  background: #E6F4FF;
}

.suggestion-icon-script {
  background: #E8F8EF;
}

.suggestion-icon-text {
  font-size: 22rpx;
  font-weight: 600;
}

.suggestion-icon-channel .suggestion-icon-text {
  color: #1890FF;
}

.suggestion-icon-script .suggestion-icon-text {
  color: #52C41A;
}

.suggestion-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.suggestion-name {
  font-size: 28rpx;
  color: #1A1A1A;
  font-weight: 500;
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.suggestion-type {
  font-size: 22rpx;
  color: #999999;
}

.suggestion-arrow {
  font-size: 32rpx;
  color: #CCCCCC;
  margin-left: 12rpx;
}

.empty-suggestion {
  padding: 80rpx 24rpx;
  text-align: center;
}

.empty-suggestion text {
  font-size: 26rpx;
  color: #999999;
}

/* 内容区 */
.content {
  padding: 24rpx;
}

.section {
  margin-bottom: 32rpx;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.clear-history {
  margin-left: auto;
  padding: 6rpx 16rpx;
  background: #F5F5F5;
  border-radius: 12rpx;
}

.clear-history text {
  font-size: 22rpx;
  color: #666666;
}

/* 搜索历史标签 */
.history-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.history-tag {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border: 1rpx solid #EEEEEE;
  border-radius: 20rpx;
  padding: 12rpx 16rpx 12rpx 20rpx;
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.02);
  transition: all 0.2s ease;
}

.history-tag-hover {
  background: #E8F3FC;
  border-color: #93C5FD;
}

.tag-text {
  font-size: 26rpx;
  color: #666666;
}

.tag-delete {
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 8rpx;
}

.tag-delete text {
  font-size: 20rpx;
  color: #999999;
}

/* 热门搜索标签 */
.hot-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.hot-tag {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border: 1rpx solid #EEEEEE;
  border-radius: 20rpx;
  padding: 14rpx 24rpx;
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.02);
  transition: all 0.2s ease;
}

.hot-tag-hover {
  background: #FEF2F2;
  border-color: #FCA5A5;
}

.hot-rank {
  font-size: 24rpx;
  font-weight: 800;
  color: #EF4444;
  margin-right: 8rpx;
  width: 28rpx;
  text-align: center;
}

.hot-text {
  font-size: 26rpx;
  color: #666666;
}

/* 搜索技巧卡片 */
.tip-card {
  background: linear-gradient(135deg, #E8F3FC 0%, #E8F3FC 100%);
  border: 1rpx solid #B8D4F0;
  border-radius: 20rpx;
  padding: 24rpx;
  border-left: 6rpx solid #4A90D9;
}

.tip-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.tip-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.tip-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #2E6BB8;
}

.tip-content {
  display: flex;
  flex-direction: column;
}

.tip-text {
  font-size: 24rpx;
  color: #1E3A8A;
  line-height: 1.7;
  margin-bottom: 6rpx;
}
