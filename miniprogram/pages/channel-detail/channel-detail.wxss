/* pages/channel-detail/channel-detail.wxss */

/* ========== 加载状态 ========== */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  background: #F5F6F8;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #EEEEEE;
  border-top-color: #4A90D9;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #666666;
}

.container {
  min-height: 100vh;
  background: #F5F6F8;
  padding-bottom: 160rpx;
}

/* ========== 渐变头部 ========== */
.gradient-header {
  background: linear-gradient(135deg, #4A90D9 0%, #3A7BC8 50%, #2E6BB8 100%);
  padding: 0 0 40rpx;
  position: relative;
  overflow: hidden;
}

.gradient-header::before {
  content: '';
  position: absolute;
  top: -80rpx;
  right: -40rpx;
  width: 280rpx;
  height: 280rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
  border-radius: 50%;
}

.gradient-header::after {
  content: '';
  position: absolute;
  bottom: -60rpx;
  left: -40rpx;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
  border-radius: 50%;
}

.header-content {
  position: relative;
  z-index: 1;
  padding: 80rpx 32rpx 0;
}

.channel-badge {
  display: inline-flex;
  align-items: center;
  background: rgba(255,255,255,0.2);
  backdrop-filter: blur(10px);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255,255,255,0.3);
  margin-bottom: 20rpx;
}

.badge-text {
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.channel-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.4;
  margin-bottom: 16rpx;
  word-break: break-all;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.channel-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.channel-tag {
  background: rgba(255,255,255,0.18);
  backdrop-filter: blur(10px);
  color: #FFFFFF;
  font-size: 22rpx;
  padding: 8rpx 18rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(255,255,255,0.25);
}

/* ========== 内容区 ========== */
.content {
  padding: 0 24rpx;
  margin-top: 0;
  position: relative;
  z-index: 2;
}

.section {
  margin-bottom: 28rpx;
}

.section-header {
  padding: 8rpx 8rpx 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
}

/* ========== 联系方式卡片 ========== */
.contact-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 8rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.contact-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
  transition: all 0.2s ease;
}

.contact-item:last-child {
  border-bottom: none;
}

.contact-item.clickable:active {
  opacity: 0.7;
  background: #F5F6F8;
  margin: 0 -24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
}

.contact-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.contact-icon-phone {
  background: #E6F4FF;
}

.contact-icon-website {
  background: #E6FFFB;
}

.contact-icon-other {
  background: #F9F0FF;
}

.contact-icon-text {
  font-size: 24rpx;
  font-weight: 600;
}

.contact-icon-phone .contact-icon-text {
  color: #1890FF;
}

.contact-icon-website .contact-icon-text {
  color: #13C2C2;
}

.contact-icon-other .contact-icon-text {
  color: #722ED1;
}

.contact-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.contact-label {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 4rpx;
}

.contact-value {
  font-size: 28rpx;
  color: #1A1A1A;
  font-weight: 600;
  word-break: break-all;
}

.contact-arrow {
  font-size: 36rpx;
  color: #CCCCCC;
  font-weight: 300;
  margin-left: 12rpx;
}

/* ========== 通用信息卡片 ========== */
.process-card,
.info-card,
.tips-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  font-size: 26rpx;
  color: #666666;
  line-height: 1.8;
}

.tips-card {
  background: linear-gradient(135deg, #FFFBEB 0%, #FEF3C7 100%);
  border: 1rpx solid #FDE68A;
  color: #92400E;
}

/* ========== 依法维权提示卡片 ========== */
.legal-notice-card {
  background: linear-gradient(135deg, #FEF2F2 0%, #FEE2E2 100%);
  border: 1rpx solid #FECACA;
  border-radius: 20rpx;
  padding: 24rpx;
  border-left: 6rpx solid #DC2626;
}

.legal-notice-header {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.legal-notice-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.legal-notice-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #DC2626;
}

.legal-notice-content {
  padding-left: 4rpx;
}

.legal-notice-text {
  font-size: 22rpx;
  color: #7F1D1D;
  line-height: 1.7;
  display: block;
  margin-bottom: 6rpx;
}

/* ========== 法律法规列表 ========== */
.law-list {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 8rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.law-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.law-item:last-child {
  border-bottom: none;
}

.law-item-hover {
  background: #F5F6F8;
  opacity: 0.8;
}

.law-arrow {
  font-size: 32rpx;
  color: #CCCCCC;
  margin-left: 12rpx;
}

.law-icon {
  width: 56rpx;
  height: 56rpx;
  background: #F6FFED;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.law-icon-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #52C41A;
}

.law-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.law-name {
  font-size: 28rpx;
  color: #1A1A1A;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.law-desc {
  font-size: 22rpx;
  color: #999999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ========== 关联话术列表 ========== */
.script-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.script-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  border-left: 6rpx solid #4A90D9;
  transition: all 0.2s ease;
}

.script-card-hover {
  transform: scale(0.98);
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
}

.script-icon {
  width: 56rpx;
  height: 56rpx;
  background: #E8F8EF;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.script-icon-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #52C41A;
}

.script-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.script-name {
  font-size: 28rpx;
  color: #1A1A1A;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.script-meta {
  font-size: 22rpx;
  color: #999999;
}

.script-arrow {
  font-size: 36rpx;
  color: #CCCCCC;
  font-weight: 300;
}

/* ========== 底部操作栏 ========== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  background: #FFFFFF;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.08);
  z-index: 100;
}

.bottom-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 24rpx;
}

.bottom-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #F5F6F8;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 4rpx;
}

.bottom-icon-active {
  background: #FFF7E6;
}

.bottom-icon-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #666666;
}

.bottom-icon-active .bottom-icon-text {
  color: #FAAD14;
}

.bottom-label {
  font-size: 20rpx;
  color: #666666;
}

.bottom-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #4A90D9, #3A7BC8);
  border-radius: 28rpx;
  padding: 24rpx;
  margin-left: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(59,130,246,0.3);
  transition: all 0.2s ease;
}

.bottom-btn:active {
  transform: scale(0.96);
  opacity: 0.9;
}

.bottom-btn-text {
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
}

/* ========== 加载状态 ========== */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
  font-size: 28rpx;
  color: #999999;
}

/* ========== 渠道状态提示条 ========== */
.status-banner {
  border-radius: 20rpx;
  padding: 24rpx;
  border-left: 6rpx solid;
}

.status-banner.status-merged {
  background: linear-gradient(135deg, #FFFBEB 0%, #FEF3C7 100%);
  border-color: #F59E0B;
  border-left-color: #F59E0B;
}

.status-banner.status-discontinued {
  background: linear-gradient(135deg, #FEF2F2 0%, #FEE2E2 100%);
  border-color: #FECACA;
  border-left-color: #EF4444;
}

.status-banner.status-merging {
  background: linear-gradient(135deg, #FFFBEB 0%, #FEF3C7 100%);
  border-color: #FDE68A;
  border-left-color: #F59E0B;
}

.status-banner-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.status-banner-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.status-banner-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #92400E;
}

.status-discontinued .status-banner-title {
  color: #991B1B;
}

.status-banner-message {
  font-size: 24rpx;
  color: #78350F;
  line-height: 1.6;
  display: block;
  margin-bottom: 16rpx;
}

.status-discontinued .status-banner-message {
  color: #7F1D1D;
}

.status-replacement {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  transition: all 0.2s ease;
}

.status-replacement-hover {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

.status-replacement-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.status-replacement-label {
  font-size: 20rpx;
  color: #999999;
  margin-bottom: 4rpx;
}

.status-replacement-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 2rpx;
}

.status-replacement-phone {
  font-size: 22rpx;
  color: #4A90D9;
  font-weight: 500;
}

.status-replacement-arrow {
  font-size: 32rpx;
  color: #CCCCCC;
  margin-left: 12rpx;
}

/* ========== 前置条件卡片 ========== */
.precondition-card {
  background: linear-gradient(135deg, #FFFBEB 0%, #FEF3C7 100%);
  border: 1rpx solid #FDE68A;
  border-radius: 20rpx;
  padding: 24rpx;
  font-size: 26rpx;
  color: #78350F;
  line-height: 1.8;
}

/* ========== 信息来源卡片 ========== */
.source-card {
  background: #F5F6F8;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid #EEEEEE;
}

.source-text {
  font-size: 22rpx;
  color: #666666;
  line-height: 1.6;
  display: block;
  margin-bottom: 6rpx;
}

.source-tip {
  font-size: 20rpx;
  color: #999999;
  line-height: 1.5;
  display: block;
  margin-top: 8rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #EEEEEE;
}
