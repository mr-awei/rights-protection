/* pages/channel-detail/channel-detail.wxss */
.container {
  min-height: 100vh;
  background: #F8FAFC;
  padding-bottom: 160rpx;
}

/* ========== 渐变头部 ========== */
.gradient-header {
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 50%, #1D4ED8 100%);
  padding: 0 0 48rpx;
  position: relative;
  overflow: hidden;
}

.gradient-header::before {
  content: '';
  position: absolute;
  top: -80rpx;
  right: -40rpx;
  width: 280rpx;
  height: 280rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
  border-radius: 50%;
}

.gradient-header::after {
  content: '';
  position: absolute;
  bottom: -60rpx;
  left: -40rpx;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
  border-radius: 50%;
}

.header-content {
  position: relative;
  z-index: 1;
  padding: 48rpx 32rpx 0;
}

.channel-badge {
  display: inline-flex;
  align-items: center;
  background: rgba(255,255,255,0.2);
  backdrop-filter: blur(10px);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255,255,255,0.3);
  margin-bottom: 20rpx;
}

.badge-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.badge-text {
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.channel-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #FFFFFF;
  line-height: 1.4;
  margin-bottom: 20rpx;
}

.channel-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.channel-tag {
  background: rgba(255,255,255,0.18);
  backdrop-filter: blur(10px);
  color: #FFFFFF;
  font-size: 22rpx;
  padding: 8rpx 18rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(255,255,255,0.25);
}

/* ========== 内容区 ========== */
.content {
  padding: 0 24rpx;
  margin-top: -24rpx;
  position: relative;
  z-index: 2;
}

.section {
  margin-bottom: 28rpx;
}

.section-header {
  padding: 8rpx 8rpx 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1E293B;
}

/* ========== 联系方式卡片 ========== */
.contact-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 8rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.contact-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F1F5F9;
  transition: all 0.2s ease;
}

.contact-item:last-child {
  border-bottom: none;
}

.contact-item.clickable:active {
  opacity: 0.7;
  background: #F8FAFC;
  margin: 0 -24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
}

.contact-icon {
  width: 64rpx;
  height: 64rpx;
  background: linear-gradient(135deg, #EFF6FF, #DBEAFE);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.contact-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.contact-label {
  font-size: 24rpx;
  color: #94A3B8;
  margin-bottom: 4rpx;
}

.contact-value {
  font-size: 28rpx;
  color: #1E293B;
  font-weight: 600;
  word-break: break-all;
}

.contact-arrow {
  font-size: 36rpx;
  color: #CBD5E1;
  font-weight: 300;
  margin-left: 12rpx;
}

/* ========== 通用信息卡片 ========== */
.process-card,
.info-card,
.tips-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  font-size: 26rpx;
  color: #475569;
  line-height: 1.8;
}

.tips-card {
  background: linear-gradient(135deg, #FFFBEB 0%, #FEF3C7 100%);
  border: 1rpx solid #FDE68A;
  color: #92400E;
}

/* ========== 法律法规列表 ========== */
.law-list {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 8rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.law-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F1F5F9;
}

.law-item:last-child {
  border-bottom: none;
}

.law-icon {
  width: 64rpx;
  height: 64rpx;
  background: linear-gradient(135deg, #F0FDF4, #DCFCE7);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.law-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.law-name {
  font-size: 28rpx;
  color: #1E293B;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.law-desc {
  font-size: 22rpx;
  color: #94A3B8;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ========== 关联话术列表 ========== */
.script-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.script-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  border-left: 6rpx solid #3B82F6;
  transition: all 0.2s ease;
}

.script-card-hover {
  transform: scale(0.98);
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
}

.script-icon {
  width: 64rpx;
  height: 64rpx;
  background: linear-gradient(135deg, #EFF6FF, #DBEAFE);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.script-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.script-name {
  font-size: 28rpx;
  color: #1E293B;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.script-meta {
  font-size: 22rpx;
  color: #94A3B8;
}

.script-arrow {
  font-size: 36rpx;
  color: #CBD5E1;
  font-weight: 300;
}

/* ========== 底部操作栏 ========== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  background: #FFFFFF;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.08);
  z-index: 100;
}

.bottom-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 24rpx;
}

.bottom-icon {
  font-size: 40rpx;
  margin-bottom: 4rpx;
}

.bottom-label {
  font-size: 20rpx;
  color: #64748B;
}

.bottom-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #3B82F6, #2563EB);
  border-radius: 28rpx;
  padding: 24rpx;
  margin-left: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(59,130,246,0.3);
  transition: all 0.2s ease;
}

.bottom-btn:active {
  transform: scale(0.96);
  opacity: 0.9;
}

.bottom-btn-icon {
  font-size: 32rpx;
  margin-right: 10rpx;
}

.bottom-btn-text {
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
}

/* ========== 加载状态 ========== */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
  font-size: 28rpx;
  color: #94A3B8;
}
