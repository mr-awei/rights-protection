<!--pages/channel-detail/channel-detail.wxml-->
<!-- 加载状态 -->
<view class="loading-container" wx:if="{{loading}}">
  <view class="loading-spinner"></view>
  <text class="loading-text">加载中...</text>
</view>

<view class="container" wx:if="{{channel && !loading}}">
  <!-- 渐变头部 -->
  <view class="gradient-header">
    <view class="header-content">
      <view class="channel-badge">
        <text class="badge-text">官方渠道</text>
      </view>
      <text class="channel-title">{{channel.name}}</text>
      <view class="channel-tags" wx:if="{{channel.tags && channel.tags.length > 0}}">
        <text class="channel-tag" wx:for="{{channel.tags}}" wx:key="*this" wx:for-item="tag">{{tag}}</text>
      </view>
    </view>
  </view>

  <!-- 内容区 -->
  <view class="content">
    <!-- 已整合/停用渠道提示条 -->
    <view class="section" wx:if="{{statusInfo}}">
      <view class="status-banner status-{{statusInfo.type}}">
        <view class="status-banner-header">
          <text class="status-banner-title">{{statusInfo.title}}</text>
        </view>
        <text class="status-banner-message">{{statusInfo.message}}</text>
        <view class="status-replacement" wx:if="{{statusInfo.replacementName}}" bindtap="onReplacementTap" hover-class="status-replacement-hover">
          <view class="status-replacement-info">
            <text class="status-replacement-label">推荐替代渠道：</text>
            <text class="status-replacement-name">{{statusInfo.replacementName}}</text>
            <text class="status-replacement-phone" wx:if="{{statusInfo.replacementPhone}}"> {{statusInfo.replacementPhone}}</text>
          </view>
          <text class="status-replacement-arrow">›</text>
        </view>
      </view>
    </view>

    <!-- 联系方式卡片 -->
    <view class="section" wx:if="{{contactItems.length > 0}}">
      <view class="section-header">
        <text class="section-title">联系方式</text>
      </view>
      <view class="contact-card">
        <view
          class="contact-item {{item.action ? 'clickable' : ''}}"
          wx:for="{{contactItems}}"
          wx:key="label"
          data-item="{{item}}"
          bindtap="onContactAction"
        >
          <view class="contact-icon contact-icon-{{item.type}}">
            <text class="contact-icon-text">{{item.type === 'phone' ? '电' : item.type === 'website' ? '网' : '管'}}</text>
          </view>
          <view class="contact-info">
            <text class="contact-label">{{item.label}}</text>
            <text class="contact-value">{{item.value}}</text>
          </view>
          <text class="contact-arrow" wx:if="{{item.action}}">›</text>
        </view>
      </view>
    </view>

    <!-- 投诉流程 -->
    <view class="section" wx:if="{{channel.process || channel.complaint_process}}">
      <view class="section-header">
        <text class="section-title">投诉流程</text>
      </view>
      <view class="process-card">
        <rich-text nodes="{{channel.process || channel.complaint_process}}"></rich-text>
      </view>
    </view>

    <!-- 受理范围 -->
    <view class="section" wx:if="{{channel.scope}}">
      <view class="section-header">
        <text class="section-title">受理范围</text>
      </view>
      <view class="info-card">
        <rich-text nodes="{{channel.scope}}"></rich-text>
      </view>
    </view>

    <!-- 前置条件 -->
    <view class="section" wx:if="{{preconditionText}}">
      <view class="section-header">
        <text class="section-title">投诉前请注意</text>
      </view>
      <view class="precondition-card">
        <rich-text nodes="{{preconditionText}}"></rich-text>
      </view>
    </view>

    <!-- 法律依据 -->
    <view class="section" wx:if="{{laws.length > 0}}">
      <view class="section-header">
        <text class="section-title">相关法律法规</text>
      </view>
      <view class="law-list">
        <view class="law-item" wx:for="{{laws}}" wx:key="id" bindtap="onLawTap" data-law="{{item}}" hover-class="law-item-hover">
          <view class="law-icon">
            <text class="law-icon-text">法</text>
          </view>
          <view class="law-info">
            <text class="law-name">{{item.name}}</text>
            <text class="law-desc">{{item.description || item.article || '点击复制法律名称'}}</text>
          </view>
          <text class="law-arrow">›</text>
        </view>
      </view>
    </view>

    <!-- 关联话术 -->
    <view class="section" wx:if="{{relatedScripts.length > 0}}">
      <view class="section-header">
        <text class="section-title">关联投诉话术</text>
      </view>
      <view class="script-list">
        <view
          class="script-card"
          wx:for="{{relatedScripts}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onScriptTap"
          hover-class="script-card-hover"
        >
          <view class="script-icon">
            <text class="script-icon-text">话</text>
          </view>
          <view class="script-info">
            <text class="script-name">{{item.scene_name || item.name}}</text>
            <text class="script-meta">电话版 + 书面版</text>
          </view>
          <text class="script-arrow">›</text>
        </view>
      </view>
    </view>

    <!-- 温馨提示 -->
    <view class="section" wx:if="{{tipsText}}">
      <view class="section-header">
        <text class="section-title">温馨提示</text>
      </view>
      <view class="tips-card">
        <rich-text nodes="{{tipsText}}"></rich-text>
      </view>
    </view>

    <!-- 依法维权提示 -->
    <view class="section">
      <view class="legal-notice-card">
        <view class="legal-notice-header">
          <text class="legal-notice-title">依法维权 · 虚假举报须担责</text>
        </view>
        <view class="legal-notice-content">
          <text class="legal-notice-text">《宪法》第四十一条赋予公民申诉、控告、检举的权利，同时规定不得捏造或歪曲事实进行诬告陷害。权利与义务对等，法律保护合法维权，也绝不纵容借维权之名行违法之实。</text>
          <text class="legal-notice-text">• 报假警、谎报警情：依据《治安管理处罚法》处5-10日拘留，可并处1000元以下罚款；情节严重的触犯《刑法》编造、故意传播虚假信息罪。</text>
          <text class="legal-notice-text">• 捏造事实诬告陷害他人：依据《治安管理处罚法》处5日以下拘留或1000元以下罚款；情节严重的触犯《刑法》诬告陷害罪，最高可处10年有期徒刑。</text>
          <text class="legal-notice-text">• 建议先向企业内部投诉，约80%的常规问题在此层级即可解决，且企业投诉记录是后续向监管部门申诉的前置条件。</text>
        </view>
      </view>
    </view>

    <!-- 信息来源 -->
    <view class="section">
      <view class="source-card">
        <text class="source-text">数据验证日期：2026年8月30日</text>
        <text class="source-text">信息来源：三份维权文档整理，所有信息来源于政府官网公开渠道</text>
        <text class="source-tip">本工具为便民信息汇总，非政府官方应用，具体以各监管部门官方公布为准</text>
      </view>
    </view>

    <view style="height: 160rpx;"></view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <view class="bottom-action" bindtap="onFavoriteTap">
      <view class="bottom-icon {{isFavorite ? 'bottom-icon-active' : ''}}">
        <text class="bottom-icon-text">{{isFavorite ? '★' : '☆'}}</text>
      </view>
      <text class="bottom-label">{{isFavorite ? '已收藏' : '收藏'}}</text>
    </view>
    <view class="bottom-action" bindtap="onShareTap">
      <view class="bottom-icon">
        <text class="bottom-icon-text">享</text>
      </view>
      <text class="bottom-label">分享</text>
    </view>
    <view class="bottom-btn" wx:if="{{channel.phone}}" bindtap="onCallTap">
      <text class="bottom-btn-text">立即拨打</text>
    </view>
    <view class="bottom-btn" wx:else bindtap="onBackTap">
      <text class="bottom-btn-text">返回</text>
    </view>
  </view>
</view>

<!-- 加载状态 -->
<view class="loading" wx:else>
  <text>加载中...</text>
</view>
