/* pages/search-result/search-result.wxss */
.container {
  min-height: 100vh;
  background: #F5F6F8;
}

/* ========== 搜索框 ========== */
.search-header {
  background: linear-gradient(135deg, #5B9BD5 0%, #4A90D9 50%, #3A7BC8 100%);
  padding-top: calc(var(--status-bar-height, 44px) + 20rpx);
  padding-bottom: 20rpx;
}

.search-header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  margin-bottom: 20rpx;
}

.back-btn {
  width: 56rpx;
  height: 56rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.back-icon {
  font-size: 40rpx;
  color: #FFFFFF;
  font-weight: 500;
  line-height: 1;
  margin-left: -4rpx;
}

.search-header-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
  flex: 1;
  text-align: center;
}

.search-header-placeholder {
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
}

.search-header-content {
  padding: 0 24rpx;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 12rpx 16rpx 12rpx 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
  min-width: 0;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  opacity: 0.6;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1A1A1A;
  height: 48rpx;
}

.search-placeholder {
  color: #999999;
  font-size: 26rpx;
}

.search-btn {
  background: linear-gradient(135deg, #4A90D9, #3A7BC8);
  padding: 10rpx 24rpx;
  border-radius: 16rpx;
  margin-left: 12rpx;
}

.search-btn text {
  font-size: 26rpx;
  color: #FFFFFF;
  font-weight: 600;
}

/* ========== Tab切换 ========== */
.result-tabs {
  display: flex;
  background: #FFFFFF;
  padding: 16rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  position: sticky;
  top: 0;
  z-index: 10;
}

.result-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #666666;
  font-weight: 500;
  border-radius: 16rpx;
  transition: all 0.2s ease;
  position: relative;
}

.result-tab.active {
  color: #3A7BC8;
  font-weight: 700;
  background: #E8F3FC;
}

.result-tab.active::after {
  content: '';
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #4A90D9, #3A7BC8);
  border-radius: 3rpx;
}

/* ========== 问题类型筛选栏 ========== */
.issue-type-bar {
  width: 100%;
  background: #FFFFFF;
  border-bottom: 1rpx solid #F5F5F5;
  white-space: nowrap;
}

.issue-type-list {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 24rpx;
  gap: 12rpx;
}

.issue-type-item {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 28rpx;
  background: #F5F6F8;
  font-size: 22rpx;
  color: #666666;
  font-weight: 500;
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.issue-type-item.active {
  background: linear-gradient(135deg, #4A90D9, #3A7BC8);
  color: #FFFFFF;
  font-weight: 600;
}

/* ========== 结果数量 ========== */
.result-count {
  padding: 24rpx 32rpx 16rpx;
  font-size: 24rpx;
  color: #999999;
}

/* ========== 结果列表 ========== */
.result-list {
  padding: 0 24rpx;
}

.result-item {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  transition: all 0.2s ease;
  border-left: 6rpx solid #4A90D9;
}

.result-item:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
}

.ri-title {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.ri-type {
  font-size: 20rpx;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  font-weight: 600;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.ri-type.channel {
  background: #E8F3FC;
  color: #3A7BC8;
}

.ri-type.script {
  background: #F0FDF4;
  color: #16A34A;
}

.ri-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.ri-desc {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.6;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.ri-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex-wrap: wrap;
}

.ri-meta text {
  font-size: 22rpx;
  color: #999999;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.4;
}

.empty-title {
  font-size: 30rpx;
  color: #666666;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #999999;
  text-align: center;
  margin-bottom: 32rpx;
}

.empty-actions {
  width: 100%;
  max-width: 400rpx;
}

/* ========== 按钮 ========== */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 48rpx;
  border-radius: 28rpx;
  font-size: 28rpx;
  font-weight: 600;
  transition: all 0.2s ease;
}

.btn-primary {
  background: linear-gradient(135deg, #4A90D9, #3A7BC8);
  color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(59,130,246,0.3);
}

.btn-primary:active {
  transform: scale(0.96);
  opacity: 0.9;
}

/* ========== 无结果引导页 ========== */
.empty-with-guide {
  padding: 60rpx 32rpx 120rpx;
}

.guide-section {
  width: 100%;
  margin-bottom: 40rpx;
}

.guide-title {
  font-size: 28rpx;
  color: #333333;
  font-weight: 600;
  margin-bottom: 20rpx;
  padding-left: 8rpx;
}

.guide-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.guide-tag {
  padding: 12rpx 28rpx;
  background: #F5F7FA;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: #555555;
  border: 1rpx solid #E5E6EB;
  transition: all 0.2s ease;
}

.guide-tag:active {
  background: #E8F3FC;
  color: #3A7BC8;
  border-color: #3A7BC8;
}

.guide-categories {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.guide-category {
  width: calc(25% - 15rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
  background: #F5F7FA;
  border-radius: 16rpx;
  transition: all 0.2s ease;
}

.guide-category:active {
  background: #E8F3FC;
  transform: scale(0.96);
}

.guide-category-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.guide-category-name {
  font-size: 22rpx;
  color: #555555;
}
