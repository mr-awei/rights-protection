/* pages/search-result/search-result.wxss */
.container {
  min-height: 100vh;
  background: #F5F6F8;
}

/* ========== 搜索框 ========== */
.search-header {
  background: linear-gradient(135deg, #5B9BD5 0%, #4A90D9 50%, #3A7BC8 100%);
  padding-top: var(--status-bar-height, 44px);
  padding-bottom: 16rpx;
}

.search-box {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 12rpx 16rpx 12rpx 20rpx;
  margin: 16rpx 24rpx 0;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  opacity: 0.6;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1A1A1A;
  height: 48rpx;
}

.search-placeholder {
  color: #999999;
  font-size: 26rpx;
}

.search-btn {
  background: linear-gradient(135deg, #4A90D9, #3A7BC8);
  padding: 10rpx 24rpx;
  border-radius: 16rpx;
  margin-left: 12rpx;
}

.search-btn text {
  font-size: 26rpx;
  color: #FFFFFF;
  font-weight: 600;
}

/* ========== Tab切换 ========== */
.result-tabs {
  display: flex;
  background: #FFFFFF;
  padding: 16rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  position: sticky;
  top: 0;
  z-index: 10;
}

.result-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #666666;
  font-weight: 500;
  border-radius: 16rpx;
  transition: all 0.2s ease;
  position: relative;
}

.result-tab.active {
  color: #3A7BC8;
  font-weight: 700;
  background: #E8F3FC;
}

.result-tab.active::after {
  content: '';
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #4A90D9, #3A7BC8);
  border-radius: 3rpx;
}

/* ========== 结果数量 ========== */
.result-count {
  padding: 24rpx 32rpx 16rpx;
  font-size: 24rpx;
  color: #999999;
}

/* ========== 结果列表 ========== */
.result-list {
  padding: 0 24rpx;
}

.result-item {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  transition: all 0.2s ease;
  border-left: 6rpx solid #4A90D9;
}

.result-item:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
}

.ri-title {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.ri-type {
  font-size: 20rpx;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  font-weight: 600;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.ri-type.channel {
  background: #E8F3FC;
  color: #3A7BC8;
}

.ri-type.script {
  background: #F0FDF4;
  color: #16A34A;
}

.ri-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.ri-desc {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.6;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.ri-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex-wrap: wrap;
}

.ri-meta text {
  font-size: 22rpx;
  color: #999999;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.4;
}

.empty-title {
  font-size: 30rpx;
  color: #666666;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #999999;
  text-align: center;
  margin-bottom: 32rpx;
}

.empty-actions {
  width: 100%;
  max-width: 400rpx;
}

/* ========== 按钮 ========== */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 48rpx;
  border-radius: 28rpx;
  font-size: 28rpx;
  font-weight: 600;
  transition: all 0.2s ease;
}

.btn-primary {
  background: linear-gradient(135deg, #4A90D9, #3A7BC8);
  color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(59,130,246,0.3);
}

.btn-primary:active {
  transform: scale(0.96);
  opacity: 0.9;
}
