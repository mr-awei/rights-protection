/* pages/enterprise-query/enterprise-query.wxss */
.container {
  min-height: 100vh;
  background: var(--bg-page);
}

.gradient-header {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 50%, #2E6DB4 100%);
  padding: 20rpx 0 28rpx;
  position: relative;
  overflow: hidden;
}

.gradient-header::before {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -30rpx;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.12) 0%, transparent 70%);
  border-radius: 50%;
}

.header-content {
  position: relative;
  z-index: 1;
  padding: 0 32rpx;
}

.header-top {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.header-icon {
  margin-right: 16rpx;
  flex-shrink: 0;
}

.header-title {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text-inverse);
  line-height: 1.2;
}

.header-desc {
  font-size: var(--font-sm);
  color: rgba(255,255,255,0.85);
  line-height: 1.3;
  padding-left: 72rpx;
}

.content {
  padding: 20rpx 24rpx 24rpx;
  margin-top: -12rpx;
  position: relative;
  z-index: 2;
}

/* 提示卡片 */
.tip-card {
  display: flex;
  align-items: flex-start;
  background: linear-gradient(135deg, #FFFBEB 0%, #FEF3C7 100%);
  border: 1rpx solid #FDE68A;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
}

.tip-icon {
  font-size: var(--font-normal);
  margin-right: 12rpx;
  flex-shrink: 0;
}

.tip-text {
  flex: 1;
  font-size: var(--font-base);
  color: #78350F;
  line-height: 1.7;
}

/* 平台列表 */
.platform-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.platform-item {
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  border-left: 6rpx solid #EF4444;
  transition: all 0.2s ease;
}

.platform-item-hover {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
}

.platform-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-2xl);
  margin-right: 16rpx;
  flex-shrink: 0;
}

.platform-info {
  flex: 1;
  min-width: 0;
}

.platform-name {
  font-size: var(--font-normal);
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.platform-desc {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.platform-url {
  display: flex;
  align-items: center;
  background: var(--bg-page);
  border-radius: 8rpx;
  padding: 8rpx 12rpx;
}

.url-icon {
  font-size: var(--font-xs);
  margin-right: 6rpx;
}

.url-text {
  flex: 1;
  font-size: var(--font-xs);
  color: var(--primary-dark);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.url-copy {
  font-size: var(--font-xs);
  color: #EF4444;
  font-weight: 600;
  margin-left: 8rpx;
}

.platform-arrow {
  font-size: var(--font-xl);
  color: var(--text-quaternary);
  margin-left: 12rpx;
}

/* 查询要点 */
.points-card {
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.points-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.points-icon {
  font-size: var(--font-normal);
  margin-right: 8rpx;
}

.points-title {
  font-size: var(--font-normal);
  font-weight: 700;
  color: var(--text-primary);
}

.points-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.point-item {
  display: flex;
  align-items: flex-start;
}

.point-num {
  width: 32rpx;
  height: 32rpx;
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: var(--text-inverse);
  font-size: var(--font-xs);
  font-weight: 700;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.point-text {
  flex: 1;
  font-size: var(--font-base);
  color: var(--text-secondary);
  line-height: 1.6;
  padding-top: 2rpx;
}
