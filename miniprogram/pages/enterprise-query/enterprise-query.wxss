/* pages/enterprise-query/enterprise-query.wxss */
.container {
  min-height: 100vh;
  background: #F8FAFC;
}

.gradient-header {
  background: linear-gradient(135deg, #EF4444 0%, #DC2626 50%, #B91C1C 100%);
  padding: 0 0 40rpx;
  position: relative;
  overflow: hidden;
}

.gradient-header::before {
  content: '';
  position: absolute;
  top: -80rpx;
  right: -40rpx;
  width: 280rpx;
  height: 280rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
  border-radius: 50%;
}

.header-content {
  position: relative;
  z-index: 1;
  padding: 32rpx 32rpx 0;
}

.header-icon {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.header-desc {
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
}

.content {
  padding: 24rpx;
  margin-top: -20rpx;
  position: relative;
  z-index: 2;
}

/* 提示卡片 */
.tip-card {
  display: flex;
  align-items: flex-start;
  background: linear-gradient(135deg, #FFFBEB 0%, #FEF3C7 100%);
  border: 1rpx solid #FDE68A;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
}

.tip-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.tip-text {
  flex: 1;
  font-size: 24rpx;
  color: #78350F;
  line-height: 1.7;
}

/* 平台列表 */
.platform-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.platform-item {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  border-left: 6rpx solid #EF4444;
  transition: all 0.2s ease;
}

.platform-item-hover {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
}

.platform-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.platform-info {
  flex: 1;
  min-width: 0;
}

.platform-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1E293B;
  margin-bottom: 4rpx;
}

.platform-desc {
  font-size: 22rpx;
  color: #64748B;
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.platform-url {
  display: flex;
  align-items: center;
  background: #F8FAFC;
  border-radius: 8rpx;
  padding: 8rpx 12rpx;
}

.url-icon {
  font-size: 20rpx;
  margin-right: 6rpx;
}

.url-text {
  flex: 1;
  font-size: 20rpx;
  color: #2563EB;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.url-copy {
  font-size: 20rpx;
  color: #EF4444;
  font-weight: 600;
  margin-left: 8rpx;
}

.platform-arrow {
  font-size: 32rpx;
  color: #CBD5E1;
  margin-left: 12rpx;
}

/* 查询要点 */
.points-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.points-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.points-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.points-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1E293B;
}

.points-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.point-item {
  display: flex;
  align-items: flex-start;
}

.point-num {
  width: 32rpx;
  height: 32rpx;
  background: linear-gradient(135deg, #EF4444, #DC2626);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 700;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.point-text {
  flex: 1;
  font-size: 24rpx;
  color: #475569;
  line-height: 1.6;
  padding-top: 2rpx;
}
