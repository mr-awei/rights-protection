<!--pages/settings/settings.wxml-->
<view class="container">
  <!-- 通用设置 -->
  <view class="section">
    <view class="section-title-only">通用</view>
    <view class="setting-list">
      <view class="setting-item" bindtap="onAboutTap" hover-class="setting-item-hover">
        <view class="item-icon app-icon app-icon-default icon-info" style="--icon-bg:#ECFDF5;--icon-color:#10B981;"></view>
        <view class="item-info">
          <text class="item-name">关于我们</text>
          <text class="item-desc">版本信息、功能介绍</text>
        </view>
        <text class="item-arrow">›</text>
      </view>
      <view class="setting-item" bindtap="onDisclaimerTap" hover-class="setting-item-hover">
        <view class="item-icon app-icon app-icon-default icon-shield" style="--icon-bg:#FEF2F2;--icon-color:#EF4444;"></view>
        <view class="item-info">
          <text class="item-name">免责声明</text>
          <text class="item-desc">使用须知与法律边界</text>
        </view>
        <text class="item-arrow">›</text>
      </view>
      <view class="setting-item" bindtap="onChangelogTap" hover-class="setting-item-hover">
        <view class="item-icon app-icon app-icon-default icon-clock" style="--icon-bg:#FFFBEB;--icon-color:#F59E0B;"></view>
        <view class="item-info">
          <text class="item-name">更新日志</text>
          <text class="item-desc">查看本次更新了什么</text>
        </view>
        <text class="item-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 数据信息 -->
  <view class="section">
    <view class="section-title-only">数据信息</view>
    <view class="data-info-card">
      <view class="data-row">
        <text class="data-label">应用版本</text>
        <text class="data-value">{{appVersion}}</text>
      </view>
      <view class="data-row">
        <text class="data-label">数据版本</text>
        <text class="data-value">{{dataVersion}}</text>
      </view>
      <view class="data-row">
        <text class="data-label">数据验证日期</text>
        <text class="data-value">{{dataVerifiedAt}}</text>
      </view>
      <view class="data-row">
        <text class="data-label">官方渠道</text>
        <text class="data-value">{{channelCount}} 条</text>
      </view>
      <view class="data-row">
        <text class="data-label">投诉话术</text>
        <text class="data-value">{{scriptCount}} 条</text>
      </view>
      <view class="data-row">
        <text class="data-label">法律法规</text>
        <text class="data-value">{{lawCount}} 条</text>
      </view>
    </view>
  </view>

  <!-- 底部 -->
  <view class="footer">
    <text class="footer-text">© 2026 我不能被欺负</text>
    <text class="footer-text">数据仅供参考，以官方平台为准</text>
  </view>

  <!-- 更新日志自定义弹窗 -->
  <view class="changelog-modal" wx:if="{{showChangelog}}">
    <view class="modal-mask" bindtap="onCloseChangelog"></view>
    <view class="modal-content">
      <view class="modal-header">
        <view class="modal-icon-wrap">
          <view class="modal-icon app-icon app-icon-default icon-clock"></view>
        </view>
        <text class="modal-title">{{changelogData.title}}</text>
        <text class="modal-subtitle">版本 {{changelogData.version}} · {{changelogData.date}}</text>
      </view>
      <view class="modal-body">
        <view class="changelog-item" wx:for="{{changelogData.items}}" wx:key="index">
          <view class="item-num">{{index + 1}}</view>
          <view class="item-text">{{item}}</view>
        </view>
      </view>
      <view class="modal-footer">
        <view class="modal-btn" bindtap="onCloseChangelog">知道了</view>
      </view>
    </view>
  </view>
</view>
