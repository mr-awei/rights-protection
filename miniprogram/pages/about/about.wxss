/* pages/about/about.wxss */
.container {
  min-height: 100vh;
  background: #F8FAFC;
}

/* 自定义导航栏 */
.nav-bar {
  background: linear-gradient(135deg, #60A5FA 0%, #3B82F6 50%, #2563EB 100%);
  padding-top: var(--status-bar-height, 44px);
  display: flex;
  align-items: center;
  height: calc(88rpx + var(--status-bar-height, 44px));
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-back {
  width: 80rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back text {
  font-size: 48rpx;
  color: #FFFFFF;
  font-weight: 300;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.nav-placeholder {
  width: 80rpx;
}

/* 内容区 */
.content {
  padding: 24rpx;
}

/* 应用信息 */
.app-info {
  background: linear-gradient(135deg, #60A5FA 0%, #3B82F6 50%, #2563EB 100%);
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  margin-bottom: 24rpx;
  position: relative;
  overflow: hidden;
}

.app-info::before {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
  border-radius: 50%;
}

.app-logo {
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 24rpx;
  border-radius: 36rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.15);
  border: 4rpx solid rgba(255,255,255,0.3);
}

.app-logo image {
  width: 100%;
  height: 100%;
}

.app-name {
  font-size: 40rpx;
  font-weight: 800;
  color: #FFFFFF;
  margin-bottom: 8rpx;
  position: relative;
  z-index: 1;
}

.app-slogan {
  font-size: 26rpx;
  color: rgba(255,255,255,0.9);
  margin-bottom: 16rpx;
  position: relative;
  z-index: 1;
}

.app-version {
  font-size: 22rpx;
  color: rgba(255,255,255,0.7);
  background: rgba(255,255,255,0.15);
  padding: 6rpx 20rpx;
  border-radius: 12rpx;
  display: inline-block;
  position: relative;
  z-index: 1;
}

/* 通用卡片 */
.stats-card,
.feature-card,
.link-card,
.philosophy-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1E293B;
  margin-bottom: 20rpx;
}

/* 数据统计 */
.stats-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1E293B;
  margin-bottom: 20rpx;
}

.stats-grid {
  display: flex;
  flex-wrap: wrap;
}

.stat-item {
  width: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #3B82F6, #1D4ED8);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.stat-label {
  font-size: 22rpx;
  color: #64748B;
  margin-top: 4rpx;
}

.stats-footer {
  text-align: center;
  font-size: 20rpx;
  color: #94A3B8;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F1F5F9;
}

/* 功能列表 */
.feature-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.feature-item {
  display: flex;
  align-items: center;
}

.feature-icon {
  width: 64rpx;
  height: 64rpx;
  background: linear-gradient(135deg, #EFF6FF, #DBEAFE);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.feature-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.feature-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1E293B;
  margin-bottom: 2rpx;
}

.feature-desc {
  font-size: 22rpx;
  color: #94A3B8;
}

/* 链接列表 */
.link-list {
  display: flex;
  flex-direction: column;
}

.link-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F1F5F9;
  transition: all 0.2s ease;
}

.link-item:last-child {
  border-bottom: none;
}

.link-item-hover {
  background: #F8FAFC;
  margin: 0 -24rpx;
  padding: 20rpx 24rpx;
}

.link-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  width: 40rpx;
  text-align: center;
}

.link-name {
  flex: 1;
  font-size: 28rpx;
  color: #1E293B;
}

.link-arrow {
  font-size: 32rpx;
  color: #CBD5E1;
}

/* 维权理念 */
.philosophy-card {
  background: linear-gradient(135deg, #FEF2F2 0%, #FEE2E2 100%);
  border: 1rpx solid #FECACA;
  border-left: 6rpx solid #DC2626;
}

.philosophy-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #991B1B;
  margin-bottom: 16rpx;
}

.philosophy-text {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.philosophy-text text {
  font-size: 24rpx;
  color: #7F1D1D;
  line-height: 1.6;
}

/* 底部 */
.footer {
  text-align: center;
  padding: 32rpx 0 16rpx;
}

.footer-text {
  font-size: 22rpx;
  color: #94A3B8;
  display: block;
  margin-bottom: 6rpx;
}
