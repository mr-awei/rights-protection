/* pages/category/category.wxss */
.container {
  height: 100vh;
  background: #F5F7FA;
}

.category-layout {
  display: flex;
  height: 100%;
}

/* 左侧分类侧边栏 */
.category-sidebar {
  width: 180rpx;
  background: #F5F7FA;
  flex-shrink: 0;
  height: 100%;
}

.cat-sidebar-item {
  padding: 28rpx 16rpx;
  text-align: center;
  font-size: 24rpx;
  color: #4E5969;
  cursor: pointer;
  border-left: 6rpx solid transparent;
  transition: all 0.2s;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.cat-sidebar-item.active {
  background: #FFFFFF;
  color: #1677FF;
  font-weight: 600;
  border-left-color: #1677FF;
}

.cat-icon {
  font-size: 36rpx;
}

.cat-name {
  font-size: 24rpx;
}

/* 右侧渠道列表 */
.category-content {
  flex: 1;
  height: 100%;
  padding: 24rpx;
  background: #FFFFFF;
}

.cat-group-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2329;
  margin: 8rpx 8rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cat-count {
  font-size: 22rpx;
  color: #86909C;
  font-weight: 400;
}

.cat-channel-item {
  background: #F5F7FA;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.cat-channel-item:active {
  background: #E5E6EB;
}

.cci-name {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
  color: #1F2329;
  line-height: 1.4;
}

.cci-desc {
  font-size: 24rpx;
  color: #86909C;
  line-height: 1.5;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.cci-meta {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.cci-meta text {
  font-size: 22rpx;
  color: #86909C;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 20rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-title {
  font-size: 28rpx;
  color: #86909C;
}
