/* pages/category/category.wxss */
.container {
  height: 100vh;
  background: #F8FAFC;
  box-sizing: border-box;
}

.category-layout {
  display: flex;
  height: 100%;
  box-sizing: border-box;
}

/* ========== 左侧一级分类侧边栏 ========== */
.category-sidebar {
  width: 180rpx;
  height: 100%;
  background: #FFFFFF;
  border-right: 1rpx solid #F1F5F9;
  flex-shrink: 0;
  box-sizing: border-box;
}

.cat-sidebar-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 8rpx;
  box-sizing: border-box;
}

.cat-sidebar-item.active {
  background: #F8FAFC;
}

.cat-sidebar-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  margin-bottom: 8rpx;
  box-sizing: border-box;
}

.cat-sidebar-item.active .cat-sidebar-icon {
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.cat-sidebar-name {
  font-size: 22rpx;
  color: #64748B;
  font-weight: 500;
  text-align: center;
  line-height: 1.3;
  width: 100%;
  word-break: break-all;
  box-sizing: border-box;
}

.cat-sidebar-item.active .cat-sidebar-name {
  color: #1E293B;
  font-weight: 600;
}

.cat-sidebar-indicator {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 36rpx;
  background: linear-gradient(180deg, #3B82F6, #2563EB);
  border-radius: 0 6rpx 6rpx 0;
}

/* ========== 右侧区域 ========== */
.category-right {
  flex: 1;
  display: flex;
  flex-direction: column;
  height: 100%;
  min-width: 0;
  box-sizing: border-box;
}

/* ========== 二级分类标签栏（独立固定头部） ========== */
.sub-category-bar {
  white-space: nowrap;
  padding: 20rpx 0 12rpx 24rpx;
  background: #FFFFFF;
  flex-shrink: 0;
  box-sizing: border-box;
  width: 100%;
}

.sub-cat-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 24rpx;
  margin-right: 12rpx;
  background: #F8FAFC;
  border: 1rpx solid #E2E8F0;
  border-radius: 28rpx;
  font-size: 24rpx;
  color: #64748B;
  font-weight: 500;
  flex-shrink: 0;
  box-sizing: border-box;
  height: 56rpx;
  line-height: 1;
}

.sub-cat-tag.active {
  background: linear-gradient(135deg, #3B82F6, #2563EB);
  border-color: transparent;
  color: #FFFFFF;
  font-weight: 600;
}

.sub-cat-padding {
  width: 24rpx;
  height: 1rpx;
  display: inline-block;
  flex-shrink: 0;
}

/* ========== 分类标题 ========== */
.cat-header {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx 16rpx;
  background: #FFFFFF;
  flex-shrink: 0;
  box-sizing: border-box;
  border-bottom: 1rpx solid #F1F5F9;
}

.cat-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1E293B;
  margin-right: 10rpx;
}

.cat-subtitle {
  font-size: 24rpx;
  color: #94A3B8;
  font-weight: 400;
}

.cat-count-badge {
  margin-left: auto;
  padding: 6rpx 14rpx;
  background: #EFF6FF;
  color: #3B82F6;
  font-size: 20rpx;
  font-weight: 600;
  border-radius: 16rpx;
  flex-shrink: 0;
}

/* ========== 渠道列表滚动区 ========== */
.channel-scroll {
  flex: 1;
  height: 0;
  box-sizing: border-box;
}

.channel-list {
  padding: 16rpx 24rpx 0;
  box-sizing: border-box;
}

.channel-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.03);
  box-sizing: border-box;
  width: 100%;
}

.channel-card-hover {
  background: #F8FAFC;
}

.channel-card-left {
  margin-right: 16rpx;
  flex-shrink: 0;
}

.channel-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  box-sizing: border-box;
}

.channel-card-center {
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
}

.channel-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1E293B;
  line-height: 1.4;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  word-break: break-all;
}

.channel-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.channel-phone {
  font-size: 22rpx;
  color: #3B82F6;
  font-weight: 500;
  background: #EFF6FF;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
}

.channel-official {
  font-size: 20rpx;
  color: #10B981;
  font-weight: 500;
}

.channel-card-right {
  margin-left: 12rpx;
  flex-shrink: 0;
}

.channel-arrow {
  font-size: 36rpx;
  color: #CBD5E1;
  font-weight: 300;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 20rpx;
  opacity: 0.4;
}

.empty-title {
  font-size: 28rpx;
  color: #64748B;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #94A3B8;
}
