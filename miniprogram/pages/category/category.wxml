<!--pages/category/category.wxml-->
<view class="container">
  <view class="category-layout">
    <!-- 左侧一级分类侧边栏 -->
    <scroll-view class="category-sidebar" scroll-y>
      <view
        class="cat-sidebar-item {{activeCategory === index ? 'active' : ''}}"
        wx:for="{{categories}}"
        wx:key="name"
        data-index="{{index}}"
        bindtap="onCategoryTap"
      >
        <view class="cat-sidebar-icon" style="background: {{item.color || '#3B82F6'}}15; color: {{item.color || '#3B82F6'}}">
          <text>{{item.icon || ''}}</text>
        </view>
        <text class="cat-sidebar-name">{{item.name}}</text>
        <view class="cat-sidebar-indicator" wx:if="{{activeCategory === index}}"></view>
      </view>
    </scroll-view>

    <!-- 右侧区域 -->
    <view class="category-right">
      <!-- 二级分类标签（独立固定头部，不嵌套在纵向scroll-view里） -->
      <scroll-view class="sub-category-bar" scroll-x enable-flex show-scrollbar="{{false}}">
        <view
          class="sub-cat-tag {{activeSubCategory === idx ? 'active' : ''}}"
          wx:for="{{subCategories}}"
          wx:for-index="idx"
          wx:key="name"
          data-index="{{idx}}"
          bindtap="onSubCategoryTap"
        >
          {{item.name}}
        </view>
        <view class="sub-cat-padding"></view>
      </scroll-view>

      <!-- 分类标题和数量 -->
      <view class="cat-header">
        <text class="cat-title">{{categories[activeCategory].name}}</text>
        <text class="cat-subtitle">{{subCategories[activeSubCategory].name}}</text>
        <view class="cat-count-badge">{{channels.length}}个渠道</view>
      </view>

      <!-- 渠道列表（独立纵向scroll-view） -->
      <scroll-view class="channel-scroll" scroll-y>
        <view class="channel-list">
          <view
            class="channel-card"
            wx:for="{{channels}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="onChannelTap"
            hover-class="channel-card-hover"
          >
            <view class="channel-card-left">
              <view class="channel-icon" style="background: {{categories[activeCategory].color || '#3B82F6'}}15; color: {{categories[activeCategory].color || '#3B82F6'}}">
                <text>{{categories[activeCategory].icon || ''}}</text>
              </view>
            </view>
            <view class="channel-card-center">
              <view class="channel-name">{{item.name}}</view>
              <view class="channel-meta">
                <text class="channel-phone" wx:if="{{item.phone}}"> {{item.phone}}</text>
                <text class="channel-official" wx:if="{{item.is_official}}"> 官方</text>
              </view>
            </view>
            <view class="channel-card-right">
              <text class="channel-arrow">›</text>
            </view>
          </view>
        </view>

        <!-- 空状态 -->
        <view class="empty-state" wx:if="{{channels.length === 0}}">
          <view class="empty-icon">�</view>
          <view class="empty-title">该分类下暂无渠道</view>
          <view class="empty-desc">试试其他分类吧</view>
        </view>

        <view style="height: 40rpx;"></view>
      </scroll-view>
    </view>
  </view>
</view>
