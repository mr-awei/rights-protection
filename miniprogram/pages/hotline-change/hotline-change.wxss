/* pages/hotline-change/hotline-change.wxss */
.container {
  min-height: 100vh;
  background: var(--bg-page);
}

/* 渐变头部 */
.gradient-header {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 50%, #2E6DB4 100%);
  padding: 20rpx 0 28rpx;
  position: relative;
  overflow: hidden;
}

.gradient-header::before {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -30rpx;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.12) 0%, transparent 70%);
  border-radius: 50%;
}

.header-content {
  position: relative;
  z-index: 1;
  padding: 0 32rpx;
}

.header-top {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.header-icon {
  margin-right: 16rpx;
  flex-shrink: 0;
}

.header-title {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text-inverse);
  line-height: 1.2;
}

.header-desc {
  font-size: var(--font-sm);
  color: rgba(255,255,255,0.85);
  line-height: 1.3;
  padding-left: 72rpx;
}

.content {
  padding: 20rpx 24rpx 24rpx;
  margin-top: -12rpx;
  position: relative;
  z-index: 2;
}

/* 筛选Tab */
.filter-tabs {
  display: flex;
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.filter-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: var(--font-base);
  color: var(--text-secondary);
  font-weight: 500;
  border-radius: 12rpx;
  transition: all 0.2s ease;
}

.filter-tab.active {
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: var(--text-inverse);
  font-weight: 600;
}

/* 搜索框 */
.search-box {
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border-radius: 40rpx;
  padding: 16rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.search-icon {
  margin-right: 12rpx;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  font-size: var(--font-normal);
  color: #333333;
}

.search-placeholder {
  color: var(--text-tertiary);
  font-size: var(--font-md);
}

.search-clear {
  font-size: var(--font-normal);
  color: var(--text-tertiary);
  padding: 8rpx;
}

/* 变更列表 */
.change-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.change-item {
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  border-left: 6rpx solid #F59E0B;
}

.change-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.change-name {
  font-size: var(--font-normal);
  font-weight: 700;
  color: var(--text-primary);
  flex: 1;
}

.change-status {
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
  font-size: var(--font-xs);
  font-weight: 600;
  margin-left: 12rpx;
}

.status-discontinued {
  background: #FEF2F2;
  color: #DC2626;
}

.status-merged {
  background: #FFFBEB;
  color: #D97706;
}

.status-merging {
  background: var(--primary-bg);
  color: var(--primary-dark);
}

.change-old-phone {
  font-size: var(--font-base);
  color: var(--text-tertiary);
  text-decoration: line-through;
  margin-bottom: 8rpx;
}

.change-reason {
  font-size: var(--font-base);
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.change-replacement {
  background: var(--bg-page);
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 8rpx;
}

.replacement-label {
  font-size: var(--font-sm);
  color: var(--text-tertiary);
  margin-bottom: 4rpx;
}

.replacement-name {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.replacement-phone {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.phone-text {
  font-size: var(--font-base);
  color: var(--primary-dark);
  font-weight: 500;
}

.call-text {
  font-size: var(--font-sm);
  color: #10B981;
  font-weight: 500;
  background: #F0FDF4;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.change-date {
  font-size: var(--font-sm);
  color: var(--text-tertiary);
  margin-top: 8rpx;
}

/* 提示卡片 */
.tip-card {
  display: flex;
  align-items: flex-start;
  background: linear-gradient(135deg, #FFFBEB 0%, #FEF3C7 100%);
  border: 1rpx solid #FDE68A;
  border-radius: 16rpx;
  padding: 20rpx;
}

.tip-icon {
  font-size: var(--font-normal);
  margin-right: 12rpx;
  flex-shrink: 0;
}

.tip-text {
  flex: 1;
  font-size: var(--font-base);
  color: #78350F;
  line-height: 1.7;
}
