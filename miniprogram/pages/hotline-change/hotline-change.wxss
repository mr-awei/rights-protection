/* pages/hotline-change/hotline-change.wxss */
.container {
  min-height: 100vh;
  background: #F8FAFC;
}

.gradient-header {
  background: linear-gradient(135deg, #F59E0B 0%, #D97706 50%, #B45309 100%);
  padding: 0 0 40rpx;
  position: relative;
  overflow: hidden;
}

.gradient-header::before {
  content: '';
  position: absolute;
  top: -80rpx;
  right: -40rpx;
  width: 280rpx;
  height: 280rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
  border-radius: 50%;
}

.header-content {
  position: relative;
  z-index: 1;
  padding: 32rpx 32rpx 0;
}

.header-icon {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.header-desc {
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
}

.content {
  padding: 24rpx;
  margin-top: -20rpx;
  position: relative;
  z-index: 2;
}

/* 筛选Tab */
.filter-tabs {
  display: flex;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.filter-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 24rpx;
  color: #64748B;
  font-weight: 500;
  border-radius: 12rpx;
  transition: all 0.2s ease;
}

.filter-tab.active {
  background: linear-gradient(135deg, #F59E0B, #D97706);
  color: #FFFFFF;
  font-weight: 600;
}

/* 变更列表 */
.change-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.change-item {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  border-left: 6rpx solid #F59E0B;
}

.change-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.change-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1E293B;
  flex: 1;
}

.change-status {
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
  font-size: 20rpx;
  font-weight: 600;
  margin-left: 12rpx;
}

.status-discontinued {
  background: #FEF2F2;
  color: #DC2626;
}

.status-merged {
  background: #FFFBEB;
  color: #D97706;
}

.status-merging {
  background: #EFF6FF;
  color: #2563EB;
}

.change-old-phone {
  font-size: 24rpx;
  color: #94A3B8;
  text-decoration: line-through;
  margin-bottom: 8rpx;
}

.change-reason {
  font-size: 24rpx;
  color: #64748B;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.change-replacement {
  background: #F8FAFC;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 8rpx;
}

.replacement-label {
  font-size: 22rpx;
  color: #94A3B8;
  margin-bottom: 4rpx;
}

.replacement-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1E293B;
  margin-bottom: 8rpx;
}

.replacement-phone {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.phone-text {
  font-size: 24rpx;
  color: #2563EB;
  font-weight: 500;
}

.call-text {
  font-size: 22rpx;
  color: #10B981;
  font-weight: 500;
  background: #F0FDF4;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.change-date {
  font-size: 22rpx;
  color: #94A3B8;
  margin-top: 8rpx;
}

/* 提示卡片 */
.tip-card {
  display: flex;
  align-items: flex-start;
  background: linear-gradient(135deg, #FFFBEB 0%, #FEF3C7 100%);
  border: 1rpx solid #FDE68A;
  border-radius: 16rpx;
  padding: 20rpx;
}

.tip-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.tip-text {
  flex: 1;
  font-size: 24rpx;
  color: #78350F;
  line-height: 1.7;
}
