/* pages/search-quality/search-quality.wxss */
.container {
  min-height: 100vh;
  background: #F5F7FA;
  padding: 24rpx;
  padding-bottom: 60rpx;
}

/* 概览卡片 */
.overview-card {
  background: linear-gradient(135deg, #4A90D9, #0958D9);
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.overview-title {
  font-size: var(--font-xl);
  font-weight: 600;
  color: var(--text-inverse);
  margin-bottom: 24rpx;
}

.overview-stats {
  display: flex;
  justify-content: space-between;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: var(--font-3xl);
  font-weight: 700;
  color: var(--text-inverse);
  display: block;
}

.stat-label {
  font-size: var(--font-sm);
  color: rgba(255,255,255,0.8);
  margin-top: 8rpx;
  display: block;
}

/* 通用section */
.section {
  background: var(--bg-card);
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.section-header {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx 20rpx;
}

.section-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.section-info {
  flex: 1;
}

.section-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: #1A1B1C;
  display: block;
}

.section-desc {
  font-size: var(--font-base);
  color: #86909C;
  margin-top: 4rpx;
  display: block;
}

/* 高频搜索词列表 */
.keyword-list {
  padding: 0 24rpx 16rpx;
}

.keyword-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F2F3F5;
}

.keyword-item:last-child {
  border-bottom: none;
}

.keyword-rank {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  background: #F2F3F5;
  color: #86909C;
  font-size: var(--font-base);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.keyword-rank.top {
  background: linear-gradient(135deg, #FFD700, #FFA500);
  color: var(--text-inverse);
}

.keyword-info {
  flex: 1;
  min-width: 0;
}

.keyword-text {
  font-size: var(--font-normal);
  color: #1A1B1C;
  font-weight: 500;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.keyword-bar-bg {
  height: 8rpx;
  background: #F2F3F5;
  border-radius: 4rpx;
  margin-top: 8rpx;
  overflow: hidden;
}

.keyword-bar {
  height: 100%;
  background: linear-gradient(90deg, #4A90D9, #69B1FF);
  border-radius: 4rpx;
}

.keyword-count {
  font-size: var(--font-base);
  color: #86909C;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.keyword-action {
  margin-left: 16rpx;
  padding: 8rpx 16rpx;
  background: #EFF6FF;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.keyword-action text {
  font-size: var(--font-sm);
  color: #4A90D9;
}

.keyword-action-hover {
  opacity: 0.7;
}

/* 无结果搜索词 */
.no-result-list {
  padding: 0 24rpx 16rpx;
}

.no-result-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F2F3F5;
}

.no-result-item:last-child {
  border-bottom: none;
}

.no-result-info {
  flex: 1;
  min-width: 0;
}

.no-result-text {
  font-size: var(--font-normal);
  color: #1A1B1C;
  font-weight: 500;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.no-result-count {
  font-size: var(--font-sm);
  color: #EF4444;
  margin-top: 4rpx;
  display: block;
}

.no-result-actions {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}

.action-btn {
  padding: 10rpx 20rpx;
  background: var(--border-light);
  border-radius: 10rpx;
}

.action-btn text {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

.action-btn.primary {
  background: #EFF6FF;
}

.action-btn.primary text {
  color: #4A90D9;
}

.action-btn-hover {
  opacity: 0.7;
}

/* 空状态 */
.empty-box {
  padding: 48rpx 24rpx;
  text-align: center;
}

.empty-text {
  font-size: var(--font-md);
  color: #86909C;
}

/* 底部操作按钮 */
.actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 8rpx;
}

.action-btn-large {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 0;
  background: linear-gradient(135deg, #4A90D9, #0958D9);
  border-radius: 16rpx;
}

.action-btn-large text {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--text-inverse);
}

.action-btn-large.secondary {
  background: var(--bg-card);
  border: 1rpx solid #E5E6EB;
}

.action-btn-large.secondary text {
  color: var(--text-secondary);
}

.action-btn-large-hover {
  opacity: 0.85;
}
