/* loading-state.wxss - 加载状态组件样式 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
}

.loading-spinner {
  border: 4rpx solid var(--border, #EEEEEE);
  border-top-color: var(--primary, #4A90D9);
  border-radius: 50%;
  animation: loading-spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes loading-spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: var(--font-base, 24rpx);
  color: var(--text-tertiary, #999999);
}
