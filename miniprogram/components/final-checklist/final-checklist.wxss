/* final-checklist.wxss */
.final-checklist-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.fc-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.fc-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D2129;
}

.fc-count {
  font-size: 24rpx;
  color: #86909C;
}

.fc-tip {
  font-size: 24rpx;
  color: #86909C;
  margin-bottom: 12rpx;
  line-height: 1.5;
}

.fc-item {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 12rpx;
  border-bottom: 1rpx solid #F2F3F5;
  border-radius: 8rpx;
}

.fc-item:last-of-type {
  border-bottom: none;
}

.fc-item-checked .fc-text {
  color: #86909C;
  text-decoration: line-through;
}

.fc-check {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #C9CDD4;
  border-radius: 8rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 2rpx;
  box-sizing: border-box;
}

.fc-check.checked {
  background: #00B42A;
  border-color: #00B42A;
}

.fc-mark {
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: bold;
  line-height: 1;
}

.fc-text {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #1D2129;
  line-height: 1.5;
}

.fc-progress {
  width: 100%;
  height: 6rpx;
  border-radius: 3rpx;
  margin-top: 16rpx;
}

.fc-summary {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #4E5969;
  background: #F5F7FA;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  line-height: 1.5;
}

.fc-summary.done {
  color: #00B42A;
  background: #E8FFEA;
  font-weight: 600;
}

.fc-reset {
  margin-top: 14rpx;
  text-align: center;
  font-size: 24rpx;
  color: #86909C;
  padding: 10rpx 0;
}

.fc-reset-hover {
  color: #4A90D9;
}
