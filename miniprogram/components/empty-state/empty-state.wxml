<!--empty-state.wxml-->
<view class="empty-state">
  <view class="empty-icon {{iconClass}} app-icon app-icon-default {{iconType === 'search' ? 'icon-search' : iconType === 'favorite' ? 'icon-heart' : iconType === 'history' ? 'icon-clock' : iconType === 'network' ? 'icon-wifi' : 'icon-inbox'}}" style="width:120rpx;height:120rpx;--icon-bg:transparent;--icon-color:#CCCCCC;"></view>
  <view class="empty-title">{{title}}</view>
  <view class="empty-desc" wx:if="{{desc}}">{{desc}}</view>
  <view class="empty-action" wx:if="{{actionText}}" bindtap="onActionTap">{{actionText}}</view>
</view>
