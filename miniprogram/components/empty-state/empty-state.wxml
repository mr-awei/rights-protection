<!--empty-state.wxml-->
<view class="empty-state {{size === 'simple' ? 'empty-state-simple' : ''}}">
  <view class="empty-icon {{iconClass}} app-icon app-icon-default {{iconType === 'search' ? 'icon-search' : iconType === 'favorite' ? 'icon-heart' : iconType === 'history' ? 'icon-clock' : iconType === 'network' ? 'icon-wifi' : 'icon-inbox'}}" style="{{size === 'simple' ? 'width:60rpx;height:60rpx;' : 'width:120rpx;height:120rpx;'}}--icon-bg:transparent;--icon-color:#CCCCCC;"></view>
  <view class="empty-title {{size === 'simple' ? 'empty-title-simple' : ''}}">{{title}}</view>
  <view class="empty-desc" wx:if="{{desc && size !== 'simple'}}">{{desc}}</view>
  <view class="empty-action" wx:if="{{actionText && size !== 'simple'}}" bindtap="onActionTap">{{actionText}}</view>
</view>
