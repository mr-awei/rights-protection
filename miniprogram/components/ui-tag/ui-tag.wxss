/* ui-tag.wxss - 通用标签组件样式 */
.ui-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-sm, 12rpx);
  font-size: var(--font-base, 24rpx);
  line-height: 1.4;
  margin-right: var(--spacing-xs, 8rpx);
  margin-bottom: var(--spacing-xs, 8rpx);
}

.ui-tag-round {
  border-radius: var(--radius-full, 999rpx);
}

.ui-tag-small {
  padding: 2rpx 12rpx;
  font-size: var(--font-sm, 22rpx);
}

.ui-tag-large {
  padding: 8rpx 24rpx;
  font-size: var(--font-normal, 28rpx);
}

/* 类型样式 */
.ui-tag-default {
  background: var(--bg-divider, #F8F8F8);
  color: var(--text-secondary, #666666);
}

.ui-tag-primary {
  background: var(--primary-bg, #E8F3FC);
  color: var(--primary, #4A90D9);
}

.ui-tag-success {
  background: rgba(82, 196, 26, 0.1);
  color: var(--success, #52C41A);
}

.ui-tag-warning {
  background: rgba(250, 173, 20, 0.1);
  color: var(--warning, #FAAD14);
}

.ui-tag-danger {
  background: rgba(255, 77, 79, 0.1);
  color: var(--danger, #FF4D4F);
}

.ui-tag-info {
  background: rgba(24, 144, 255, 0.1);
  color: var(--info, #1890FF);
}

/* 适合深色/彩色背景的标签类型 */
.ui-tag-light {
  background: rgba(255, 255, 255, 0.18);
  color: #FFFFFF;
  border: 1rpx solid rgba(255, 255, 255, 0.25);
}

.ui-tag-warning-light {
  background: rgba(255, 228, 181, 0.12);
  color: #FFE4B5;
  border: 1rpx solid rgba(255, 228, 181, 0.3);
}

.ui-tag-text {
  line-height: 1.4;
}

.ui-tag-close {
  margin-left: 8rpx;
  opacity: 0.6;
}

.ui-tag-close:active {
  opacity: 1;
}
