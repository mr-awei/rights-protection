/* app.wxss - 全局样式 */
/* 设计系统：现代简洁 · 蓝色主调 · 卡片式布局 · 柔和阴影 */

page {
  --primary: #3B82F6;
  --primary-dark: #2563EB;
  --primary-light: #60A5FA;
  --primary-bg: #EFF6FF;
  --success: #10B981;
  --warning: #F59E0B;
  --danger: #EF4444;
  --info: #0EA5E9;

  --text-primary: #1E293B;
  --text-secondary: #64748B;
  --text-tertiary: #94A3B8;
  --text-inverse: #FFFFFF;

  --bg-page: #F8FAFC;
  --bg-card: #FFFFFF;
  --bg-hover: #F1F5F9;
  --border: #E2E8F0;
  --border-light: #F1F5F9;

  --radius-sm: 12rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;
  --radius-full: 999rpx;

  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  --shadow-md: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  --shadow-lg: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
  --shadow-primary: 0 4rpx 16rpx rgba(59, 130, 246, 0.3);

  background-color: var(--bg-page);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

/* ========== 通用工具类 ========== */
.container {
  min-height: 100vh;
  background: var(--bg-page);
}

.flex {
  display: flex;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-1 {
  flex: 1;
  min-width: 0;
}

.text-primary {
  color: var(--primary);
}

.text-secondary {
  color: var(--text-secondary);
}

.text-tertiary {
  color: var(--text-tertiary);
}

.text-success {
  color: var(--success);
}

.text-warning {
  color: var(--warning);
}

.text-danger {
  color: var(--danger);
}

.font-bold {
  font-weight: 700;
}

.font-medium {
  font-weight: 500;
}

/* ========== 卡片通用样式 ========== */
.card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.card-hover {
  transition: all 0.2s ease;
}

.card-hover:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-md);
}

/* ========== 按钮通用样式 ========== */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 48rpx;
  border-radius: var(--radius-full);
  font-size: 28rpx;
  font-weight: 600;
  transition: all 0.2s ease;
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: var(--text-inverse);
  box-shadow: var(--shadow-primary);
}

.btn-primary:active {
  transform: scale(0.96);
  opacity: 0.9;
}

.btn-outline {
  background: transparent;
  border: 2rpx solid var(--border);
  color: var(--text-secondary);
}

.btn-outline:active {
  background: var(--bg-hover);
}

/* ========== 标签通用样式 ========== */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-sm);
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.4;
}

.tag-primary {
  background: var(--primary-bg);
  color: var(--primary);
}

.tag-success {
  background: #ECFDF5;
  color: var(--success);
}

.tag-warning {
  background: #FFFBEB;
  color: var(--warning);
}

.tag-danger {
  background: #FEF2F2;
  color: var(--danger);
}

/* ========== 分割线 ========== */
.divider {
  height: 1rpx;
  background: var(--border-light);
  margin: 24rpx 0;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.4;
}

.empty-title {
  font-size: 30rpx;
  color: var(--text-secondary);
  font-weight: 500;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: var(--text-tertiary);
  text-align: center;
}

/* ========== 加载状态 ========== */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

/* ========== 渐变头部通用 ========== */
.gradient-header {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  padding: 48rpx 32rpx 64rpx;
  position: relative;
  overflow: hidden;
}

.gradient-header::before {
  content: '';
  position: absolute;
  top: -100rpx;
  right: -100rpx;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
  border-radius: 50%;
}

.gradient-header::after {
  content: '';
  position: absolute;
  bottom: -80rpx;
  left: -80rpx;
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.08) 0%, transparent 70%);
  border-radius: 50%;
}

/* ========== 安全区域 ========== */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

.safe-top {
  padding-top: env(safe-area-inset-top);
}
