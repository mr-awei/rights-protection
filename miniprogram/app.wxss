/* app.wxss - 鍏ㄥ眬鏍峰紡 */
/* 璁捐绯荤粺锛氭瀬绠€涓撲笟 路 鏌斿拰钃濊皟 路 鍗＄墖寮忓竷灞€ 路 杞婚噺闃村奖 */

page {
  --primary: #4A90D9;
  --primary-dark: #3A7BC8;
  --primary-light: #5B9BD5;
  --primary-bg: #E8F3FC;
  --success: #52C41A;
  --warning: #FAAD14;
  --danger: #FF4D4F;
  --info: #1890FF;

  --text-primary: #1A1A1A;
  --text-secondary: #666666;
  --text-tertiary: #999999;
  --text-quaternary: #CCCCCC;
  --text-inverse: #FFFFFF;

  --bg-page: #F5F6F8;
  --bg-card: #FFFFFF;
  --bg-hover: #FAFAFA;
  --bg-divider: #F8F8F8;
  --border: #EEEEEE;
  --border-light: #F5F5F5;

  --radius-sm: 12rpx;
  --radius-md: 16rpx;
  --radius-lg: 20rpx;
  --radius-xl: 24rpx;
  --radius-full: 999rpx;

  --shadow-sm: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  --shadow-md: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  --shadow-lg: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);

  width: 100%;
  min-height: 100vh;
  margin: 0;
  padding: 0;
  background-color: var(--bg-page);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  box-sizing: border-box;
}

/* 鍏ㄥ眬鍏冪礌閲嶇疆 */
view, text, image, scroll-view, swiper, button, input, textarea {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

/* ========== 閫氱敤宸ュ叿绫?========== */
.container {
  width: 100%;
  min-height: 100vh;
  margin: 0;
  padding: 0;
  background: var(--bg-page);
}

.flex {
  display: flex;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-1 {
  flex: 1;
  min-width: 0;
}

.text-primary {
  color: var(--primary);
}

.text-secondary {
  color: var(--text-secondary);
}

.text-tertiary {
  color: var(--text-tertiary);
}

.text-success {
  color: var(--success);
}

.text-warning {
  color: var(--warning);
}

.text-danger {
  color: var(--danger);
}

.font-bold {
  font-weight: 600;
}

.font-medium {
  font-weight: 500;
}

/* ========== 鍗＄墖閫氱敤鏍峰紡 ========== */
.card {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  margin-bottom: 20rpx;
  overflow: hidden;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx 20rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.card-more {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.card-more text {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.more-arrow {
  font-size: 28rpx !important;
  color: var(--text-quaternary) !important;
  line-height: 1;
}

.card-body {
  padding: 0 24rpx 24rpx;
}

/* ========== 鍒楄〃椤归€氱敤鏍峰紡 ========== */
.item-list {
  padding: 0 24rpx;
}

.item-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--bg-divider);
  transition: background 0.2s ease;
}

.item-row:last-child {
  border-bottom: none;
}

.item-row-hover {
  background: var(--bg-hover);
}

.item-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-sm);
  margin-right: 20rpx;
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.item-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-desc {
  font-size: 24rpx;
  color: var(--text-tertiary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-arrow {
  font-size: 32rpx;
  color: var(--text-quaternary);
  margin-left: 12rpx;
  flex-shrink: 0;
}

/* ========== Tab鍒囨崲閫氱敤鏍峰紡 ========== */
.tab-row {
  display: flex;
  padding: 0 24rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0 20rpx;
  font-size: 28rpx;
  color: var(--text-tertiary);
  font-weight: 500;
  position: relative;
  transition: color 0.2s ease;
}

.tab-item.active {
  color: var(--text-primary);
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 36rpx;
  height: 4rpx;
  background: var(--primary);
  border-radius: 2rpx;
}

/* ========== 鎸夐挳閫氱敤鏍峰紡 ========== */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 22rpx 48rpx;
  border-radius: var(--radius-md);
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.2s ease;
  border: none;
}

.btn-primary {
  background: var(--primary);
  color: var(--text-inverse);
}

.btn-primary:active {
  background: var(--primary-dark);
}

.btn-outline {
  background: transparent;
  border: 1rpx solid var(--border);
  color: var(--text-secondary);
}

.btn-outline:active {
  background: var(--bg-hover);
}

/* ========== 鏍囩閫氱敤鏍峰紡 ========== */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-sm);
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.4;
}

.tag-primary {
  background: var(--primary-bg);
  color: var(--primary);
}

.tag-success {
  background: #F6FFED;
  color: var(--success);
}

.tag-warning {
  background: #FFFBE6;
  color: var(--warning);
}

.tag-danger {
  background: #FFF1F0;
  color: var(--danger);
}

/* ========== 鍒嗗壊绾?========== */
.divider {
  height: 1rpx;
  background: var(--border-light);
  margin: 20rpx 0;
}

/* ========== 绌虹姸鎬?========== */
.empty-box {
  padding: 48rpx 0;
  text-align: center;
}

.empty-title {
  font-size: 28rpx;
  color: var(--text-tertiary);
  display: block;
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: var(--text-quaternary);
  display: block;
}

/* ========== 鍔犺浇鐘舵€?========== */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

/* ========== 娓愬彉澶撮儴閫氱敤锛堢畝娲佺増锛?========== */
.gradient-header {
  background: linear-gradient(180deg, var(--primary) 0%, var(--primary-light) 100%);
  padding: 0 0 32rpx;
  position: relative;
  overflow: hidden;
}

.header-content {
  position: relative;
  z-index: 1;
  padding: 24rpx 32rpx 0;
}

/* ========== 瀹夊叏鍖哄煙 ========== */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

.safe-top {
  padding-top: env(safe-area-inset-top);
}

/* ========== 超小型SVG图标库（Feather Icons，MIT协议） ========== */
/* 通过CSS mask+伪元素实现，支持颜色自定义和三态，总体积<5KB */

.app-icon {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.app-icon::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
  -webkit-mask-size: 60%;
  mask-size: 60%;
  transition: all 0.2s ease;
}

/* 默认态 */
.app-icon-default {
  background: var(--icon-bg, var(--primary-bg));
}
.app-icon-default::before {
  -webkit-mask-image: var(--icon-svg);
  mask-image: var(--icon-svg);
  background-color: var(--icon-color, var(--primary));
}

/* Hover态 */
.app-icon-hover {
  background: var(--icon-hover-bg, var(--primary));
}
.app-icon-hover::before {
  -webkit-mask-image: var(--icon-svg);
  mask-image: var(--icon-svg);
  background-color: var(--icon-hover-color, #FFFFFF);
}

/* Active/选中态 */
.app-icon-active {
  background: var(--icon-active-bg, var(--primary-dark));
}
.app-icon-active::before {
  -webkit-mask-image: var(--icon-svg);
  mask-image: var(--icon-svg);
  background-color: var(--icon-active-color, #FFFFFF);
}

