/* app.wxss - 全局样式 */
/* 设计系统：极简专业 · 柔和蓝调 · 卡片式布局 · 轻量阴影 */

page {
  --primary: #4A90D9;
  --primary-dark: #3A7BC8;
  --primary-light: #5B9BD5;
  --primary-bg: #E8F3FC;
  --success: #52C41A;
  --warning: #FAAD14;
  --danger: #FF4D4F;
  --info: #1890FF;

  --text-primary: #1A1A1A;
  --text-secondary: #666666;
  --text-tertiary: #999999;
  --text-quaternary: #CCCCCC;
  --text-inverse: #FFFFFF;

  --bg-page: #F5F6F8;
  --bg-card: #FFFFFF;
  --bg-hover: #FAFAFA;
  --bg-divider: #F8F8F8;
  --border: #EEEEEE;
  --border-light: #F5F5F5;

  --radius-sm: 12rpx;
  --radius-md: 16rpx;
  --radius-lg: 20rpx;
  --radius-xl: 24rpx;
  --radius-full: 999rpx;

  --shadow-sm: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  --shadow-md: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  --shadow-lg: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);

  width: 100%;
  min-height: 100vh;
  margin: 0;
  padding: 0;
  background-color: var(--bg-page);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  box-sizing: border-box;
}

/* 全局元素重置 */
view, text, image, scroll-view, swiper, button, input, textarea {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

/* ========== 通用工具类 ========== */
.container {
  width: 100%;
  min-height: 100vh;
  margin: 0;
  padding: 0;
  background: var(--bg-page);
}

.flex {
  display: flex;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-1 {
  flex: 1;
  min-width: 0;
}

.text-primary {
  color: var(--primary);
}

.text-secondary {
  color: var(--text-secondary);
}

.text-tertiary {
  color: var(--text-tertiary);
}

.text-success {
  color: var(--success);
}

.text-warning {
  color: var(--warning);
}

.text-danger {
  color: var(--danger);
}

.font-bold {
  font-weight: 600;
}

.font-medium {
  font-weight: 500;
}

/* ========== 卡片通用样式 ========== */
.card {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  margin-bottom: 20rpx;
  overflow: hidden;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx 20rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.card-more {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.card-more text {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.more-arrow {
  font-size: 28rpx !important;
  color: var(--text-quaternary) !important;
  line-height: 1;
}

.card-body {
  padding: 0 24rpx 24rpx;
}

/* ========== 列表项通用样式 ========== */
.item-list {
  padding: 0 24rpx;
}

.item-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--bg-divider);
  transition: background 0.2s ease;
}

.item-row:last-child {
  border-bottom: none;
}

.item-row-hover {
  background: var(--bg-hover);
}

.item-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-sm);
  margin-right: 20rpx;
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.item-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-desc {
  font-size: 24rpx;
  color: var(--text-tertiary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-arrow {
  font-size: 32rpx;
  color: var(--text-quaternary);
  margin-left: 12rpx;
  flex-shrink: 0;
}

/* ========== Tab切换通用样式 ========== */
.tab-row {
  display: flex;
  padding: 0 24rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0 20rpx;
  font-size: 28rpx;
  color: var(--text-tertiary);
  font-weight: 500;
  position: relative;
  transition: color 0.2s ease;
}

.tab-item.active {
  color: var(--text-primary);
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 36rpx;
  height: 4rpx;
  background: var(--primary);
  border-radius: 2rpx;
}

/* ========== 按钮通用样式 ========== */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 22rpx 48rpx;
  border-radius: var(--radius-md);
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.2s ease;
  border: none;
}

.btn-primary {
  background: var(--primary);
  color: var(--text-inverse);
}

.btn-primary:active {
  background: var(--primary-dark);
}

.btn-outline {
  background: transparent;
  border: 1rpx solid var(--border);
  color: var(--text-secondary);
}

.btn-outline:active {
  background: var(--bg-hover);
}

/* ========== 标签通用样式 ========== */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-sm);
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.4;
}

.tag-primary {
  background: var(--primary-bg);
  color: var(--primary);
}

.tag-success {
  background: #F6FFED;
  color: var(--success);
}

.tag-warning {
  background: #FFFBE6;
  color: var(--warning);
}

.tag-danger {
  background: #FFF1F0;
  color: var(--danger);
}

/* ========== 分割线 ========== */
.divider {
  height: 1rpx;
  background: var(--border-light);
  margin: 20rpx 0;
}

/* ========== 空状态 ========== */
.empty-box {
  padding: 48rpx 0;
  text-align: center;
}

.empty-title {
  font-size: 28rpx;
  color: var(--text-tertiary);
  display: block;
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: var(--text-quaternary);
  display: block;
}

/* ========== 加载状态 ========== */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

/* ========== 渐变头部通用（简洁版） ========== */
.gradient-header {
  background: linear-gradient(180deg, var(--primary) 0%, var(--primary-light) 100%);
  padding: 0 0 32rpx;
  position: relative;
  overflow: hidden;
}

.header-content {
  position: relative;
  z-index: 1;
  padding: 24rpx 32rpx 0;
}

/* ========== 安全区域 ========== */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

.safe-top {
  padding-top: env(safe-area-inset-top);
}

/* ========== 统一Icon系统（纯CSS绘制，支持三态） ========== */
.app-icon {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.app-icon::before,
.app-icon::after {
  content: '';
  position: absolute;
  transition: all 0.2s ease;
}

/* 默认态 */
.app-icon-default {
  background: var(--icon-bg, var(--primary-bg));
}
.app-icon-default::before,
.app-icon-default::after {
  border-color: var(--icon-color, var(--primary));
  background: var(--icon-color, var(--primary));
}
.app-icon-default .icon-law-left,
.app-icon-default .icon-law-right {
  border-color: var(--icon-color, var(--primary));
}

/* Hover态 */
.app-icon-hover {
  background: var(--icon-hover-bg, var(--primary));
}
.app-icon-hover::before,
.app-icon-hover::after {
  border-color: var(--icon-hover-color, #FFFFFF);
  background: var(--icon-hover-color, #FFFFFF);
}
.app-icon-hover .icon-law-left,
.app-icon-hover .icon-law-right {
  border-color: var(--icon-hover-color, #FFFFFF);
}

/* Active/选中态 */
.app-icon-active {
  background: var(--icon-active-bg, var(--primary-dark));
}
.app-icon-active::before,
.app-icon-active::after {
  border-color: var(--icon-active-color, #FFFFFF);
  background: var(--icon-active-color, #FFFFFF);
}
.app-icon-active .icon-law-left,
.app-icon-active .icon-law-right {
  border-color: var(--icon-active-color, #FFFFFF);
}

/* ===== 法律图标（天平） ===== */
.icon-law::before {
  width: 60%;
  height: 3px;
  top: 32%;
  left: 20%;
  border-radius: 2rpx;
}
.icon-law::after {
  width: 3px;
  height: 45%;
  top: 32%;
  left: 50%;
  transform: translateX(-50%);
  border-radius: 2rpx;
}
.icon-law {
  overflow: visible;
}
.icon-law .icon-law-left,
.icon-law .icon-law-right {
  position: absolute;
  width: 22%;
  height: 18%;
  top: 28%;
  border-radius: 0 0 50% 50%;
  transition: all 0.2s ease;
}
.icon-law .icon-law-left { left: 12%; }
.icon-law .icon-law-right { right: 12%; }

/* ===== 渠道/建筑图标 ===== */
.icon-channel::before {
  width: 45%;
  height: 45%;
  top: 35%;
  left: 27%;
  border-radius: 4rpx;
}
.icon-channel::after {
  width: 25%;
  height: 15%;
  top: 20%;
  left: 37%;
  border-radius: 4rpx 4rpx 0 0;
}

/* ===== 复制图标 ===== */
.icon-copy::before {
  width: 42%;
  height: 50%;
  top: 22%;
  left: 22%;
  border-radius: 4rpx;
  opacity: 0.5;
}
.icon-copy::after {
  width: 42%;
  height: 50%;
  top: 32%;
  left: 36%;
  border-radius: 4rpx;
}

/* ===== 收藏/星星图标 ===== */
.icon-star::before {
  width: 50%;
  height: 50%;
  top: 25%;
  left: 25%;
  border-radius: 50%;
}
.icon-star::after {
  width: 20%;
  height: 20%;
  top: 40%;
  left: 40%;
  border-radius: 50%;
  background: var(--icon-bg, var(--primary-bg)) !important;
}

/* ===== 电话图标 ===== */
.icon-phone::before {
  width: 55%;
  height: 45%;
  top: 28%;
  left: 22%;
  border-radius: 8rpx;
  transform: rotate(-10deg);
}
.icon-phone::after {
  width: 18%;
  height: 6%;
  bottom: 26%;
  left: 41%;
  border-radius: 4rpx;
}

/* ===== 文档/书本图标 ===== */
.icon-doc::before {
  width: 50%;
  height: 55%;
  top: 22%;
  left: 25%;
  border-radius: 4rpx;
}
.icon-doc::after {
  width: 30%;
  height: 3px;
  top: 35%;
  left: 35%;
  border-radius: 2rpx;
  box-shadow: 0 8rpx 0 var(--icon-color, var(--primary)), 0 16rpx 0 var(--icon-color, var(--primary));
}

/* ===== 提示/信息图标 ===== */
.icon-info::before {
  width: 50%;
  height: 50%;
  top: 25%;
  left: 25%;
  border-radius: 50%;
}
.icon-info::after {
  width: 3px;
  height: 22%;
  top: 42%;
  left: 50%;
  transform: translateX(-50%);
  border-radius: 2rpx;
  box-shadow: 0 -10rpx 0 var(--icon-color, var(--primary));
}

/* ===== 盒子/快递图标 ===== */
.icon-box::before {
  width: 55%;
  height: 42%;
  top: 32%;
  left: 22%;
  border-radius: 4rpx;
}
.icon-box::after {
  width: 55%;
  height: 3px;
  top: 32%;
  left: 22%;
  border-radius: 2rpx;
  box-shadow: 0 18rpx 0 var(--icon-color, var(--primary));
}

/* ===== 手机图标 ===== */
.icon-mobile::before {
  width: 42%;
  height: 60%;
  top: 20%;
  left: 29%;
  border-radius: 8rpx;
}
.icon-mobile::after {
  width: 12%;
  height: 4%;
  bottom: 24%;
  left: 44%;
  border-radius: 50%;
}

/* ===== 购物袋图标 ===== */
.icon-shop::before {
  width: 50%;
  height: 42%;
  top: 38%;
  left: 25%;
  border-radius: 6rpx;
}
.icon-shop::after {
  width: 26%;
  height: 22%;
  top: 20%;
  left: 37%;
  border-radius: 50% 50% 0 0;
  border: 3px solid;
  border-bottom: none;
  background: transparent !important;
}

/* ===== 房子图标 ===== */
.icon-home::before {
  width: 50%;
  height: 38%;
  top: 45%;
  left: 25%;
  border-radius: 4rpx;
}
.icon-home::after {
  width: 40%;
  height: 22%;
  top: 25%;
  left: 30%;
  border-radius: 4rpx;
}

/* ===== 公文包图标 ===== */
.icon-briefcase::before {
  width: 55%;
  height: 42%;
  top: 34%;
  left: 22%;
  border-radius: 6rpx;
}
.icon-briefcase::after {
  width: 22%;
  height: 12%;
  top: 26%;
  left: 39%;
  border-radius: 6rpx 6rpx 0 0;
}

/* ===== 钱币图标 ===== */
.icon-coin::before {
  width: 55%;
  height: 55%;
  top: 22%;
  left: 22%;
  border-radius: 50%;
}
.icon-coin::after {
  width: 25%;
  height: 25%;
  top: 37%;
  left: 37%;
  border-radius: 50%;
  background: var(--icon-bg, var(--primary-bg)) !important;
}

/* ===== 医疗十字图标 ===== */
.icon-medical::before {
  width: 20%;
  height: 55%;
  top: 22%;
  left: 40%;
  border-radius: 4rpx;
}
.icon-medical::after {
  width: 55%;
  height: 20%;
  top: 40%;
  left: 22%;
  border-radius: 4rpx;
}

/* ===== 盾牌图标 ===== */
.icon-shield::before {
  width: 50%;
  height: 55%;
  top: 20%;
  left: 25%;
  border-radius: 8rpx 8rpx 50% 50%;
}
.icon-shield::after {
  width: 20%;
  height: 20%;
  top: 38%;
  left: 40%;
  border-radius: 50%;
  background: var(--icon-bg, var(--primary-bg)) !important;
}

/* ===== 时钟图标 ===== */
.icon-clock::before {
  width: 55%;
  height: 55%;
  top: 22%;
  left: 22%;
  border-radius: 50%;
}
.icon-clock::after {
  width: 3px;
  height: 22%;
  top: 30%;
  left: 50%;
  transform: translateX(-50%);
  border-radius: 2rpx;
  box-shadow: 6rpx 10rpx 0 var(--icon-color, var(--primary));
}

/* ===== 对话框/反馈图标 ===== */
.icon-chat::before {
  width: 55%;
  height: 42%;
  top: 22%;
  left: 22%;
  border-radius: 8rpx;
}
.icon-chat::after {
  width: 18%;
  height: 15%;
  bottom: 24%;
  left: 30%;
  border-radius: 4rpx;
  transform: rotate(45deg);
}

/* ===== 大楼/企业图标 ===== */
.icon-building::before {
  width: 28%;
  height: 50%;
  top: 28%;
  left: 27%;
  border-radius: 4rpx 4rpx 0 0;
}
.icon-building::after {
  width: 28%;
  height: 40%;
  top: 38%;
  right: 27%;
  border-radius: 4rpx 4rpx 0 0;
}
