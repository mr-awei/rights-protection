/* ============================================================
   UI 统一组件样式（UI一致性规范）
   所有页面应优先使用以下公共类，保持视觉一致性
   ============================================================ */

/* ---------- 卡片 ---------- */
.ui-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* ---------- 按钮 ---------- */
.ui-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 32rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}

.ui-btn-primary {
  background: linear-gradient(135deg, #4A90D9 0%, #3A7BC8 100%);
  color: #FFFFFF;
}

.ui-btn-secondary {
  background: #E8F3FC;
  color: #4A90D9;
}

.ui-btn-block {
  display: flex;
  width: 100%;
}

.ui-btn-sm {
  padding: 10rpx 20rpx;
  font-size: 24rpx;
}

/* ---------- 导航栏 ---------- */
.ui-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: #FFFFFF;
  border-bottom: 1rpx solid #F5F5F5;
}

.ui-navbar-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
}

.ui-navbar-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
  flex: 1;
  text-align: center;
}

/* ---------- 文本样式 ---------- */
.ui-text-primary { color: #1A1A1A; font-size: 28rpx; }
.ui-text-secondary { color: #666666; font-size: 26rpx; }
.ui-text-tertiary { color: #999999; font-size: 24rpx; }
.ui-text-bold { font-weight: 700; }
.ui-text-primary-color { color: #4A90D9; }
.ui-text-danger { color: #FF4D4F; }
.ui-text-success { color: #52C41A; }

/* ---------- 间距工具类 ---------- */
.ui-mt-sm { margin-top: 16rpx; }
.ui-mt-md { margin-top: 24rpx; }
.ui-mt-lg { margin-top: 32rpx; }
.ui-mb-sm { margin-bottom: 16rpx; }
.ui-mb-md { margin-bottom: 24rpx; }
.ui-mb-lg { margin-bottom: 32rpx; }

/* ---------- 布局工具类 ---------- */
.ui-flex { display: flex; }
.ui-flex-center { display: flex; align-items: center; justify-content: center; }
.ui-flex-between { display: flex; align-items: center; justify-content: space-between; }
.ui-flex-1 { flex: 1; min-width: 0; }
.ui-flex-column { display: flex; flex-direction: column; }

/* ---------- 标签 ---------- */
.ui-tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.ui-tag-primary { background: #E8F3FC; color: #4A90D9; }
.ui-tag-success { background: #F6FFED; color: #52C41A; }
.ui-tag-warning { background: #FFFBE6; color: #FAAD14; }
.ui-tag-danger { background: #FFF1F0; color: #FF4D4F; }
.ui-tag-default { background: #F8F8F8; color: #666666; }

/* ---------- 分割线 ---------- */
.ui-divider {
  height: 1rpx;
  background: #F5F5F5;
  margin: 20rpx 0;
}

/* ---------- 空状态（已迁移到下方统一样式） ---------- */

/* ---------- 安全底部 ---------- */
.ui-safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}


/* 通用文字类 */
.text-base { font-size: 28rpx; }
.text-title { font-size: 32rpx; font-weight: 600; }
.text-large { font-size: 36rpx; font-weight: 600; }

/* ========== UI细节打磨：统一组件样式 ========== */

/* 统一卡片样式 */
.ui-card {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
}

.ui-card-hover {
  transition: all 0.2s ease;
}
.ui-card-hover:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-md);
}

/* 统一间距 */
.ui-mt-sm { margin-top: 12rpx; }
.ui-mt-md { margin-top: 20rpx; }
.ui-mt-lg { margin-top: 32rpx; }
.ui-mb-sm { margin-bottom: 12rpx; }
.ui-mb-md { margin-bottom: 20rpx; }
.ui-mb-lg { margin-bottom: 32rpx; }
.ui-px-sm { padding-left: 16rpx; padding-right: 16rpx; }
.ui-px-md { padding-left: 24rpx; padding-right: 24rpx; }
.ui-py-sm { padding-top: 16rpx; padding-bottom: 16rpx; }
.ui-py-md { padding-top: 24rpx; padding-bottom: 24rpx; }

/* 统一文字截断 */
.ui-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ui-ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* ========== 空状态样式 ========== */
.ui-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  text-align: center;
}

.ui-empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.4;
}

.ui-empty-title {
  font-size: 30rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
  font-weight: 500;
}

.ui-empty-desc {
  font-size: 26rpx;
  color: var(--text-tertiary);
  line-height: 1.6;
  margin-bottom: 32rpx;
}

.ui-empty-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 40rpx;
  background: var(--primary);
  color: var(--text-inverse);
  border-radius: var(--radius-full);
  font-size: 28rpx;
  font-weight: 500;
}

.ui-empty-action:active {
  opacity: 0.8;
}

/* ========== 加载状态样式 ========== */
.ui-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
}

.ui-loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid var(--border);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: ui-spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes ui-spin {
  to { transform: rotate(360deg); }
}

.ui-loading-text {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

/* 骨架屏加载 */
.ui-skeleton {
  background: linear-gradient(90deg, var(--bg-divider) 25%, var(--border-light) 50%, var(--bg-divider) 75%);
  background-size: 200% 100%;
  animation: ui-skeleton-loading 1.5s infinite;
  border-radius: var(--radius-sm);
}

@keyframes ui-skeleton-loading {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

.ui-skeleton-line {
  height: 24rpx;
  margin-bottom: 16rpx;
}

.ui-skeleton-title {
  height: 32rpx;
  width: 60%;
  margin-bottom: 20rpx;
}

.ui-skeleton-circle {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
}

/* ========== 标签/徽章样式 ========== */
.ui-tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-sm);
  font-size: 22rpx;
  line-height: 1.5;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.ui-tag-primary {
  background: var(--primary-bg);
  color: var(--primary);
}

.ui-tag-success {
  background: rgba(82, 196, 26, 0.1);
  color: var(--success);
}

.ui-tag-warning {
  background: rgba(250, 173, 20, 0.1);
  color: var(--warning);
}

.ui-tag-danger {
  background: rgba(255, 77, 79, 0.1);
  color: var(--danger);
}

.ui-tag-info {
  background: rgba(24, 144, 255, 0.1);
  color: var(--info);
}

.ui-tag-default {
  background: var(--bg-divider);
  color: var(--text-secondary);
}

/* ========== 分割线 ========== */
.ui-divider {
  height: 1rpx;
  background: var(--border);
  margin: 20rpx 0;
}

.ui-divider-light {
  height: 1rpx;
  background: var(--border-light);
  margin: 16rpx 0;
}

/* ========== 按钮统一样式 ========== */
.ui-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 32rpx;
  border-radius: var(--radius-md);
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.2s ease;
}

.ui-btn-primary {
  background: var(--primary);
  color: var(--text-inverse);
}

.ui-btn-primary:active {
  background: var(--primary-dark);
}

.ui-btn-outline {
  background: transparent;
  color: var(--primary);
  border: 2rpx solid var(--primary);
}

.ui-btn-outline:active {
  background: var(--primary-bg);
}

.ui-btn-text {
  background: transparent;
  color: var(--primary);
  padding: 8rpx 16rpx;
}

.ui-btn-disabled {
  opacity: 0.5;
  pointer-events: none;
}

/* ========== 列表项统一样式 ========== */
.ui-list-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: var(--bg-card);
  border-bottom: 1rpx solid var(--border-light);
  transition: background 0.2s ease;
}

.ui-list-item:active {
  background: var(--bg-hover);
}

.ui-list-item:last-child {
  border-bottom: none;
}

.ui-list-item-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.ui-list-item-content {
  flex: 1;
  min-width: 0;
}

.ui-list-item-title {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 500;
  margin-bottom: 6rpx;
}

.ui-list-item-desc {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.ui-list-item-arrow {
  color: var(--text-quaternary);
  font-size: 28rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

