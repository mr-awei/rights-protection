/* subpages/origin/origin.wxss */
.container {
  min-height: 100vh;
  background: var(--bg-page);
  display: flex;
  flex-direction: column;
}

/* 自定义导航栏 */
.nav-bar {
  background: linear-gradient(135deg, var(--primary-light) 0%, var(--primary) 50%, var(--primary-dark) 100%);
  padding-top: var(--status-bar-height, 44px);
  display: flex;
  align-items: center;
  height: calc(88rpx + var(--status-bar-height, 44px));
  position: sticky;
  top: 0;
  z-index: 100;
  flex-shrink: 0;
}

.nav-back {
  width: 80rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back text {
  font-size: 48rpx;
  color: var(--text-inverse);
  font-weight: 300;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: var(--font-xl);
  font-weight: 600;
  color: var(--text-inverse);
}

.nav-placeholder {
  width: 80rpx;
}

/* 内容区 */
.content {
  flex: 1;
  padding: 24rpx;
  overflow-y: auto;
  box-sizing: border-box;
}

/* 顶部引言 */
.hero-card {
  background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%);
  border-left: 6rpx solid #F59E0B;
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
}

.hero-quote {
  font-size: var(--font-lg);
  font-weight: 600;
  color: #92400E;
  line-height: 1.8;
  text-align: center;
}

/* 通用卡片 */
.section-card {
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.section-title {
  display: flex;
  align-items: center;
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 20rpx;
}

.section-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.section-body {
  display: flex;
  flex-direction: column;
}

.paragraph {
  font-size: var(--font-base);
  color: #555555;
  line-height: 1.9;
  margin-bottom: 18rpx;
  text-align: justify;
}

.paragraph:last-child {
  margin-bottom: 0;
}

.emphasis {
  font-weight: 600;
  color: var(--text-primary);
  margin-top: 8rpx;
}

.quote-line {
  font-weight: 600;
  color: #166534;
  background: #F0FDF4;
  padding: 20rpx;
  border-radius: 12rpx;
  border-left: 4rpx solid #22C55E;
  margin-top: 8rpx;
}

/* 法律提醒 */
.warn-card {
  background: linear-gradient(135deg, #FEF2F2 0%, #FEE2E2 100%);
  border: 1rpx solid #FECACA;
  border-left: 6rpx solid #DC2626;
}

.warn-text {
  color: #7F1D1D;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.warn-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.warn-item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 12rpx;
}

.warn-icon {
  width: 36rpx;
  height: 36rpx;
  background: #DC2626;
  color: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-sm);
  font-weight: 700;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.warn-item-text {
  flex: 1;
  font-size: var(--font-base);
  color: #7F1D1D;
  line-height: 1.7;
  text-align: justify;
}

/* 结尾 */
.footer-card {
  background: linear-gradient(135deg, #EFF6FF 0%, #DBEAFE 100%);
  border: 1rpx solid #BFDBFE;
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  text-align: center;
}

.footer-text {
  font-size: var(--font-lg);
  font-weight: 700;
  color: #1E40AF;
  display: block;
  margin-bottom: 12rpx;
}

.footer-sub {
  font-size: var(--font-base);
  color: #1D4ED8;
  display: block;
}
