/* subpages/origin/origin.wxss */
.container {
  min-height: 100vh;
  background: var(--bg-page);
  display: flex;
  flex-direction: column;
}

/* 自定义导航栏 */
.nav-bar {
  background: linear-gradient(135deg, var(--primary-light) 0%, var(--primary) 50%, var(--primary-dark) 100%);
  padding-top: var(--status-bar-height, 44px);
  display: flex;
  align-items: center;
  height: calc(88rpx + var(--status-bar-height, 44px));
  position: sticky;
  top: 0;
  z-index: 100;
  flex-shrink: 0;
}

.nav-back {
  width: 80rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back text {
  font-size: 48rpx;
  color: var(--text-inverse);
  font-weight: 300;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: var(--font-xl);
  font-weight: 600;
  color: var(--text-inverse);
}

.nav-placeholder {
  width: 80rpx;
}

/* 内容区 */
.content {
  flex: 1;
  padding: 24rpx 24rpx 48rpx;
  overflow-y: auto;
  box-sizing: border-box;
}

/* ========== 顶部引言 ========== */
.hero-card {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #5B9BD5 0%, #4A90D9 45%, #2E6DB4 100%);
  border-radius: 24rpx;
  padding: 46rpx 36rpx 48rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(74, 144, 217, 0.28);
}

.hero-card::before {
  content: '';
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 260rpx;
  height: 260rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.2) 0%, transparent 70%);
  border-radius: 50%;
}

.hero-card::after {
  content: '';
  position: absolute;
  left: 40rpx;
  right: 40rpx;
  bottom: 24rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
}

.hero-mark {
  position: absolute;
  top: -16rpx;
  left: 18rpx;
  font-size: 160rpx;
  line-height: 1;
  color: rgba(255, 255, 255, 0.16);
  font-family: Georgia, 'Times New Roman', serif;
}

.hero-quote {
  position: relative;
  z-index: 1;
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  line-height: 1.85;
  letter-spacing: 1rpx;
  text-align: justify;
}

/* ========== 通用卡片 ========== */
.section-card {
  background: var(--bg-card);
  border-radius: 24rpx;
  padding: 30rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 18rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.section-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 14rpx;
  margin-right: 16rpx;
}

.section-body {
  display: flex;
  flex-direction: column;
}

/* ========== 正文段落 ========== */
.paragraph {
  display: block;
  font-size: 26rpx;
  color: #475569;
  line-height: 1.95;
  margin-bottom: 22rpx;
  text-align: justify;
  letter-spacing: 0.5rpx;
}

.paragraph:last-child {
  margin-bottom: 0;
}

/* 引出句：浅蓝标签式，突出「第一句 / 第二句」 */
.paragraph.lead {
  font-size: 27rpx;
  font-weight: 700;
  color: var(--primary-dark);
  background: linear-gradient(135deg, #F0F7FF 0%, #E6F0FB 100%);
  border-left: 6rpx solid var(--primary);
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  line-height: 1.6;
  text-align: left;
  letter-spacing: 0;
  margin: 4rpx 0 22rpx;
}

/* ========== 想传递的态度 ========== */
.attitude-item {
  background: #F8FAFC;
  border-radius: 16rpx;
  border-left: 6rpx solid var(--primary);
  padding: 22rpx 24rpx;
  margin-bottom: 18rpx;
}

.attitude-item:last-child {
  margin-bottom: 0;
}

.attitude-title {
  display: block;
  font-size: 27rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.attitude-title-warm {
  color: #B45309;
}

.attitude-title-force {
  color: #1D4ED8;
}

.attitude-title-bound {
  color: #047857;
}

.attitude-text {
  display: block;
  font-size: 25rpx;
  color: #475569;
  line-height: 1.9;
  text-align: justify;
}

/* ========== 引用行 ========== */
.quote-line {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #166534;
  background: linear-gradient(135deg, #F0FDF4 0%, #DCFCE7 100%);
  padding: 26rpx 28rpx 26rpx 32rpx;
  border-radius: 16rpx;
  border-left: 6rpx solid #22C55E;
  margin-top: 12rpx;
  line-height: 1.8;
  letter-spacing: 0.5rpx;
  text-align: justify;
}

/* ========== 法律提醒 ========== */
.warn-card {
  background: linear-gradient(135deg, #FEF2F2 0%, #FEE2E2 100%);
  border: 1rpx solid #FECACA;
  border-left: 6rpx solid #DC2626;
  box-shadow: 0 4rpx 18rpx rgba(220, 38, 38, 0.1);
}

.warn-card .section-title {
  color: #7F1D1D;
  border-bottom-color: rgba(220, 38, 38, 0.15);
}

.warn-text {
  display: block;
  font-size: 26rpx;
  color: #7F1D1D;
  font-weight: 500;
  line-height: 1.85;
  margin-bottom: 20rpx;
  text-align: justify;
}

.warn-list {
  display: flex;
  flex-direction: column;
}

.warn-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 14rpx;
  margin-bottom: 14rpx;
}

.warn-item:last-child {
  margin-bottom: 0;
}

.warn-icon {
  width: 36rpx;
  height: 36rpx;
  background: linear-gradient(135deg, #EF4444 0%, #DC2626 100%);
  color: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-sm);
  font-weight: 700;
  flex-shrink: 0;
  margin-right: 16rpx;
  line-height: 1;
}

.warn-item-text {
  flex: 1;
  font-size: 25rpx;
  color: #7F1D1D;
  line-height: 1.8;
  text-align: justify;
}

/* ========== 心里话 ========== */
.heart-card {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #FFFBEB 0%, #FEF3C7 55%, #FDE68A 100%);
  border: 1rpx solid #FDE68A;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 22rpx rgba(245, 158, 11, 0.14);
}

.heart-mark {
  position: absolute;
  top: -14rpx;
  right: 20rpx;
  font-size: 160rpx;
  line-height: 1;
  color: rgba(217, 119, 6, 0.13);
  font-family: Georgia, 'Times New Roman', serif;
}

.heart-head {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  position: relative;
  z-index: 1;
}

.heart-head .section-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  margin-right: 12rpx;
}

.heart-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #B45309;
  letter-spacing: 0.5rpx;
}

.heart-text {
  position: relative;
  z-index: 1;
  display: block;
  font-size: 26rpx;
  color: #92400E;
  line-height: 1.9;
  text-align: justify;
  letter-spacing: 0.5rpx;
}

/* ========== 结尾 ========== */
.footer-card {
  background: linear-gradient(135deg, #EFF6FF 0%, #DBEAFE 100%);
  border: 1rpx solid #BFDBFE;
  border-radius: 24rpx;
  padding: 44rpx 32rpx;
  text-align: center;
  box-shadow: 0 6rpx 22rpx rgba(59, 130, 246, 0.12);
}

.footer-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin: 0 auto 18rpx;
}

.footer-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #1E40AF;
  display: block;
  margin-bottom: 10rpx;
  letter-spacing: 1rpx;
}

.footer-sub {
  font-size: 25rpx;
  color: #1D4ED8;
  display: block;
  line-height: 1.7;
}
