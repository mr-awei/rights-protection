/* subpages/settings/settings.wxss */
.container {
  min-height: 100vh;
  background: #F5F7FA;
  padding: 24rpx;
  padding-bottom: 60rpx;
}

.section {
  background: var(--bg-card);
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.section-header {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx 20rpx;
}

.section-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.section-info {
  flex: 1;
}

.section-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: #1A1B1C;
  display: block;
}

.section-desc {
  font-size: var(--font-base);
  color: #86909C;
  margin-top: 4rpx;
  display: block;
}

.section-title-only {
  font-size: var(--font-md);
  font-weight: 600;
  color: #86909C;
  padding: 20rpx 24rpx 12rpx;
}


/* 设置列表 */
.setting-list {
  padding: 0 24rpx;
}

.setting-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #F2F3F5;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-item-hover {
  opacity: 0.7;
}

.item-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.item-info {
  flex: 1;
}

.item-name {
  font-size: var(--font-normal);
  font-weight: 500;
  color: #1A1B1C;
  display: block;
}

.item-desc {
  font-size: var(--font-base);
  color: #86909C;
  margin-top: 4rpx;
  display: block;
}

.item-arrow {
  font-size: var(--font-xl);
  color: #C9CDD4;
  margin-left: 12rpx;
}

.item-tag {
  font-size: var(--font-sm);
  color: #86909C;
  background: #F2F3F5;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-left: 12rpx;
}

/* 数据信息卡片 */
.data-info-card {
  padding: 0 24rpx;
}

.data-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F2F3F5;
}

.data-row:last-child {
  border-bottom: none;
}

.data-label {
  font-size: var(--font-md);
  color: #86909C;
}

.data-value {
  font-size: var(--font-md);
  font-weight: 500;
  color: #1A1B1C;
}

/* 底部 */
.footer {
  text-align: center;
  padding: 40rpx 0 20rpx;
}

.footer-text {
  display: block;
  font-size: var(--font-sm);
  color: #C9CDD4;
  line-height: 1.8;
}

/* ========== 更新日志弹窗 ========== */
.changelog-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: relative;
  width: 620rpx;
  max-height: 80vh;
  background: var(--bg-card);
  border-radius: 24rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal-header {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  padding: 40rpx 32rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.modal-header::before {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.modal-header::after {
  content: '';
  position: absolute;
  bottom: -50rpx;
  left: -30rpx;
  width: 160rpx;
  height: 160rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}

.modal-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  position: relative;
  z-index: 1;
}

.modal-icon {
  font-size: var(--font-3xl);
  color: var(--text-inverse);
  --icon-color: var(--text-inverse);
  --icon-bg: transparent;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-inverse);
  margin-bottom: 8rpx;
  position: relative;
  z-index: 1;
  text-align: center;
}

.modal-subtitle {
  font-size: var(--font-base);
  color: rgba(255, 255, 255, 0.85);
  position: relative;
  z-index: 1;
}

.modal-body {
  padding: 28rpx 28rpx 20rpx;
  flex: 1;
  overflow-y: auto;
}

.changelog-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
  padding: 14rpx;
  background: #F0F7FF;
  border-radius: 12rpx;
}

.changelog-item:last-child {
  margin-bottom: 0;
}

.changelog-item .item-num {
  width: 36rpx;
  height: 36rpx;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  color: var(--text-inverse);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-xs);
  font-weight: 600;
  flex-shrink: 0;
  margin-right: 14rpx;
}

.changelog-item .item-text {
  flex: 1;
  font-size: var(--font-md);
  color: #555555;
  line-height: 1.6;
}

.modal-footer {
  padding: 20rpx 28rpx 28rpx;
  border-top: 1rpx solid #F0F0F0;
}

.modal-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  color: var(--text-inverse);
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-lg);
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(74, 144, 217, 0.3);
}

.modal-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}
