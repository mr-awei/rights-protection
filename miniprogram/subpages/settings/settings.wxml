<!--subsubsubpages/settings/settings.wxml-->
<view class="container">
  <!-- 通用设置 -->
  <view class="section">
    <view class="section-title-only">通用</view>
    <view class="setting-list">
      <list-item icon="icon-info" icon-bg="#ECFDF5" icon-color="#10B981" title="关于我们" desc="版本信息、功能介绍" bind:tap="onAboutTap"></list-item>
      <list-item icon="icon-shield" icon-bg="#FEF2F2" icon-color="#EF4444" title="免责声明" desc="使用须知与法律边界" bind:tap="onDisclaimerTap"></list-item>
      <list-item icon="icon-clock" icon-bg="#FFFBEB" icon-color="#F59E0B" title="更新日志" desc="查看本次更新了什么" bind:tap="onChangelogTap"></list-item>
    </view>
  </view>

  <!-- 数据信息 -->
  <view class="section">
    <view class="section-title-only">数据信息</view>
    <view class="data-info-card">
      <view class="data-row">
        <text class="data-label">应用版本</text>
        <text class="data-value">{{appVersion}}</text>
      </view>
      <view class="data-row">
        <text class="data-label">数据版本</text>
        <text class="data-value">{{dataVersion}}</text>
      </view>
      <view class="data-row">
        <text class="data-label">数据验证日期</text>
        <text class="data-value">{{dataVerifiedAt}}</text>
      </view>
      <view class="data-row">
        <text class="data-label">官方渠道</text>
        <text class="data-value">{{channelCount}} 条</text>
      </view>
      <view class="data-row">
        <text class="data-label">投诉话术</text>
        <text class="data-value">{{scriptCount}} 条</text>
      </view>
      <view class="data-row">
        <text class="data-label">法律法规</text>
        <text class="data-value">{{lawCount}} 条</text>
      </view>
    </view>
  </view>

  <!-- 底部 -->
  <view class="footer">
    <text class="footer-text">© 2026 消费维权信息助手</text>
    <text class="footer-text">数据仅供参考，以官方平台为准</text>
  </view>

  <!-- 更新日志自定义弹窗 -->
  <view class="changelog-modal" wx:if="{{showChangelog}}">
    <view class="modal-mask" bindtap="onCloseChangelog"></view>
    <view class="modal-content">
      <view class="modal-header">
        <view class="modal-icon-wrap">
          <view class="modal-icon app-icon app-icon-default icon-clock"></view>
        </view>
        <text class="modal-title">{{changelogData.title}}</text>
        <text class="modal-subtitle">版本 {{changelogData.version}} · {{changelogData.date}}</text>
      </view>
      <view class="modal-body">
        <view class="changelog-item" wx:for="{{changelogData.items}}" wx:key="index">
          <view class="item-num">{{index + 1}}</view>
          <view class="item-text">{{item}}</view>
        </view>
      </view>
      <view class="modal-footer">
        <view class="modal-btn" bindtap="onCloseChangelog">知道了</view>
      </view>
    </view>
  </view>
</view>
