/* media-exposure.wxss */
.container {
  min-height: 100vh;
  background: #F5F7FA;
}

.gradient-header {
  background: #FFFFFF;
  padding: 40rpx 32rpx 48rpx;
  border-bottom: 1rpx solid #F2F3F5;
}

.header-content {
  display: flex;
  flex-direction: column;
}

.header-title-row {
  display: flex;
  align-items: center;
}

.header-badge {
  margin-right: 16rpx;
}

.header-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #1D2129;
}

.header-sub {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #86909C;
  line-height: 1.6;
}

.content {
  padding: 24rpx 24rpx 0;
}

.section {
  margin-bottom: 28rpx;
}

.section-header {
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D2129;
}

/* 通用信息卡片 */
.info-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.info-text {
  display: block;
  font-size: 26rpx;
  color: #4E5969;
  line-height: 1.6;
}

.kv-item {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F2F3F5;
}

.kv-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.kv-label {
  width: 140rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: #86909C;
  margin-right: 16rpx;
}

.kv-value {
  flex: 1;
  font-size: 26rpx;
  color: #4E5969;
  line-height: 1.6;
}

/* 可选渠道 / 媒体列表 */
.channel-list {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 12rpx 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.channel-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F2F3F5;
}

.channel-item:last-child {
  border-bottom: none;
}

.channel-name-row {
  display: flex;
  align-items: center;
}

.channel-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #86909C;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.channel-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D2129;
}

.channel-desc {
  display: block;
  font-size: 24rpx;
  color: #86909C;
  margin-top: 6rpx;
  line-height: 1.5;
}

.media-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F2F3F5;
}

.media-row:last-child {
  border-bottom: none;
}

.media-row-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.media-row-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D2129;
  flex: 1;
  min-width: 0;
}

.media-row-scope {
  font-size: 20rpx;
  color: #4E5969;
  background: #F2F3F5;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.media-row-meta {
  display: block;
  font-size: 24rpx;
  color: #86909C;
  line-height: 1.5;
}

.media-row-contact {
  display: block;
  font-size: 25rpx;
  color: #4E5969;
  line-height: 1.6;
  margin-top: 4rpx;
}

.media-row-social {
  display: block;
  font-size: 25rpx;
  color: #165DFF;
  line-height: 1.6;
  margin-top: 4rpx;
}

.bullet-list {
  margin-top: 12rpx;
}

.bullet-item {
  display: flex;
  align-items: flex-start;
  padding: 6rpx 0;
}

.bullet-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #86909C;
  margin-right: 12rpx;
  margin-top: 12rpx;
  flex-shrink: 0;
}

.bullet-text {
  flex: 1;
  font-size: 25rpx;
  color: #4E5969;
  line-height: 1.6;
}


