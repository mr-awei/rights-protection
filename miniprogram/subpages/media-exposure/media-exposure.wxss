/* media-exposure.wxss */
.container {
  min-height: 100vh;
  background: #F5F7FA;
}

.gradient-header {
  background: linear-gradient(135deg, #FA8C16 0%, #FFA940 100%);
  padding: 40rpx 32rpx 48rpx;
}

.header-content {
  display: flex;
  flex-direction: column;
}

.header-title-row {
  display: flex;
  align-items: center;
}

.header-badge {
  margin-right: 16rpx;
}

.header-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.header-sub {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.6;
}

.content {
  padding: 24rpx 24rpx 0;
}

.section {
  margin-bottom: 28rpx;
}

.section-header {
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D2129;
}

/* 通用信息卡片 */
.info-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.info-text {
  display: block;
  font-size: 26rpx;
  color: #4E5969;
  line-height: 1.6;
}

.kv-item {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F2F3F5;
}

.kv-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.kv-label {
  width: 140rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: #86909C;
  margin-right: 16rpx;
}

.kv-value {
  flex: 1;
  font-size: 26rpx;
  color: #4E5969;
  line-height: 1.6;
}

/* 可选渠道 */
.channel-list {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.channel-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F2F3F5;
}

.channel-item:last-child {
  border-bottom: none;
}

.channel-name-row {
  display: flex;
  align-items: center;
}

.channel-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #FA8C16;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.channel-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D2129;
}

.channel-desc {
  display: block;
  font-size: 24rpx;
  color: #86909C;
  margin-top: 6rpx;
  line-height: 1.5;
}

/* 本渠道注意 */
.notice-card {
  background: #FFF7E6;
  border: 1rpx solid #FFE0B2;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
}

.notice-item {
  display: flex;
  align-items: flex-start;
  padding: 10rpx 0;
}

.notice-dot {
  color: #FA8C16;
  font-size: 26rpx;
  margin-right: 12rpx;
  line-height: 1.6;
  flex-shrink: 0;
}

.notice-text {
  flex: 1;
  font-size: 26rpx;
  color: #614700;
  line-height: 1.6;
}

/* 推荐顺序提示 */
.tip-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.tip-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1D2129;
  margin-bottom: 10rpx;
}

.tip-text {
  display: block;
  font-size: 25rpx;
  color: #4E5969;
  line-height: 1.6;
}
