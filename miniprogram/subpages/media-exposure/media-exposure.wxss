/* media-exposure.wxss */
.container {
  min-height: 100vh;
  background: #F5F7FA;
}

.gradient-header {
  background: linear-gradient(135deg, #FA8C16 0%, #FFA940 100%);
  padding: 40rpx 32rpx 48rpx;
}

.header-content {
  display: flex;
  flex-direction: column;
}

.header-title-row {
  display: flex;
  align-items: center;
}

.header-badge {
  margin-right: 16rpx;
}

.header-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.header-sub {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.6;
}

.content {
  padding: 24rpx 24rpx 0;
}

.section {
  margin-bottom: 28rpx;
}

.section-header {
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D2129;
}

/* 合规边界卡片 */
.compliance-card {
  background: #FFF7E6;
  border: 1rpx solid #FFE0B2;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
}

.compliance-item {
  display: flex;
  align-items: flex-start;
  padding: 10rpx 0;
}

.compliance-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #FA8C16;
  margin-top: 12rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.compliance-text {
  flex: 1;
  font-size: 26rpx;
  color: #614700;
  line-height: 1.6;
}

/* 媒体卡片 */
.media-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.media-card-head {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.media-head-text {
  display: flex;
  flex-direction: column;
  margin-left: 16rpx;
}

.media-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1D2129;
}

.media-type {
  font-size: 22rpx;
  color: #FA8C16;
  margin-top: 4rpx;
}

.media-desc {
  font-size: 26rpx;
  color: #4E5969;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.media-block {
  margin-bottom: 16rpx;
}

.media-block-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #1D2129;
  margin-bottom: 8rpx;
}

.media-block-text {
  display: block;
  font-size: 25rpx;
  color: #4E5969;
  line-height: 1.6;
}

.submission-item {
  display: flex;
  align-items: flex-start;
  padding: 6rpx 0;
}

.submission-label {
  font-size: 25rpx;
  color: #86909C;
  width: 140rpx;
  flex-shrink: 0;
}

.submission-value {
  flex: 1;
  font-size: 25rpx;
  color: #4E5969;
  line-height: 1.6;
}

.media-url {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: #F5F7FA;
  border-radius: 12rpx;
}

.media-url-text {
  flex: 1;
  font-size: 24rpx;
  color: #4A90D9;
  line-height: 1.5;
}

.media-url-copy {
  font-size: 24rpx;
  color: #4A90D9;
  margin-left: 16rpx;
  flex-shrink: 0;
}
