/* media-exposure.wxss */
.container {
  min-height: 100vh;
  background: var(--bg-page);
}

/* ========== 渐变头部（与其他页一致） ========== */
.gradient-header {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  padding: 40rpx 32rpx 48rpx;
}

.header-content {
  display: flex;
  flex-direction: column;
}

.header-title-row {
  display: flex;
  align-items: center;
}

.header-badge {
  margin-right: 16rpx;
}

.header-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.header-sub {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.6;
}

.content {
  padding: 24rpx 24rpx 0;
}

.section {
  margin-bottom: 28rpx;
}

.section-header {
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* ========== 通用信息卡片 ========== */
.info-card {
  background: var(--bg-card);
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.info-text {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.kv-item {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--bg-divider);
}

.kv-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.kv-label {
  width: 140rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--text-tertiary);
  margin-right: 16rpx;
}

.kv-value {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

/* ========== 媒体列表 ========== */
.channel-list {
  background: var(--bg-card);
  border-radius: 24rpx;
  padding: 12rpx 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.media-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--bg-divider);
}

.media-row:last-child {
  border-bottom: none;
}

.media-row-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.media-row-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  flex: 1;
  min-width: 0;
}

.media-row-scope {
  font-size: 20rpx;
  color: var(--primary);
  background: var(--primary-bg);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.media-row-contact {
  display: block;
  font-size: 25rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-top: 4rpx;
}

.media-row-social {
  display: block;
  font-size: 25rpx;
  color: var(--primary);
  line-height: 1.6;
  margin-top: 4rpx;
}

/* ========== bullet 列表 ========== */
.bullet-list {
  margin-top: 12rpx;
}

.bullet-item {
  display: flex;
  align-items: flex-start;
  padding: 6rpx 0;
}

.bullet-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--text-tertiary);
  margin-right: 12rpx;
  margin-top: 12rpx;
  flex-shrink: 0;
}

.bullet-text {
  flex: 1;
  font-size: 25rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

/* ========== 重点提示卡（法律兜底 / 合规边界） ========== */
.legal-notice-card {
  background: linear-gradient(135deg, #FEF2F2 0%, #FEE2E2 100%);
  border: 1rpx solid #FECACA;
  border-left: 6rpx solid var(--danger);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-top: 16rpx;
}

.legal-notice-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.legal-notice-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.legal-notice-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--danger);
}

.legal-notice-text {
  display: block;
  font-size: 25rpx;
  color: #7F1D1D;
  line-height: 1.7;
}

.legal-notice-card .bullet-item {
  padding: 4rpx 0;
}

.legal-notice-card .bullet-dot {
  background: var(--danger);
}

.legal-notice-card .bullet-text {
  font-size: 25rpx;
  color: #7F1D1D;
  line-height: 1.7;
}
