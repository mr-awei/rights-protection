<!--media-exposure.wxml-->
<view class="container">
  <!-- 头部 -->
  <view class="gradient-header">
    <view class="header-content">
      <view class="header-title-row">
        <view class="header-badge app-icon app-icon-default icon-broadcast" style="width:44rpx;height:44rpx;--icon-bg:rgba(255,255,255,0.2);--icon-color:#fff;"></view>
        <text class="header-title">媒体曝光</text>
      </view>
      <text class="header-sub">第四条维权路径：舆论监督 / 社会监督，作为官方渠道之外的补充手段</text>
    </view>
  </view>

  <view class="content">
    <!-- 适用场景 -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">适用场景</text>
      </view>
      <view class="info-card">
        <text class="info-text">{{guide.scope}}</text>
      </view>
    </view>

    <!-- 投稿方式 -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">投稿方式</text>
      </view>
      <view class="info-card">
        <view class="kv-item" wx:for="{{guide.submission}}" wx:key="label" wx:for-item="sub">
          <text class="kv-label">{{sub.label}}</text>
          <text class="kv-value">{{sub.value}}</text>
        </view>
      </view>
    </view>

    <!-- 可选渠道 -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">可选渠道</text>
      </view>
      <view class="channel-list">
        <view class="channel-item" wx:for="{{guide.channels}}" wx:key="name">
          <view class="channel-name-row">
            <text class="channel-dot"></text>
            <text class="channel-name">{{item.name}}</text>
          </view>
          <text class="channel-desc" wx:if="{{item.desc}}">{{item.desc}}</text>
        </view>
      </view>
    </view>

    <!-- 本渠道注意 -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">本渠道注意</text>
      </view>
      <view class="notice-card">
        <view class="notice-item" wx:for="{{guide.compliance}}" wx:key="*this">
          <text class="notice-dot">·</text>
          <text class="notice-text">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 投稿所需材料清单 + 自检表 -->
    <view class="section">
      <materials-checklist materials="{{guide.materials}}" title="投稿所需材料清单"></materials-checklist>
    </view>

    <!-- 提示 -->
    <view class="section">
      <view class="tip-card">
        <text class="tip-title">推荐顺序</text>
        <text class="tip-text">优先走企业投诉 → 监管投诉 → 法律途径；以上渠道已穷尽或事件具有公共性、典型性时，再考虑媒体曝光。</text>
      </view>
    </view>

    <view style="height: 60rpx;"></view>
  </view>
</view>
