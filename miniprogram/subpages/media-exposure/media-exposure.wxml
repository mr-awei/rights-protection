<!--media-exposure.wxml-->
<view class="container">
  <!-- 头部 -->
  <view class="gradient-header">
    <view class="header-content">
      <view class="header-title-row">
        <view class="header-badge app-icon app-icon-default icon-broadcast" style="width:44rpx;height:44rpx;--icon-bg:rgba(255,255,255,0.2);--icon-color:#fff;"></view>
        <text class="header-title">媒体曝光</text>
      </view>
      <text class="header-sub">舆论监督 / 社会监督：企业、平台、监管、法律渠道穷尽后的补充手段。法律永远是最后兜底。</text>
    </view>
  </view>

  <view class="content">
    <!-- 推荐顺序 -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">推荐顺序</text>
      </view>
      <view class="tip-card tip-primary">
        <text class="tip-text">{{guide.order}}</text>
      </view>
    </view>

    <!-- 适用场景 -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">适用场景</text>
      </view>
      <view class="info-card">
        <text class="info-text">{{guide.scopeDesc}}</text>
        <view class="bullet-list">
          <view class="bullet-item" wx:for="{{guide.scopeItems}}" wx:key="*this">
            <text class="bullet-dot"></text>
            <text class="bullet-text">{{item}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 投稿方式 -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">投稿方式</text>
      </view>
      <view class="info-card">
        <view class="kv-item" wx:for="{{guide.submission}}" wx:key="label" wx:for-item="sub">
          <text class="kv-label">{{sub.label}}</text>
          <text class="kv-value">{{sub.value}}</text>
        </view>
      </view>
    </view>

    <!-- 主流媒体及民生栏目爆料渠道 -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">主流媒体及民生栏目爆料渠道</text>
      </view>
      <view class="channel-list">
        <view class="media-row" wx:for="{{guide.mainstream}}" wx:key="name">
          <view class="media-row-head">
            <text class="media-row-name">{{item.name}}</text>
            <text class="media-row-scope" wx:if="{{item.scope}}">{{item.scope}}</text>
          </view>
          <text class="media-row-contact" selectable="true">{{item.contact}}</text>
          <text class="media-row-social" wx:if="{{item.social}}" selectable="true">官方账号：{{item.social}}</text>
        </view>
      </view>
    </view>

    <!-- 本渠道注意 -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">本渠道注意</text>
      </view>
      <view class="notice-card">
        <view class="notice-item" wx:for="{{guide.compliance}}" wx:key="*this">
          <text class="notice-dot">·</text>
          <text class="notice-text">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 投稿所需材料清单 + 自检表 -->
    <view class="section">
      <materials-checklist materials="{{guide.materials}}" title="投稿所需材料清单"></materials-checklist>
    </view>

    <view style="height: 60rpx;"></view>
  </view>
</view>
