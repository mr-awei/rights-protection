/* subpages/disclaimer/disclaimer.wxss */
.container {
  min-height: 100vh;
  background: var(--bg-page);
  display: flex;
  flex-direction: column;
}

/* 自定义导航栏 */
.nav-bar {
  background: linear-gradient(135deg, var(--primary-light) 0%, var(--primary) 50%, var(--primary-dark) 100%);
  padding-top: var(--status-bar-height, 44px);
  display: flex;
  align-items: center;
  height: calc(88rpx + var(--status-bar-height, 44px));
  position: sticky;
  top: 0;
  z-index: 100;
  flex-shrink: 0;
}

.nav-back {
  width: 80rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back text {
  font-size: 48rpx;
  color: var(--text-inverse);
  font-weight: 300;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: var(--font-xl);
  font-weight: 600;
  color: var(--text-inverse);
}

.nav-placeholder {
  width: 80rpx;
}

/* 内容区 */
.content {
  flex: 1;
  padding: 24rpx;
  overflow-y: auto;
  box-sizing: border-box;
}

/* 顶部提示 */
.hero-card {
  background: linear-gradient(135deg, var(--primary-light) 0%, var(--primary) 50%, var(--primary-dark) 100%);
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  margin-bottom: 24rpx;
  position: relative;
  overflow: hidden;
}

.hero-card::before {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
  border-radius: 50%;
}

.hero-icon {
  width: 96rpx;
  height: 96rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20rpx;
  font-size: var(--font-3xl);
  color: var(--text-inverse);
  --icon-color: var(--text-inverse);
  --icon-bg: transparent;
  position: relative;
  z-index: 1;
}

.hero-title {
  font-size: var(--font-2xl);
  font-weight: 700;
  color: var(--text-inverse);
  margin-bottom: 16rpx;
  position: relative;
  z-index: 1;
}

.hero-desc {
  font-size: var(--font-base);
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.7;
  position: relative;
  z-index: 1;
}

/* 通用卡片 */
.section-card {
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.section-title {
  display: flex;
  align-items: center;
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 20rpx;
}

.section-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.section-body {
  display: flex;
  flex-direction: column;
}

.paragraph {
  font-size: var(--font-base);
  color: #555555;
  line-height: 1.8;
  margin-bottom: 16rpx;
  text-align: justify;
}

.paragraph:last-child {
  margin-bottom: 0;
}

/* 规则列表 */
.rule-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 8rpx;
}

.rule-item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx;
  background: #F8FAFC;
  border-radius: 12rpx;
}

.rule-num {
  width: 40rpx;
  height: 40rpx;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  color: var(--text-inverse);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-sm);
  font-weight: 600;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.rule-text {
  flex: 1;
  font-size: var(--font-base);
  color: #555555;
  line-height: 1.7;
}

/* 法律边界高亮卡片 */
.warn-card {
  background: linear-gradient(135deg, #FEF2F2 0%, #FEE2E2 100%);
  border: 1rpx solid #FECACA;
  border-left: 6rpx solid #DC2626;
}

.warn-text {
  color: #7F1D1D;
  font-weight: 500;
}

.law-list {
  display: flex;
  flex-direction: column;
  margin-top: 16rpx;
}

.law-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(220, 38, 38, 0.08);
}

.law-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.law-marker {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #DC2626;
  margin-right: 16rpx;
  margin-top: 10rpx;
  flex-shrink: 0;
}

.law-title {
  font-size: var(--font-normal);
  font-weight: 600;
  color: #7F1D1D;
  margin-bottom: 8rpx;
}

.law-desc {
  font-size: var(--font-base);
  color: #555555;
  line-height: 1.7;
  text-align: justify;
}

/* 底部强调 */
.footer-card {
  background: linear-gradient(135deg, #F0FDF4 0%, #DCFCE7 100%);
  border: 1rpx solid #BBF7D0;
  border-radius: 20rpx;
  padding: 32rpx;
  text-align: center;
}

.footer-text {
  font-size: var(--font-lg);
  font-weight: 700;
  color: #166534;
  line-height: 1.6;
  display: block;
  margin-bottom: 8rpx;
}

.footer-sub {
  font-size: var(--font-sm);
  color: #15803D;
  display: block;
}
