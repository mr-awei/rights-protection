/* subpages/about/about.wxss */
.container {
  min-height: 100vh;
  background: var(--bg-page);
}

/* 自定义导航栏 */
.nav-bar {
  background: linear-gradient(135deg, var(--primary-light) 0%, var(--primary) 50%, var(--primary-dark) 100%);
  padding-top: var(--status-bar-height, 44px);
  display: flex;
  align-items: center;
  height: calc(88rpx + var(--status-bar-height, 44px));
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-back {
  width: 80rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back text {
  font-size: 48rpx;
  color: var(--text-inverse);
  font-weight: 300;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: var(--font-xl);
  font-weight: 600;
  color: var(--text-inverse);
}

.nav-placeholder {
  width: 80rpx;
}

/* 内容区 */
.content {
  padding: 24rpx;
}

/* 应用信息 */
.app-info {
  background: linear-gradient(135deg, var(--primary-light) 0%, var(--primary) 50%, var(--primary-dark) 100%);
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  margin-bottom: 24rpx;
  position: relative;
  overflow: hidden;
}

.app-info::before {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
  border-radius: 50%;
}

.app-logo {
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 24rpx;
  border-radius: 36rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.15);
  border: 4rpx solid rgba(255,255,255,0.3);
}

.app-logo image {
  width: 100%;
  height: 100%;
}

.app-name {
  font-size: var(--font-3xl);
  font-weight: 800;
  color: var(--text-inverse);
  margin-bottom: 8rpx;
  position: relative;
  z-index: 1;
}

.app-slogan {
  font-size: var(--font-md);
  color: rgba(255,255,255,0.9);
  margin-bottom: 16rpx;
  position: relative;
  z-index: 1;
}

.app-version {
  font-size: var(--font-sm);
  color: rgba(255,255,255,0.7);
  background: rgba(255,255,255,0.15);
  padding: 6rpx 20rpx;
  border-radius: 12rpx;
  display: inline-block;
  position: relative;
  z-index: 1;
}

/* 通用卡片 */
.stats-card,
.feature-card,
.link-card,
.philosophy-card {
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.card-title {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 20rpx;
}

/* 数据统计 */
.stats-title {
  font-size: var(--font-normal);
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 20rpx;
}

.stats-grid {
  display: flex;
  flex-wrap: wrap;
}

.stat-item {
  width: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
}

.stat-num {
  font-size: var(--font-3xl);
  font-weight: 800;
  background: linear-gradient(135deg, var(--primary), #2E6BB8);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.stat-label {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.stats-footer {
  text-align: center;
  font-size: var(--font-xs);
  color: var(--text-tertiary);
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border-light);
}

/* 功能列表 */
.feature-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.feature-item {
  display: flex;
  align-items: center;
}

.feature-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.feature-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.feature-name {
  font-size: var(--font-normal);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 2rpx;
}

.feature-desc {
  font-size: var(--font-sm);
  color: var(--text-tertiary);
}

/* 链接列表 */
.link-list {
  display: flex;
  flex-direction: column;
}

.link-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-light);
  transition: all 0.2s ease;
}

.link-item:last-child {
  border-bottom: none;
}

.link-item-hover {
  background: var(--bg-page);
  margin: 0 -24rpx;
  padding: 20rpx 24rpx;
}

.link-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.link-name {
  font-size: var(--font-normal);
  color: var(--text-primary);
  font-weight: 500;
  display: block;
  margin-bottom: 4rpx;
}

.link-desc {
  font-size: var(--font-sm);
  color: var(--text-tertiary);
  display: block;
}

.link-url {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  display: block;
  word-break: break-all;
}

.link-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.link-copy {
  font-size: var(--font-sm);
  color: var(--primary);
  padding: 8rpx 20rpx;
  border: 1rpx solid var(--primary);
  border-radius: 20rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.link-arrow {
  font-size: var(--font-xl);
  color: var(--text-quaternary);
}

/* 维权理念 */
.philosophy-card {
  background: linear-gradient(135deg, #FEF2F2 0%, #FEE2E2 100%);
  border: 1rpx solid #FECACA;
  border-left: 6rpx solid #DC2626;
}

.philosophy-title {
  font-size: var(--font-normal);
  font-weight: 700;
  color: #991B1B;
  margin-bottom: 16rpx;
}

.philosophy-text {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.philosophy-text text {
  font-size: var(--font-base);
  color: #7F1D1D;
  line-height: 1.6;
}

/* 底部 */
.footer {
  text-align: center;
  padding: 32rpx 0 16rpx;
}

.footer-text {
  font-size: var(--font-sm);
  color: var(--text-tertiary);
  display: block;
  margin-bottom: 6rpx;
}

/* 免责声明弹窗 */
.disclaimer-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: relative;
  width: 620rpx;
  max-height: 80vh;
  background: var(--bg-card);
  border-radius: 24rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

/* 顶部装饰区 */
.modal-header {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  padding: 40rpx 32rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.modal-header::before {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.modal-header::after {
  content: '';
  position: absolute;
  bottom: -50rpx;
  left: -30rpx;
  width: 160rpx;
  height: 160rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}

.modal-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  position: relative;
  z-index: 1;
}

.modal-icon {
  font-size: var(--font-3xl);
  color: var(--text-inverse);
  --icon-color: var(--text-inverse);
  --icon-bg: transparent;
}

.modal-title {
  font-size: var(--font-2xl);
  font-weight: 700;
  color: var(--text-inverse);
  margin-bottom: 8rpx;
  position: relative;
  z-index: 1;
}

.modal-subtitle {
  font-size: var(--font-base);
  color: rgba(255, 255, 255, 0.85);
  position: relative;
  z-index: 1;
}

/* 内容区 */
.modal-body {
  padding: 28rpx 28rpx 20rpx;
  flex: 1;
  overflow-y: auto;
}

.disclaimer-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
  padding: 16rpx;
  background: #F8FAFC;
  border-radius: 12rpx;
}

.disclaimer-item:last-child {
  margin-bottom: 0;
}

.item-num {
  width: 40rpx;
  height: 40rpx;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  color: var(--text-inverse);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-sm);
  font-weight: 600;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.item-text {
  flex: 1;
  font-size: var(--font-md);
  color: #555555;
  line-height: 1.6;
}

/* 底部按钮 */
.modal-footer {
  padding: 20rpx 28rpx 28rpx;
  border-top: 1rpx solid #F0F0F0;
}

.modal-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  color: var(--text-inverse);
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-lg);
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(74, 144, 217, 0.3);
}

.modal-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

/* ========== 开源协议弹窗 ========== */
.license-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.license-section {
  margin-bottom: 24rpx;
}

.license-section:last-child {
  margin-bottom: 0;
}

.license-lang {
  display: inline-block;
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--primary);
  background: #EFF6FF;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.license-text {
  display: flex;
  flex-direction: column;
}

.license-title-cn {
  font-size: var(--font-normal);
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 12rpx;
  text-align: center;
}

.license-title-en {
  font-size: var(--font-md);
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 12rpx;
  text-align: center;
}

.license-paragraph {
  font-size: var(--font-base);
  color: #555555;
  line-height: 1.7;
  margin-bottom: 12rpx;
  text-align: justify;
}

.license-paragraph:last-child {
  margin-bottom: 0;
}

.license-subtitle {
  font-size: var(--font-md);
  font-weight: 700;
  color: var(--text-primary);
  margin: 20rpx 0 12rpx;
  display: block;
}

.license-contact {
  margin-top: 24rpx;
  padding: 20rpx;
  background: #EFF6FF;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.contact-label {
  font-size: var(--font-base);
  color: #555555;
  margin-right: 8rpx;
}

.contact-email {
  font-size: var(--font-base);
  color: var(--primary);
  font-weight: 600;
  margin-right: 12rpx;
}

.contact-copy {
  font-size: var(--font-xs);
  color: var(--primary);
  padding: 4rpx 12rpx;
  border: 1rpx solid var(--primary);
  border-radius: 8rpx;
}

.license-divider {
  height: 1rpx;
  background: linear-gradient(90deg, transparent 0%, #DDDDDD 50%, transparent 100%);
  margin: 8rpx 0 24rpx;
}


/* list-item组件中的复制按钮样式 */
.list-copy-btn {
  font-size: var(--font-sm, 22rpx);
  color: var(--primary, #4A90D9);
  padding: 8rpx 20rpx;
  border: 1rpx solid var(--primary, #4A90D9);
  border-radius: 20rpx;
  background: transparent;
}