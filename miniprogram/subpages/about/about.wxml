<!--subsubsubpages/about/about.wxml-->
<view class="container" style="--status-bar-height: {{statusBarHeight}}px;">
  <!-- 自定义导航栏 -->
  <view class="nav-bar">
    <view class="nav-back" bindtap="onBack">
      <text>‹</text>
    </view>
    <view class="nav-title">{{navTitle}}</view>
    <view class="nav-placeholder"></view>
  </view>

  <!-- 内容区 -->
  <view class="content">
    <!-- Logo和应用信息 -->
    <view class="app-info">
      <view class="app-logo">
        <image src="/images/logo.png" mode="aspectFit"></image>
      </view>
      <view class="app-name">我不能被欺负</view>
      <view class="app-slogan">用法律武器，维护合法权益</view>
      <view class="app-version">Version {{version}} · MVP</view>
    </view>

    <!-- 相关信息 -->
    <view class="link-card">
      <view class="card-title">相关信息</view>
      <view class="link-list">
        <list-item icon="icon-doc" icon-bg="#F5F3FF" icon-color="#8B5CF6" title="开源协议" desc="自定义双授权协议" bind:tap="onViewLicense"></list-item>
        <list-item icon="icon-building" icon-bg="#EFF6FF" icon-color="#3B82F6" title="Gitee 开源地址" desc="gitee.com/mr-awei/rights-protection" show-arrow="{{false}}" data-text="https://gitee.com/mr-awei/rights-protection" bind:tap="onCopyContact">
          <view slot="right" class="list-copy-btn">复制</view>
        </list-item>
        <list-item icon="icon-building" icon-bg="#F3F4F6" icon-color="#4B5563" title="GitHub 开源地址" desc="github.com/mr-awei/rights-protection" show-arrow="{{false}}" data-text="https://github.com/mr-awei/rights-protection" bind:tap="onCopyContact">
          <view slot="right" class="list-copy-btn">复制</view>
        </list-item>
      </view>
    </view>

    <!-- 维权理念 -->
    <view class="philosophy-card">
      <view class="philosophy-title">维权理念</view>
      <view class="philosophy-text">
        <text>• 先企业内部投诉，约80%的常规问题在此层级即可解决</text>
        <text>• 投诉应当基于真实事实，不得捏造、歪曲事实</text>
        <text>• 不得诬告陷害他人，否则将承担相应法律责任</text>
        <text>• 保留好所有证据，包括聊天记录、合同、票据等</text>
        <text>• 依法理性维权，是每个公民的权利和义务</text>
      </view>
    </view>

    <!-- 底部版权 -->
    <view class="footer">
      <text class="footer-text">© 2026 我不能被欺负</text>
      <text class="footer-text">Made with <view class="app-icon app-icon-default icon-heart" style="width:20rpx;height:20rpx;--icon-bg:transparent;--icon-color:#FF4D4F;display:inline-block;vertical-align:middle;"></view> for 消费者权益保护</text>
    </view>

    <view style="height: 40rpx;"></view>
  </view>

  <!-- 免责声明自定义弹窗 -->
  <view class="disclaimer-modal" wx:if="{{showDisclaimer}}">
    <view class="modal-mask" bindtap="onCloseDisclaimer"></view>
    <view class="modal-content">
      <view class="modal-header">
        <view class="modal-icon-wrap">
          <view class="modal-icon app-icon app-icon-default icon-shield"></view>
        </view>
        <text class="modal-title">免责声明</text>
        <text class="modal-subtitle">使用须知与法律边界</text>
      </view>
      <view class="modal-body">
        <view class="disclaimer-item">
          <view class="item-num">1</view>
          <view class="item-text">本工具为便民信息汇总，非政府官方应用，所有信息仅供参考，不构成法律意见。</view>
        </view>
        <view class="disclaimer-item">
          <view class="item-num">2</view>
          <view class="item-text">具体投诉流程、受理范围和联系方式以各监管部门官方公布为准。</view>
        </view>
        <view class="disclaimer-item">
          <view class="item-num">3</view>
          <view class="item-text">本工具收集的信息均来源于政府官网公开渠道，如有变动请以官方最新公告为准。</view>
        </view>
        <view class="disclaimer-item">
          <view class="item-num">4</view>
          <view class="item-text">用户在使用本工具过程中产生的任何直接或间接损失，本工具不承担任何责任。</view>
        </view>
        <view class="disclaimer-item">
          <view class="item-num">5</view>
          <view class="item-text">投诉应当基于真实事实，不得捏造、歪曲事实，不得诬告陷害他人，否则将承担相应法律责任。</view>
        </view>
      </view>
      <view class="modal-footer">
        <view class="modal-btn" bindtap="onCloseDisclaimer">我已阅读</view>
      </view>
    </view>
  </view>

