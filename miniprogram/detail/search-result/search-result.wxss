/* detail/search-result/search-result.wxss */
.container {
  min-height: 100vh;
  background: var(--bg-page);
}

/* ========== 吸顶区 ========== */
/* 搜索框 + Tab 整体吸顶，内部 search-header 的 padding-top 已含状态栏安全区，
   滚动时整块头部停留在屏幕顶部，Tab 不会被状态栏/胶囊遮挡。 */
.sticky-head {
  position: sticky;
  top: 0;
  z-index: 100;
}

/* ========== 搜索框 ========== */
.search-header {
  background: linear-gradient(135deg, var(--primary-light) 0%, var(--primary) 50%, var(--primary-dark) 100%);
  padding-top: calc(var(--status-bar-height, 44px) + 88rpx);
  padding-bottom: 20rpx;
}

.search-header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  margin-bottom: 20rpx;
}

.back-btn {
  width: 56rpx;
  height: 56rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.back-icon {
  font-size: var(--font-3xl);
  color: var(--text-inverse);
  font-weight: 500;
  line-height: 1;
  margin-left: -4rpx;
}

.search-header-title {
  font-size: var(--font-xl);
  font-weight: 600;
  color: var(--text-inverse);
  flex: 1;
  text-align: center;
}

.search-header-placeholder {
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
}

.search-header-content {
  padding: 0 24rpx;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border-radius: 24rpx;
  padding: 12rpx 16rpx 12rpx 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
  min-width: 0;
}

.search-icon {
  font-size: var(--font-normal);
  margin-right: 12rpx;
  opacity: 0.6;
}

.search-input {
  flex: 1;
  font-size: var(--font-normal);
  color: var(--text-primary);
  height: 48rpx;
}

.search-placeholder {
  color: var(--text-tertiary);
  font-size: var(--font-md);
}

.search-btn {
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  padding: 10rpx 24rpx;
  border-radius: 16rpx;
  margin-left: 12rpx;
}

.search-btn text {
  font-size: var(--font-md);
  color: var(--text-inverse);
  font-weight: 600;
}

/* ========== Tab切换 ========== */
.result-tabs {
  display: flex;
  background: var(--bg-card);
  padding: 16rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.result-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: var(--font-normal);
  color: var(--text-secondary);
  font-weight: 500;
  border-radius: 16rpx;
  transition: all 0.2s ease;
  position: relative;
}

.result-tab.active {
  color: var(--primary-dark);
  font-weight: 700;
  background: var(--primary-bg);
}

.result-tab.active::after {
  content: '';
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background: linear-gradient(90deg, var(--primary), var(--primary-dark));
  border-radius: 3rpx;
}

/* ========== 问题类型筛选栏 ========== */
.issue-type-bar {
  width: 100%;
  background: var(--bg-card);
  border-bottom: 1rpx solid var(--border-light);
  white-space: nowrap;
}

.issue-type-list {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 24rpx;
  gap: 12rpx;
}

.issue-type-item {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 28rpx;
  background: var(--bg-page);
  font-size: var(--font-sm);
  color: var(--text-secondary);
  font-weight: 500;
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.issue-type-item.active {
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: var(--text-inverse);
  font-weight: 600;
}

/* ========== 结果数量 ========== */
.result-count {
  padding: 24rpx 32rpx 16rpx;
  font-size: var(--font-base);
  color: var(--text-tertiary);
}

/* ========== 结果列表 ========== */
.result-list {
  /* 底部预留安全区，避免最后一条结果贴边或被遮挡 */
  padding: 0 24rpx calc(60rpx + env(safe-area-inset-bottom));
}

.result-item {
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  transition: all 0.2s ease;
  border-left: 6rpx solid var(--primary);
}

.result-item:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
}

.ri-title {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.ri-type {
  font-size: var(--font-xs);
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  font-weight: 600;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.ri-type.channel {
  background: var(--primary-bg);
  color: var(--primary-dark);
}

.ri-type.script {
  background: #F0FDF4;
  color: #16A34A;
}

.ri-name {
  flex: 1;
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.ri-desc {
  font-size: var(--font-base);
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.ri-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex-wrap: wrap;
}

.ri-meta text {
  font-size: var(--font-sm);
  color: var(--text-tertiary);
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.4;
}

.empty-title {
  font-size: var(--font-lg);
  color: var(--text-secondary);
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: var(--font-base);
  color: var(--text-tertiary);
  text-align: center;
  margin-bottom: 32rpx;
}

.empty-actions {
  width: 100%;
  max-width: 400rpx;
}

/* ========== 按钮 ========== */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 48rpx;
  border-radius: 28rpx;
  font-size: var(--font-normal);
  font-weight: 600;
  transition: all 0.2s ease;
}

.btn-primary {
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: var(--text-inverse);
  box-shadow: 0 4rpx 16rpx rgba(59,130,246,0.3);
}

.btn-primary:active {
  transform: scale(0.96);
  opacity: 0.9;
}

/* ========== 无结果引导页 ========== */
.empty-with-guide {
  padding: 60rpx 32rpx 120rpx;
}

.guide-section {
  width: 100%;
  margin-bottom: 40rpx;
}

.guide-title {
  font-size: var(--font-normal);
  color: #333333;
  font-weight: 600;
  margin-bottom: 20rpx;
  padding-left: 8rpx;
}

.guide-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.guide-tag {
  padding: 12rpx 28rpx;
  background: #F5F7FA;
  border-radius: 32rpx;
  font-size: var(--font-base);
  color: #555555;
  border: 1rpx solid #E5E6EB;
  transition: all 0.2s ease;
}

.guide-tag:active {
  background: var(--primary-bg);
  color: var(--primary-dark);
  border-color: var(--primary-dark);
}

.guide-categories {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.guide-category {
  width: calc(25% - 15rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
  background: #F5F7FA;
  border-radius: 16rpx;
  transition: all 0.2s ease;
}

.guide-category:active {
  background: var(--primary-bg);
  transform: scale(0.96);
}

.guide-category-icon {
  font-size: var(--font-3xl);
  margin-bottom: 8rpx;
}

.guide-category-name {
  font-size: var(--font-sm);
  color: #555555;
}
