<!--detail/script-detail/script-detail.wxml-->
<!-- 加载状态 -->
<loading-state wx:if="{{loading}}" text="加载中..."></loading-state>

<view class="container" wx:if="{{script && !loading}}">
  <!-- 渐变头部 -->
  <view class="gradient-header">
    <view class="header-content">
      <view class="script-title-row">
        <view class="script-badge app-icon app-icon-default icon-chat" style="width:40rpx;height:40rpx;--icon-bg:rgba(255,255,255,0.2);--icon-color:#fff;"></view>
        <text class="script-title">{{script.scene_name}}</text>
      </view>
      <view class="script-meta" wx:if="{{applicableText}}">
        <text class="meta-text">{{applicableText}}</text>
      </view>
    </view>
  </view>

  <!-- 内容区 -->
  <view class="content">
    <!-- Tab切换 -->
    <view class="tab-bar">
      <view
        class="tab-item {{activeTab === 'phone' ? 'active' : ''}}"
        data-tab="phone"
        bindtap="onTabTap"
      >
        <view class="tab-icon app-icon app-icon-default icon-phone" style="width:32rpx;height:32rpx;margin-right:8rpx;"></view>
        <text class="tab-text">电话版</text>
      </view>
      <view
        class="tab-item {{activeTab === 'written' ? 'active' : ''}}"
        data-tab="written"
        bindtap="onTabTap"
      >
        <view class="tab-icon app-icon app-icon-default icon-doc" style="width:32rpx;height:32rpx;margin-right:8rpx;"></view>
        <text class="tab-text">书面版</text>
      </view>
    </view>

    <!-- 话术内容卡片 -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">{{activeTab === 'phone' ? '电话投诉话术' : '书面投诉模板'}}</text>
        <view class="header-actions">
          <view class="fill-btn" bindtap="toggleFillForm" wx:if="{{!hasCustomContent}}">
            <text>填写信息</text>
          </view>
          <view class="reset-btn" bindtap="resetCustomScript" wx:if="{{hasCustomContent}}">
            <text>重置</text>
          </view>
          <view class="copy-btn" bindtap="onCopyScript" hover-class="copy-btn-hover">
            <view class="copy-btn-icon app-icon app-icon-default icon-copy" style="width:28rpx;height:28rpx;margin-right:8rpx;"></view>
            <text class="copy-btn-text">{{hasCustomContent ? '复制个性化' : '复制全部'}}</text>
          </view>
        </view>
      </view>

      <!-- 填充表单区域 -->
      <view class="fill-form" wx:if="{{showFillForm && !hasCustomContent}}">
        <view class="fill-form-title">
          <text>填写以下信息，自动生成个性化话术</text>
        </view>
        <view class="fill-form-list">
          <view class="fill-form-item" wx:for="{{placeholders}}" wx:key="name">
            <text class="fill-form-label">{{item.label}}</text>
            <text class="fill-form-guide" wx:if="{{item.guide}}">{{item.guide}}</text>
            <input
              class="fill-form-input"
              type="text"
              placeholder="{{item.example ? '如：' + item.example : '请填写' + item.label}}"
              placeholder-class="fill-placeholder"
              value="{{formData[item.name]}}"
              data-field="{{item.name}}"
              bindinput="onFormInput"
            />
          </view>
        </view>
        <view class="fill-form-actions">
          <view class="fill-cancel" bindtap="toggleFillForm">
            <text>取消</text>
          </view>
          <view class="fill-generate" bindtap="generateCustomScript" hover-class="fill-generate-hover">
            <text>生成个性化话术</text>
          </view>
        </view>
      </view>

      <!-- 个性化话术提示 -->
      <view class="custom-tip" wx:if="{{hasCustomContent}}">
        <view class="custom-tip-icon app-icon app-icon-default icon-info" style="width:28rpx;height:28rpx;margin-right:8rpx;"></view>
        <text class="custom-tip-text">已根据您填写的信息生成个性化话术，可直接复制使用</text>
      </view>

      <!-- 电话版 -->
      <view class="script-card" wx:if="{{activeTab === 'phone'}}">
        <view class="script-tip">
          电话投诉时，按照以下话术表达，条理清晰、有理有据
        </view>
        <view class="script-divider"></view>
        <view class="script-text">
          <rich-text nodes="{{hasCustomContent ? customPhoneContent : phoneContent}}"></rich-text>
        </view>
      </view>

      <!-- 书面版分块展示 -->
      <view class="written-sections" wx:if="{{activeTab === 'written' && writtenSections.length > 0}}">
        <view class="script-tip" style="margin-bottom: 16rpx;">
          书面投诉时，按照以下格式撰写，每块可单独复制
        </view>
        <view
          class="written-section"
          wx:for="{{writtenSections}}"
          wx:key="id"
        >
          <view class="written-section-header">
            <text class="written-section-title">{{item.title}}</text>
            <view class="written-section-copy" bindtap="onCopySection" data-section="{{item}}" hover-class="written-section-copy-hover">
              <text>复制</text>
            </view>
          </view>
          <view class="written-section-content">
            <rich-text nodes="{{item.content}}"></rich-text>
          </view>
        </view>
      </view>

      <!-- 书面版整体展示（有个性化内容或无分块时） -->
      <view class="script-card" wx:if="{{activeTab === 'written' && (hasCustomContent || writtenSections.length === 0)}}">
        <view class="script-tip">
          书面投诉时，按照以下格式撰写，可直接复制修改
        </view>
        <view class="script-divider"></view>
        <view class="script-text">
          <rich-text nodes="{{hasCustomContent ? customWrittenContent : writtenContent}}"></rich-text>
        </view>
      </view>
    </view>

    <!-- 法律依据 -->
    <view class="section" wx:if="{{laws.length > 0 || legalBasisText}}">
      <view class="section-header">
        <text class="section-title">法律依据</text>
      </view>
      <view class="law-card">
        <view class="law-basis-text" wx:if="{{legalBasisText}}">
          <rich-text nodes="{{legalBasisText}}"></rich-text>
        </view>
        <view class="law-list" wx:if="{{laws.length > 0}}">
          <view class="law-item" wx:for="{{laws}}" wx:key="id">
            <view class="law-item-icon app-icon app-icon-default icon-law">
              <view class="icon-law-left"></view>
              <view class="icon-law-right"></view>
            </view>
            <view class="law-item-info">
              <text class="law-item-name">{{item.name}}</text>
              <text class="law-item-desc">{{item.description || item.article || '点击查看相关法条'}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 证据清单 -->
    <view class="section" wx:if="{{evidenceList.length > 0}}">
      <view class="section-header">
        <text class="section-title">证据清单</text>
        <text class="section-count">{{evidenceList.length}}项</text>
      </view>
      <view class="evidence-card">
        <view
          class="evidence-item"
          wx:for="{{evidenceList}}"
          wx:key="index"
        >
          <view class="ev-num">{{index + 1}}</view>
          <view class="ev-text">{{item}}</view>
        </view>
      </view>
    </view>

    <!-- 关联渠道 -->
    <view class="section" wx:if="{{relatedChannels.length > 0}}">
      <view class="section-header">
        <text class="section-title">关联维权渠道</text>
        <text class="section-count">{{relatedChannels.length}}个</text>
      </view>
      <view class="channel-list">
        <view
          class="channel-card"
          wx:for="{{relatedChannels}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onChannelTap"
          hover-class="channel-card-hover"
        >
          <view class="channel-icon app-icon app-icon-default icon-channel"></view>
          <view class="channel-info">
            <text class="channel-name">{{item.name}}</text>
            <text class="channel-phone" wx:if="{{item.phone}}"> {{item.phone}}</text>
          </view>
          <view class="channel-arrow app-icon app-icon-default icon-chevron-right" style="width:24rpx;height:24rpx;--icon-bg:transparent;--icon-color:#999;"></view>
        </view>
      </view>
    </view>

    <!-- 媒体曝光入口 -->
    <view class="section" bindtap="onMediaExposureTap" hover-class="section-hover">
      <view class="media-entry-card media-entry-script">
        <view class="media-entry-main">
          <view class="media-entry-icon app-icon app-icon-default icon-broadcast" style="--icon-bg:#FFF7E6;--icon-color:#FA8C16;"></view>
          <view class="media-entry-info">
            <text class="media-entry-title">话说完了没解决？试试媒体曝光</text>
            <text class="media-entry-desc">媒体曝光是独立于官方投诉的并行监督路径，可同时启动。官方久拖不决、处理结果不满意，或事件具有公共性、典型性时，舆论监督能推动问题解决。</text>
          </view>
        </view>
        <view class="media-entry-arrow app-icon app-icon-default icon-chevron-right" style="width:28rpx;height:28rpx;--icon-bg:transparent;--icon-color:#C9CDD4;"></view>
      </view>
    </view>

    <!-- 所需材料清单 + 自检表 -->
    <view class="section" wx:if="{{materialsList.length > 0}}">
      <materials-checklist materials="{{materialsList}}"></materials-checklist>
    </view>

    <!-- 依法维权提示 -->
    <view class="section">
      <view class="legal-notice-card">
        <view class="legal-notice-header">
          <view class="legal-notice-icon app-icon app-icon-default icon-law" style="width:32rpx;height:32rpx;margin-right:10rpx;--icon-bg:#D1FAE5;--icon-color:#059669;--icon-hover-bg:#059669;">
            <view class="icon-law-left"></view>
            <view class="icon-law-right"></view>
          </view>
          <text class="legal-notice-title">依法维权 · 理性表达</text>
        </view>
        <view class="legal-notice-content">
          <text class="legal-notice-text">本话术模板仅供参考，请根据实际情况客观真实地表达诉求。《宪法》第四十一条赋予公民申诉、控告、检举的权利，同时规定不得捏造或歪曲事实进行诬告陷害。</text>
          <text class="legal-notice-text">• 建议先向企业内部投诉，明确诉求并索取工单号，约80%的常规问题在此层级即可解决。</text>
          <text class="legal-notice-text">• 捏造事实诬告陷害他人：依据《治安管理处罚法》处5日以下拘留或1000元以下罚款；情节严重的触犯《刑法》诬告陷害罪，最高可处10年有期徒刑。</text>
          <text class="legal-notice-text">• 依法维权、理性维权，既是对自己负责，也是对社会法治秩序的维护。</text>
          <text class="legal-notice-text legal-heart">心里话：这把剑该指向违法犯罪、道德败坏，以及不作为、乱作为、懒作为，绝不要挥向好人，绝不要对准良心商家、良心企业家。好人不应该让人拿枪指着！！！</text>
        </view>
      </view>
    </view>

    <view style="height: 220rpx;"></view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <view class="bottom-btn btn-secondary" bindtap="onCopyScript" hover-class="bottom-btn-hover">
      <view class="app-icon app-icon-default icon-copy" style="width:36rpx;height:36rpx;margin-right:10rpx;"></view>
      <text class="btn-text">复制话术</text>
    </view>
    <view class="bottom-btn {{isFavorite ? 'btn-primary' : 'btn-secondary'}}" bindtap="onToggleFavorite" hover-class="bottom-btn-hover">
      <view class="app-icon {{isFavorite ? 'app-icon-hover icon-star' : 'app-icon-default icon-star'}}" style="width:36rpx;height:36rpx;margin-right:10rpx;{{isFavorite ? '' : '--icon-color: #666666;'}}"></view>
      <text class="btn-text">{{isFavorite ? '已收藏' : '收藏'}}</text>
    </view>
    <button class="bottom-btn btn-secondary share-btn" open-type="share" hover-class="bottom-btn-hover">
      <view class="app-icon app-icon-default icon-share" style="width:36rpx;height:36rpx;margin-right:10rpx;"></view>
      <text class="btn-text">分享</text>
    </button>
  </view>

  <!-- 自定义弹窗 -->
  <custom-modal
    visible="{{modalVisible}}"
    type="{{modalType}}"
    title="{{modalTitle}}"
    content="{{modalContent}}"
    confirmText="{{modalConfirmText}}"
    cancelText="{{modalCancelText}}"
    showCancel="{{modalShowCancel}}"
    placeholder="{{modalPlaceholder}}"
    defaultValue="{{modalDefaultValue}}"
    itemList="{{modalItemList}}"
    bind:confirm="onModalConfirm"
    bind:cancel="onModalCancel"
    bind:select="onModalSelect"
  />
</view>
