/* detail/script-detail/script-detail.wxss */

/* ========== 加载状态 ========== */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  background: var(--bg-page);
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--border);
  border-top-color: #10B981;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: var(--font-md);
  color: var(--text-secondary);
}

.container {
  min-height: 100vh;
  background: var(--bg-page);
}

/* ========== 渐变头部 ========== */
.gradient-header {
  background: linear-gradient(135deg, #10B981 0%, #059669 50%, #047857 100%);
  padding: 0 0 32rpx;
  position: relative;
  overflow: hidden;
}

.gradient-header::before {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -30rpx;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255,255,255,0.08);
  border-radius: 50%;
}

.gradient-header::after {
  content: '';
  position: absolute;
  bottom: -40rpx;
  left: -20rpx;
  width: 160rpx;
  height: 160rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 50%;
}

.header-content {
  position: relative;
  z-index: 1;
  padding: 20rpx 32rpx 0;
}

.script-title-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.script-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.2);
  backdrop-filter: blur(10px);
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.badge-text {
  font-size: var(--font-base);
  color: var(--text-inverse);
  font-weight: 600;
  line-height: 1.2;
}

.script-title {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--text-inverse);
  line-height: 1.4;
  word-break: break-all;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  flex: 1;
  min-width: 0;
}

.script-meta {
  margin-top: 8rpx;
}

.meta-text {
  font-size: var(--font-base);
  color: rgba(255,255,255,0.85);
  line-height: 1.5;
}

/* ========== 内容区 ========== */
.content {
  padding: 0 24rpx;
  margin-top: 0;
  position: relative;
  z-index: 2;
}

/* ========== Tab切换 ========== */
.tab-bar {
  display: flex;
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 8rpx;
  margin: -20rpx 0 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  position: relative;
  z-index: 3;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  transition: all 0.2s ease;
}

.tab-item.active {
  background: linear-gradient(135deg, #10B981, #059669);
  box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.3);
}

.tab-icon {
  /* 使用全局app-icon样式 */
}

.tab-text {
  font-size: var(--font-md);
  color: var(--text-secondary);
  font-weight: 500;
}

.tab-item.active .tab-text {
  color: var(--text-inverse);
  font-weight: 600;
}

/* ========== 通用区块 ========== */
.section {
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 8rpx 16rpx;
}

.section-title {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--text-primary);
}

.section-count {
  margin-left: auto;
  font-size: var(--font-sm);
  color: var(--text-tertiary);
  background: var(--border-light);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

/* ========== 话术内容卡片 ========== */
.script-card {
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.script-tip {
  font-size: var(--font-base);
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: 20rpx;
  background: #F0FDF4;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  border-left: 4rpx solid #10B981;
}

.script-divider {
  height: 1rpx;
  background: var(--border-light);
  margin-bottom: 20rpx;
}

.script-text {
  font-size: var(--font-md);
  color: #334155;
  line-height: 1.8;
}

/* ========== 证据清单卡片 ========== */
.evidence-card {
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.evidence-item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--bg-page);
}

.evidence-item:last-child {
  border-bottom: none;
}

.ev-num {
  width: 40rpx;
  height: 40rpx;
  background: linear-gradient(135deg, #10B981, #059669);
  color: var(--text-inverse);
  font-size: var(--font-sm);
  font-weight: 600;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.ev-text {
  flex: 1;
  font-size: var(--font-md);
  color: #334155;
  line-height: 1.6;
  padding-top: 4rpx;
}

/* ========== 关联渠道列表 ========== */
.channel-list {
  padding-bottom: 8rpx;
}

.channel-card {
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.channel-card-hover {
  background: var(--bg-page);
}

.channel-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 14rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.channel-icon-text {
  font-size: var(--font-normal);
  font-weight: 600;
  color: #16A34A;
  line-height: 1;
}

.channel-info {
  flex: 1;
  min-width: 0;
}

.channel-name {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.4;
  margin-bottom: 6rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.channel-phone {
  font-size: var(--font-sm);
  color: #059669;
  font-weight: 500;
}

.channel-arrow {
  font-size: var(--font-2xl);
  color: var(--text-quaternary);
  font-weight: 300;
  margin-left: 12rpx;
}

/* ========== 依法维权提示卡片 ========== */
.legal-notice-card {
  background: linear-gradient(135deg, #F0FDF4 0%, #DCFCE7 100%);
  border: 1rpx solid #BBF7D0;
  border-radius: 20rpx;
  padding: 24rpx;
  border-left: 6rpx solid #10B981;
}

.legal-notice-header {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.legal-notice-icon {
  /* 使用全局app-icon样式 */
}

.legal-icon-text {
  /* 使用全局app-icon样式 */
}

.legal-notice-title {
  font-size: var(--font-md);
  font-weight: 700;
  color: #059669;
}

.legal-notice-content {
  padding-left: 4rpx;
}

.legal-notice-text {
  font-size: var(--font-sm);
  color: #064E3B;
  line-height: 1.7;
  display: block;
  margin-bottom: 6rpx;
}

.legal-heart {
  margin-top: 10rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid rgba(245, 158, 11, 0.15);
  color: #92400E;
  font-weight: 600;
}

/* ========== 底部操作栏 ========== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--bg-card);
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 16rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.06);
  z-index: 100;
}

.bottom-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
  border-radius: 16rpx;
  transition: all 0.2s ease;
}

.btn-secondary {
  background: var(--border-light);
  border: 1rpx solid var(--border);
}

.btn-primary {
  background: linear-gradient(135deg, #10B981, #059669);
  box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.3);
}

.btn-icon {
  font-size: var(--font-normal);
  margin-right: 8rpx;
}

.btn-text {
  font-size: var(--font-normal);
  font-weight: 600;
}

.btn-secondary .btn-text {
  color: var(--text-secondary);
}

.btn-primary .btn-text {
  color: var(--text-inverse);
}

/* 分享按钮重置button默认样式 */
.share-btn {
  margin: 0;
  padding: 24rpx 0;
  line-height: normal;
  border-radius: 16rpx;
  background: var(--border-light);
  border: 1rpx solid var(--border);
  font-size: var(--font-normal);
  font-weight: 600;
  color: var(--text-secondary);
}
.share-btn::after {
  border: none;
}

/* ========== 复制按钮 ========== */
.copy-btn {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #10B981, #059669);
  padding: 10rpx 20rpx;
  border-radius: 16rpx;
  margin-left: auto;
}

.copy-btn-hover {
  opacity: 0.8;
  transform: scale(0.95);
}

.copy-btn-icon {
  /* 使用全局app-icon样式 */
}

.copy-btn-text {
  font-size: var(--font-sm);
  color: var(--text-inverse);
  font-weight: 600;
}

/* ========== 书面版分块 ========== */
.written-sections {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.written-section {
  background: var(--bg-card);
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.written-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #F0FDF4;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid #BBF7D0;
}

.written-section-title {
  font-size: var(--font-md);
  font-weight: 700;
  color: #059669;
}

.written-section-copy {
  background: #10B981;
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
}

.written-section-copy-hover {
  opacity: 0.8;
  transform: scale(0.95);
}

.written-section-copy text {
  font-size: var(--font-sm);
  color: var(--text-inverse);
  font-weight: 600;
}

.written-section-content {
  padding: 20rpx;
  font-size: var(--font-md);
  color: #334155;
  line-height: 1.8;
}

/* ========== 法律依据卡片 ========== */
.law-card {
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  border-left: 6rpx solid #8B5CF6;
}

.law-basis-text {
  font-size: var(--font-md);
  color: var(--text-secondary);
  line-height: 1.8;
  margin-bottom: 16rpx;
}

.law-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.law-item {
  display: flex;
  align-items: center;
  background: var(--bg-page);
  border-radius: 12rpx;
  padding: 16rpx;
}

.law-item-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.law-icon-text {
  font-size: var(--font-base);
  font-weight: 600;
  color: #7C3AED;
  line-height: 1;
}

.law-item-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.law-item-name {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.law-item-desc {
  font-size: var(--font-sm);
  color: var(--text-tertiary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ========== 媒体曝光入口卡片 ========== */
.media-entry-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--bg-card);
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border-left: 6rpx solid #FA8C16;
}

.media-entry-script {
  border-left-color: #F59E0B;
}

.media-entry-main {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.media-entry-icon {
  width: 56rpx;
  height: 56rpx;
  --icon-bg: #FFF7E6;
  --icon-color: #FA8C16;
  border-radius: 14rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.media-entry-info {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.media-entry-title {
  font-size: var(--font-normal);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.media-entry-desc {
  font-size: var(--font-sm);
  color: var(--text-tertiary);
  line-height: 1.5;
}

.media-entry-arrow {
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* ========== 占位符填充功能 ========== */
.header-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.fill-btn {
  background: linear-gradient(135deg, #F59E0B, #D97706);
  color: #fff;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: var(--font-sm);
  font-weight: 500;
  flex-shrink: 0;
}

.reset-btn {
  background: linear-gradient(135deg, #6B7280, #4B5563);
  color: #fff;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: var(--font-sm);
  font-weight: 500;
  flex-shrink: 0;
}

.fill-form {
  background: linear-gradient(135deg, #FFFBEB, #FEF3C7);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid #FCD34D;
}

.fill-form-title {
  font-size: var(--font-md);
  font-weight: 600;
  color: #92400E;
  margin-bottom: 20rpx;
}

.fill-form-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.fill-form-item {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  background: #fff;
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  border: 2rpx solid #FDE68A;
}

/* 格式校验失败态 */
.fill-form-item.has-error {
  border-color: var(--danger);
  background: #FFF7F7;
}

.fill-form-error {
  width: 100%;
  margin-top: 8rpx;
  padding-left: 4rpx;
  font-size: var(--font-xs);
  color: var(--danger);
  line-height: 1.5;
}

/* 第一行：标签 + 填写说明 */
.fill-form-label {
  font-size: var(--font-base);
  color: #78350F;
  font-weight: 500;
  flex-shrink: 0;
}

.fill-form-guide {
  font-size: var(--font-xs);
  color: #92400E;
  opacity: 0.65;
  margin-left: 10rpx;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 第二行：输入控件独占整行，避免与标签/说明挤在一行 */
.fill-form-item > .fill-form-input,
.fill-form-item > .fill-form-picker-wrap,
.fill-form-item > .fill-form-combo {
  flex: 0 0 100%;
  width: 100%;
  min-width: 0;
  margin-top: 10rpx;
}

.fill-form-input {
  font-size: var(--font-base);
  color: var(--text-primary);
  min-width: 0;
  height: 64rpx;
  line-height: 64rpx;
}

.fill-placeholder {
  color: var(--text-quaternary);
  font-size: var(--font-sm);
}

/* 组合控件：整行输入框 + 右侧内嵌选择入口（地区补充详细地址 / 平台公司候选选择）
   注意：外层 fill-form-item 已有边框与底色，这里刻意不再加边框，避免双重描边显脏 */
.fill-form-combo {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
  min-width: 0;
}

.fill-form-combo .fill-form-input {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  line-height: 64rpx;
  padding-right: 52rpx;
}

.fill-form-combo-suffix {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 52rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.fill-form-combo-icon {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.45;
}

/* 日期 / 地区选择器 */
.fill-form-picker-wrap {
  flex: 1;
  min-width: 0;
}

.fill-form-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-width: 0;
}

.fill-form-picker-text {
  flex: 1;
  min-width: 0;
  font-size: var(--font-base);
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fill-form-picker.is-placeholder .fill-form-picker-text {
  color: var(--text-quaternary);
  font-size: var(--font-sm);
}

.picker-arrow {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
  margin-left: 8rpx;
  opacity: 0.5;
}

.picker-arrow::before {
  -webkit-mask-size: 80%;
  mask-size: 80%;
}

.fill-form-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.fill-cancel {
  flex: 1;
  background: #fff;
  color: #6B7280;
  padding: 16rpx;
  border-radius: 12rpx;
  text-align: center;
  font-size: var(--font-md);
  font-weight: 500;
  border: 2rpx solid #E5E7EB;
}

.fill-generate {
  flex: 2;
  background: linear-gradient(135deg, #F59E0B, #D97706);
  color: #fff;
  padding: 16rpx;
  border-radius: 12rpx;
  text-align: center;
  font-size: var(--font-md);
  font-weight: 600;
}

.fill-generate-hover {
  opacity: 0.85;
}

.custom-tip {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #ECFDF5, #D1FAE5);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid #6EE7B7;
}

.custom-tip-icon {
  /* 使用全局app-icon样式 */
}

.custom-tip-text {
  font-size: var(--font-base);
  color: #065F46;
  font-weight: 500;
  flex: 1;
}
