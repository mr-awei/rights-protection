/* detail/channel-detail/channel-detail.wxss */

/* ========== 加载状态 ========== */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  background: var(--bg-page);
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--border);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: var(--font-md);
  color: var(--text-secondary);
}

.container {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: 160rpx;
}

/* ========== 渐变头部 ========== */
.gradient-header {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 50%, #2E6BB8 100%);
  padding: 0 0 40rpx;
  position: relative;
  overflow: hidden;
}

.gradient-header::before {
  content: '';
  position: absolute;
  top: -80rpx;
  right: -40rpx;
  width: 280rpx;
  height: 280rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
  border-radius: 50%;
}

.gradient-header::after {
  content: '';
  position: absolute;
  bottom: -60rpx;
  left: -40rpx;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
  border-radius: 50%;
}

.header-content {
  position: relative;
  z-index: 1;
  padding: 20rpx 32rpx 0;
}

.channel-title-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.channel-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.2);
  backdrop-filter: blur(10px);
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(255,255,255,0.3);
  flex-shrink: 0;
  margin-top: 4rpx;
}

.badge-text {
  font-size: var(--font-base);
  color: var(--text-inverse);
  font-weight: 600;
  line-height: 1.2;
}

.channel-title {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--text-inverse);
  line-height: 1.4;
  word-break: break-all;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  flex: 1;
  min-width: 0;
}

.channel-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.channel-tag {
  background: rgba(255,255,255,0.18);
  backdrop-filter: blur(10px);
  color: var(--text-inverse);
  font-size: var(--font-sm);
  padding: 8rpx 18rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(255,255,255,0.25);
}

.issue-type-tags {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
  margin-top: 12rpx;
}

.issue-type-label {
  font-size: var(--font-sm);
  color: rgba(255,255,255,0.7);
}

.path-type-tags {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
  margin-top: 12rpx;
}

.path-type-label {
  font-size: var(--font-sm);
  color: rgba(255,255,255,0.7);
}

.issue-type-tag {
  background: rgba(255,255,255,0.12);
  color: #FFE4B5;
  font-size: var(--font-xs);
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(255,228,181,0.3);
}

/* ========== 内容区 ========== */
.content {
  padding: 0 24rpx;
  margin-top: 0;
  position: relative;
  z-index: 2;
}

.section {
  margin-bottom: 28rpx;
}

.section-header {
  padding: 8rpx 8rpx 16rpx;
}

.section-title {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--text-primary);
}

/* ========== 联系方式卡片 ========== */
.contact-card {
  background: var(--bg-card);
  border-radius: 24rpx;
  padding: 8rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.contact-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-light);
  transition: all 0.2s ease;
}

.contact-item:last-child {
  border-bottom: none;
}

.contact-item.clickable:active {
  opacity: 0.7;
  background: var(--bg-page);
  margin: 0 -24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
}

.contact-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.contact-icon-phone {
  --icon-bg: #E6F4FF;
  --icon-color: var(--info);
}

.contact-icon-website {
  --icon-bg: #E6FFFB;
  --icon-color: #13C2C2;
}

.contact-icon-other {
  --icon-bg: #F9F0FF;
  --icon-color: #722ED1;
}

.contact-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.contact-label {
  font-size: var(--font-base);
  color: var(--text-tertiary);
  margin-bottom: 4rpx;
}

.contact-value {
  font-size: var(--font-normal);
  color: var(--text-primary);
  font-weight: 600;
  word-break: break-all;
}

.contact-arrow {
  font-size: var(--font-2xl);
  color: var(--text-quaternary);
  font-weight: 300;
  margin-left: 12rpx;
}

/* ========== 通用信息卡片 ========== */
.process-card,
.info-card,
.tips-card {
  background: var(--bg-card);
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  font-size: var(--font-md);
  color: var(--text-secondary);
  line-height: 1.8;
}

.tips-card {
  background: linear-gradient(135deg, #FFFBEB 0%, #FEF3C7 100%);
  border: 1rpx solid #FDE68A;
  color: #92400E;
}

/* ========== 依法维权提示卡片 ========== */
.legal-notice-card {
  background: linear-gradient(135deg, #FEF2F2 0%, #FEE2E2 100%);
  border: 1rpx solid #FECACA;
  border-radius: 20rpx;
  padding: 24rpx;
  border-left: 6rpx solid #DC2626;
}

.legal-notice-header {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.legal-notice-icon {
  font-size: var(--font-normal);
  margin-right: 8rpx;
}

.legal-notice-title {
  font-size: var(--font-md);
  font-weight: 700;
  color: #DC2626;
}

.legal-notice-content {
  padding-left: 4rpx;
}

.legal-notice-text {
  font-size: var(--font-sm);
  color: #7F1D1D;
  line-height: 1.7;
  display: block;
  margin-bottom: 6rpx;
}

.legal-heart {
  margin-top: 10rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid rgba(245, 158, 11, 0.15);
  color: #92400E;
  font-weight: 600;
}

/* ========== 法律法规列表 ========== */
.law-list {
  background: var(--bg-card);
  border-radius: 24rpx;
  padding: 8rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.law-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}

.law-item:last-child {
  border-bottom: none;
}

.law-item-hover {
  background: var(--bg-page);
  opacity: 0.8;
}

.law-arrow {
  font-size: var(--font-xl);
  color: var(--text-quaternary);
  margin-left: 12rpx;
}

.law-icon {
  width: 56rpx;
  height: 56rpx;
  --icon-bg: #F6FFED;
  --icon-color: var(--success);
  border-radius: 14rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.law-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.law-name {
  font-size: var(--font-normal);
  color: var(--text-primary);
  font-weight: 600;
  margin-bottom: 4rpx;
}

.law-desc {
  font-size: var(--font-sm);
  color: var(--text-tertiary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ========== 关联话术列表 ========== */
.script-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.script-card {
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  border-left: 6rpx solid var(--primary);
  transition: all 0.2s ease;
}

.script-card-hover {
  transform: scale(0.98);
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
}

.script-icon {
  width: 56rpx;
  height: 56rpx;
  --icon-bg: #E8F8EF;
  --icon-color: var(--success);
  border-radius: 14rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.script-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.script-name {
  font-size: var(--font-normal);
  color: var(--text-primary);
  font-weight: 600;
  margin-bottom: 4rpx;
}

.script-meta {
  font-size: var(--font-sm);
  color: var(--text-tertiary);
}

.script-arrow {
  font-size: var(--font-2xl);
  color: var(--text-quaternary);
  font-weight: 300;
}

/* ========== 底部操作栏 ========== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  background: var(--bg-card);
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.08);
  z-index: 100;
}

.bottom-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 24rpx;
}

.bottom-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--bg-page);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 4rpx;
}

.bottom-icon-active {
  background: #FFF7E6;
}

.bottom-icon-text {
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--text-secondary);
}

.bottom-icon-active .bottom-icon-text {
  color: var(--warning);
}

.bottom-label {
  font-size: var(--font-xs);
  color: var(--text-secondary);
  transition: color 0.2s;
}

.bottom-label-active {
  color: #FAAD14;
  font-weight: 600;
}

.bottom-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  border-radius: 28rpx;
  padding: 24rpx;
  margin-left: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(59,130,246,0.3);
  transition: all 0.2s ease;
}

.bottom-btn:active {
  transform: scale(0.96);
  opacity: 0.9;
}

.bottom-btn-text {
  color: var(--text-inverse);
  font-size: var(--font-lg);
  font-weight: 700;
}

/* ========== 加载状态 ========== */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
  font-size: var(--font-normal);
  color: var(--text-tertiary);
}

/* ========== 渠道状态提示条 ========== */
.status-banner {
  border-radius: 20rpx;
  padding: 24rpx;
  border-left: 6rpx solid;
}

.status-banner.status-merged {
  background: linear-gradient(135deg, #FFFBEB 0%, #FEF3C7 100%);
  border-color: #F59E0B;
  border-left-color: #F59E0B;
}

.status-banner.status-discontinued {
  background: linear-gradient(135deg, #FEF2F2 0%, #FEE2E2 100%);
  border-color: #FECACA;
  border-left-color: #EF4444;
}

.status-banner.status-merging {
  background: linear-gradient(135deg, #FFFBEB 0%, #FEF3C7 100%);
  border-color: #FDE68A;
  border-left-color: #F59E0B;
}

.status-banner-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.status-banner-icon {
  font-size: var(--font-normal);
  margin-right: 8rpx;
}

.status-banner-title {
  font-size: var(--font-normal);
  font-weight: 700;
  color: #92400E;
}

.status-discontinued .status-banner-title {
  color: #991B1B;
}

.status-banner-message {
  font-size: var(--font-base);
  color: #78350F;
  line-height: 1.6;
  display: block;
  margin-bottom: 16rpx;
}

.status-discontinued .status-banner-message {
  color: #7F1D1D;
}

.status-replacement {
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  transition: all 0.2s ease;
}

.status-replacement-hover {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

.status-replacement-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.status-replacement-label {
  font-size: var(--font-xs);
  color: var(--text-tertiary);
  margin-bottom: 4rpx;
}

.status-replacement-name {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 2rpx;
}

.status-replacement-phone {
  font-size: var(--font-sm);
  color: var(--primary);
  font-weight: 500;
}

.status-replacement-arrow {
  font-size: var(--font-xl);
  color: var(--text-quaternary);
  margin-left: 12rpx;
}

/* ========== 前置条件卡片 ========== */
.precondition-card {
  background: linear-gradient(135deg, #FFFBEB 0%, #FEF3C7 100%);
  border: 1rpx solid #FDE68A;
  border-radius: 20rpx;
  padding: 24rpx;
  font-size: var(--font-md);
  color: #78350F;
  line-height: 1.8;
}

/* ========== 信息来源卡片 ========== */
.source-card {
  background: var(--bg-page);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid var(--border);
}

.source-text {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  line-height: 1.6;
  display: block;
  margin-bottom: 6rpx;
}

.source-tip {
  font-size: var(--font-xs);
  color: var(--text-tertiary);
  line-height: 1.5;
  display: block;
  margin-top: 8rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--border);
}


/* 法律详情弹窗 */
.law-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.law-modal-content {
  background: #fff;
  border-radius: 24rpx;
  width: 100%;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.law-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid #eee;
  flex-shrink: 0;
}

.law-modal-title {
  font-size: var(--font-xl);
  font-weight: 600;
  color: #1a1a1a;
  flex: 1;
  padding-right: 20rpx;
}

.law-modal-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 50%;
  background: #f5f5f5;
  transition: all 0.2s ease;
}

.law-modal-close:active {
  background: #e0e0e0;
  transform: scale(0.92);
}

.law-modal-close-icon {
  width: 36rpx;
  height: 36rpx;
  --icon-bg: transparent;
  --icon-color: #666;
}

.law-modal-close .icon-close {
  font-size: var(--font-2xl);
  color: #999;
}

.law-modal-body {
  flex: 1;
  padding: 32rpx;
  overflow-y: auto;
}

.law-article-item {
  margin-bottom: 28rpx;
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  border-left: 6rpx solid #4a90d9;
}

.law-article-text {
  font-size: var(--font-md);
  color: #333;
  line-height: 2;
  white-space: pre-wrap;
  word-break: break-all;
}

.law-modal-footer {
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #eee;
  flex-shrink: 0;
}

.law-modal-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: #4a90d9;
  color: #fff;
  font-size: var(--font-normal);
  border-radius: 12rpx;
  border: none;
}

.law-modal-btn::after {
  border: none;
}


/* 法律依据免责声明 */
.law-disclaimer {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: #fff8e6;
  border-radius: 8rpx;
  border-left: 6rpx solid #ff9500;
}

.law-disclaimer-text {
  font-size: var(--font-sm);
  color: #8a6d3b;
  line-height: 1.6;
}
