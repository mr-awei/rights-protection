{
  "pages": [
    "pages/index/index",
    "pages/category/category",
    "pages/script-list/script-list",
    "pages/profile/profile"
  ],
  "subPackages": [
    {
      "root": "detail",
      "name": "detail",
      "pages": [
        "search/search",
        "search-result/search-result",
        "channel-detail/channel-detail",
        "script-detail/script-detail"
      ]
    },
    {
      "root": "subpages",
      "name": "sub",
      "pages": [
        "followup-schedule/followup-schedule",
        "hotline-change/hotline-change",
        "enterprise-query/enterprise-query",
        "general-template/general-template",
        "search-quality/search-quality",
        "favorites-history/favorites-history",
        "settings/settings",
        "about/about",
        "disclaimer/disclaimer",
        "origin/origin"
      ]
    }
  ],
  "preloadRule": {
    "pages/index/index": {
      "network": "all",
      "packages": ["detail"]
    },
    "pages/category/category": {
      "network": "all",
      "packages": ["detail"]
    },
    "pages/script-list/script-list": {
      "network": "all",
      "packages": ["detail"]
    },
    "pages/profile/profile": {
      "network": "all",
      "packages": ["detail", "sub"]
    }
  },
  "window": {
    "backgroundTextStyle": "light",
    "navigationBarBackgroundColor": "#4A90D9",
    "navigationBarTitleText": "消费维权信息助手",
    "navigationBarTextStyle": "white",
    "backgroundColor": "#F5F7FA"
  },
  "tabBar": {
    "color": "#86909C",
    "selectedColor": "#4A90D9",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "images/tab-home.png",
        "selectedIconPath": "images/tab-home-active.png"
      },
      {
        "pagePath": "pages/category/category",
        "text": "分类",
        "iconPath": "images/tab-category.png",
        "selectedIconPath": "images/tab-category-active.png"
      },
      {
        "pagePath": "pages/script-list/script-list",
        "text": "话术",
        "iconPath": "images/tab-script.png",
        "selectedIconPath": "images/tab-script-active.png"
      },
      {
        "pagePath": "pages/profile/profile",
        "text": "我的",
        "iconPath": "images/tab-profile.png",
        "selectedIconPath": "images/tab-profile-active.png"
      }
    ]
  },
  "style": "v2",
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents"
}
